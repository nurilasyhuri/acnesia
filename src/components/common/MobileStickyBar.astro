---
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const waUrl = generateGeneralInquiryUrl('mobile-dock');
const currentPath = Astro.url.pathname;
---

<nav
  aria-label="Navigasi Bawah Mobile"
  class="md:hidden fixed bottom-0 left-0 right-0 z-30 bg-white/95 backdrop-blur-md border-t border-slate-200/90 shadow-lg safe-area-pb"
>
  <div class="grid grid-cols-4 items-center h-14 max-w-md mx-auto">
    <!-- 1. Home / Produk -->
    <a
      href="/produk/"
      class:list={[
        "flex flex-col items-center justify-center h-full text-[10px] font-medium transition-colors select-none",
        currentPath.startsWith('/produk') ? "text-red-700 font-bold" : "text-slate-600 hover:text-slate-900"
      ]}
    >
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <rect x="2" y="7" width="20" height="14" rx="2" stroke-width="2"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>
      </svg>
      <span>Produk AC</span>
    </a>

    <!-- 2. Layanan -->
    <a
      href="/layanan/"
      class:list={[
        "flex flex-col items-center justify-center h-full text-[10px] font-medium transition-colors select-none",
        currentPath.startsWith('/layanan') ? "text-red-700 font-bold" : "text-slate-600 hover:text-slate-900"
      ]}
    >
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
        <circle cx="12" cy="12" r="3" stroke-width="2"/>
      </svg>
      <span>Layanan</span>
    </a>

    <!-- 3. Penawaran RFQ -->
    <a
      href="/kontak/#rfq"
      class:list={[
        "flex flex-col items-center justify-center h-full text-[10px] font-medium transition-colors select-none",
        currentPath.includes('/kontak') ? "text-red-700 font-bold" : "text-slate-600 hover:text-slate-900"
      ]}
    >
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      <span>Penawaran</span>
    </a>

    <!-- 4. WhatsApp Direct -->
    <a
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-col items-center justify-center h-full text-[10px] font-semibold text-emerald-600 hover:text-emerald-700 transition-colors select-none"
    >
      <svg class="w-5 h-5 mb-0.5 fill-current text-emerald-600" viewBox="0 0 24 24">
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
      </svg>
      <span>Chat WA</span>
    </a>
  </div>
</nav>
