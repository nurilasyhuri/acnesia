---
import { BUSINESS_INFO } from '../../data/businessInfo';
---

<footer class="bg-[#020617] text-slate-400 pt-16 pb-12 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pb-10 border-b border-white/10">
      <!-- Col 1-4: Brand & Mission -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="inline-flex items-center gap-3 select-none">
          <span class="w-9 h-9 rounded-full bg-white/10 border border-white/20 text-white font-bold text-xs flex items-center justify-center">
            SA
          </span>
          <div class="flex flex-col">
            <div class="flex items-center gap-1.5 text-base font-bold tracking-tight leading-none">
              <span class="text-white">SENTRA</span>
              <span class="text-[#fb923c]">AC</span>
            </div>
            <span class="text-[10px] text-slate-400 font-medium leading-none mt-1">
              Jual, Sewa, Service &amp; Pasang B2B
            </span>
          </div>
        </a>

        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          Solusi pendingin tata udara komersial untuk proyek dan kantor. Pengadaan AC baru &amp; rekondisi, sewa AC standing &amp; genset silent, serta instalasi pipa tembaga 0.8mm ASTM vakum digital di Malang Raya, Surabaya, dan Sidoarjo.
        </p>

        <!-- Plain Contact Text Rows (Honoring Owner WhatsApp Invariant) -->
        <div class="space-y-2 text-xs text-slate-300 pt-1">
          <div class="flex items-center gap-2.5">
            <svg aria-hidden="true" class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>Telepon / WA: <strong class="text-white font-semibold">0851-8300-2070</strong></span>
          </div>
          <div class="flex items-center gap-2.5">
            <svg aria-hidden="true" class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span>Email: <strong class="text-white font-semibold">{BUSINESS_INFO.email}</strong></span>
          </div>
          <div class="flex items-center gap-2.5 text-slate-400">
            <svg aria-hidden="true" class="w-4 h-4 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-width="2"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2"/>
            </svg>
            <span>{BUSINESS_INFO.hours.days} {BUSINESS_INFO.hours.time}</span>
          </div>
        </div>
      </div>

      <!-- Col 5-7: Layanan & Unit B2B -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-xs font-bold text-white">Layanan &amp; Unit B2B</h3>
        <ul class="space-y-2.5 text-xs text-slate-400">
          <li><a href="/pengadaan-ac/" class="hover:text-white transition-colors">Jual &amp; Pengadaan AC Baru / Bekas</a></li>
          <li><a href="/sewa-ac/" class="hover:text-white transition-colors">Sewa AC Standing &amp; Genset Silent</a></li>
          <li><a href="/produk/ac-split-wall-mounted/" class="hover:text-white transition-colors">Set AC Split Standard 0.5 – 2.5 PK</a></li>
          <li><a href="/produk/ac-split-inverter-hemat-listrik/" class="hover:text-white transition-colors">Set AC Split Inverter R32</a></li>
          <li><a href="/produk/ac-cassette-4-way/" class="hover:text-white transition-colors">AC Ceiling Cassette 4-Way (2 – 5 PK)</a></li>
          <li><a href="/produk/ac-floor-standing-commercial/" class="hover:text-white transition-colors">AC Floor Standing (3 – 5 PK)</a></li>
          <li><a href="/produk/paket-pasang-ac-pipa-vakum/" class="hover:text-white transition-colors">Instalasi Pipa 0.8mm ASTM + Vakum</a></li>
          <li><a href="/layanan/kontrak-maintenance-ac/" class="hover:text-white transition-colors">Kontrak Service &amp; Maintenance AMC</a></li>
        </ul>
      </div>

      <!-- Col 8-9: Area Layanan & SLA -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="text-xs font-bold text-white">Area Layanan</h3>
        <ul class="space-y-3 text-xs">
          <li>
            <div class="font-semibold text-white">Kota Malang</div>
            <div class="text-[11px] text-slate-400">2–4 Jam (Hub Kedungkandang)</div>
          </li>
          <li>
            <div class="font-semibold text-white">Batu &amp; Kab. Malang</div>
            <div class="text-[11px] text-slate-400">2–4 Jam (Tim Mobile)</div>
          </li>
          <li>
            <div class="font-semibold text-white">Surabaya &amp; Sidoarjo</div>
            <div class="text-[11px] text-slate-400">4–6 Jam (Rungkut &amp; Waru)</div>
          </li>
          <li>
            <div class="font-semibold text-white">Pasuruan</div>
            <div class="text-[11px] text-slate-400">4–6 Jam (PIER &amp; Pandaan)</div>
          </li>
          <li>
            <div class="font-semibold text-white">Gresik &amp; Mojokerto</div>
            <div class="text-[11px] text-slate-400">4–8 Jam (KIG &amp; Ngoro)</div>
          </li>
        </ul>
      </div>

      <!-- Col 10-12: Lokasi Gudang / Workshop Cards -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-xs font-bold text-white">Lokasi Workshop</h3>
        <div class="space-y-3">
          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4 space-y-1.5">
            <div class="flex items-center gap-1.5 text-xs font-bold text-white">
              <svg aria-hidden="true" class="w-3.5 h-3.5 text-[#fb923c] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Workshop Malang (Buring)</span>
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
              Jl. KH Malik Dalam, Kedungkandang, Kota Malang 65136
            </p>
          </div>

          <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4 space-y-1.5">
            <div class="flex items-center gap-1.5 text-xs font-bold text-white">
              <svg aria-hidden="true" class="w-3.5 h-3.5 text-[#fb923c] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Hub Proyek Surabaya &amp; Sidoarjo</span>
            </div>
            <p class="text-[11px] text-slate-400 leading-relaxed">
              Koridor Industri Rungkut – Waru, Sidoarjo &amp; Jawa Timur
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>&copy; {new Date().getFullYear()} Sentra AC. Hak Cipta Dilindungi.</p>
      <div class="flex flex-wrap items-center justify-center gap-5 text-xs text-slate-400">
        <a href="/tentang-kami/" class="hover:text-white transition-colors">Tentang Kami</a>
        <a href="/lokasi/" class="hover:text-white transition-colors">Area Layanan</a>
        <a href="/artikel/" class="hover:text-white transition-colors">Panduan B2B</a>
        <a href="/kontak/" class="hover:text-white transition-colors">Kontak</a>
      </div>
    </div>
  </div>
</footer>
