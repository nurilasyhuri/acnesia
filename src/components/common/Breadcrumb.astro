---
export interface BreadcrumbItem {
  label?: string;
  name?: string;
  href?: string;
  url?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const displayItems = items.filter((item) => {
  const text = (item.label || item.name || '').toLowerCase();
  const link = item.href || item.url || '';
  return text !== 'beranda' && text !== 'home' && link !== '/';
});
---

<nav aria-label="Breadcrumb" class="py-2 text-xs text-slate-500 font-sans">
  <ol class="flex flex-wrap items-center gap-1.5 sm:gap-2">
    <li>
      <a href="/" class="hover:text-[#c2410c] transition-colors flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
        <span class="sr-only">Beranda</span>
      </a>
    </li>

    {displayItems.map((item, index) => {
      const isLast = index === displayItems.length - 1;
      const label = item.label || item.name || '';
      const href = item.href || item.url;

      return (
        <li class="flex items-center gap-1.5 sm:gap-2">
          <svg class="w-3 h-3 text-slate-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          {isLast || !href ? (
            <span class="font-medium text-slate-900 truncate max-w-[200px] sm:max-w-xs" aria-current="page">
              {label}
            </span>
          ) : (
            <a href={href} class="hover:text-[#c2410c] transition-colors truncate max-w-[140px] sm:max-w-none">
              {label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
