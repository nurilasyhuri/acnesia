---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  keywords?: string | string[];
  author?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  image = '/images/og/default-og.jpg',
  type = 'website',
  keywords,
  author = 'ACNesia — Mitra Bisnis Indonesia',
  jsonLd,
  noindex = false,
} = Astro.props;

const siteName = 'ACNesia';
const domain = 'https://acnesia.com';

// Strictly strip any pipe symbols from title and description
const sanitizedRawTitle = title.replace(/\s*\|\s*/g, ' - ').trim();
const formattedTitle = sanitizedRawTitle.includes(siteName)
  ? sanitizedRawTitle
  : `${sanitizedRawTitle} - ${siteName}`;

const sanitizedDescription = description.replace(/\s*\|\s*/g, ', ').trim();

// Authoritative Absolute Image URL
const fullImageUrl = image.startsWith('http')
  ? image
  : `${domain}${image.startsWith('/') ? image : `/${image}`}`;

// Authoritative Canonical URL with guaranteed trailing slash alignment
const rawPath = canonical || Astro.url.pathname;
const cleanPathname = rawPath.startsWith('http')
  ? new URL(rawPath).pathname
  : (rawPath.startsWith('/') ? rawPath : `/${rawPath}`);
const normalizedPathname = cleanPathname.endsWith('/') || cleanPathname.includes('.')
  ? cleanPathname
  : `${cleanPathname}/`;
const canonicalUrl = `${domain}${normalizedPathname}`;

// Default B2B Keywords
const defaultKeywords = [
  'pengadaan ac kantor',
  'jual ac perusahaan',
  'kontrak maintenance ac',
  'preventive maintenance ac',
  'sewa ac standing',
  'instalasi ac gedung',
  'service ac malang',
  'acnesia mitra bisnis indonesia',
];
const keywordsString = Array.isArray(keywords)
  ? keywords.join(', ')
  : (keywords || defaultKeywords.join(', '));

// Format structured data JSON-LD into compliant schema @graph if multiple root entities
const formattedJsonLd = jsonLd
  ? (Array.isArray(jsonLd)
      ? {
          '@context': 'https://schema.org',
          '@graph': jsonLd.map((item) => {
            if (item && item['@context']) {
              const { '@context': _, ...rest } = item;
              return rest;
            }
            return item;
          }),
        }
      : jsonLd)
  : null;
---

<!-- Global Metadata & Mobile App Viewport -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
<meta name="format-detection" content="telephone=no" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0284c7" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="ACNesia" />
<meta name="application-name" content="ACNesia Mitra Bisnis Indonesia" />

<!-- Robots & Indexing Directives -->
<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<meta name="googlebot" content="index, follow" />

<!-- Canonical Tag (Always Strict Trailing Slash) -->
<link rel="canonical" href={canonicalUrl} />

<!-- Primary Search Meta -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={sanitizedDescription} />
<meta name="keywords" content={keywordsString} />
<meta name="author" content={author} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={sanitizedDescription} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="ACNesia" />
<meta property="og:locale" content="id_ID" />

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={sanitizedDescription} />
<meta name="twitter:image" content={fullImageUrl} />

<!-- Structured Data JSON-LD (@graph format) -->
{formattedJsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(formattedJsonLd)} />
)}
