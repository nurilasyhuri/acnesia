---
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const currentPath = Astro.url.pathname;
const waUrl = generateGeneralInquiryUrl(currentPath === '/' ? 'homepage' : currentPath);
---

<div class="fixed bottom-20 md:bottom-6 right-4 md:right-6 z-40">
  <a
    href={waUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Konsultasi WhatsApp ACNesia"
    class="group flex items-center gap-2.5 bg-emerald-600 hover:bg-emerald-700 text-white p-3 md:px-4 md:py-3 rounded-full shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-300 select-none border border-emerald-500/50"
  >
    <!-- Live Online Pulse Dot -->
    <span class="relative flex h-3 w-3">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
    </span>

    <!-- WhatsApp Official Icon -->
    <svg class="w-5 h-5 fill-current text-white shrink-0" viewBox="0 0 24 24">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zM17.46 16.48c-.23.64-1.33 1.24-1.84 1.32-.47.07-1.07.1-1.74-.11-.41-.13-.94-.31-1.63-.61-2.89-1.25-4.78-4.16-4.93-4.35-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.01-2.41.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.09.19-.14.31-.29.47-.14.17-.31.37-.44.5-.14.14-.29.3-.12.59.17.29.74 1.22 1.6 1.98 1.1 0.98 2.03 1.29 2.32 1.43.29.14.46.12.63-.07.17-.19.74-.86.94-1.15.19-.29.39-.24.66-.14.27.1 1.73.82 2.03.97.29.14.49.22.56.34.07.12.07.7-.16 1.34z"/>
    </svg>

    <div class="hidden md:flex flex-col text-left">
      <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-100 leading-tight">CS Online</span>
      <span class="text-xs font-semibold text-white leading-tight">Chat ACNesia</span>
    </div>
  </a>
</div>
