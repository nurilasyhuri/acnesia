---
import { BUSINESS_INFO } from '../../data/businessInfo';
import { getCollection } from 'astro:content';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

export interface Props {
  isHomePage?: boolean;
}

const currentPath = Astro.url.pathname;
const { isHomePage = currentPath === '/' || currentPath === '' } = Astro.props;
const waHeaderUrl = generateGeneralInquiryUrl('header');

const [products, solutions, articles] = await Promise.all([
  getCollection('produk'),
  getCollection('solusi'),
  getCollection('artikel'),
]);

const megaMenuServices = [
  {
    badge: 'BARU & SECOND',
    title: 'Jual AC Baru dan Bekas',
    subtitle: 'Unit Baru & Rekondisi',
    href: '/layanan/jual-pengadaan-ac/',
    image: '/images/services/pengadaan-ac-kantor.webp',
  },
  {
    badge: 'HARIAN & BULANAN',
    title: 'Sewa AC',
    subtitle: 'Standing & Split Event',
    href: '/layanan/sewa-ac/',
    image: '/images/services/sewa-ac-standing.webp',
  },
  {
    badge: 'CEPAT TANGGAP',
    title: 'Jasa Service AC',
    subtitle: 'Perbaikan & Cek Freon',
    href: '/layanan/service-ac/',
    image: '/images/services/service-ac-kantor.webp',
  },
  {
    badge: 'STANDAR VAKUM',
    title: 'Jasa Pasang AC',
    subtitle: 'Instalasi & Relokasi',
    href: '/layanan/instalasi-ac/',
    image: '/images/services/instalasi-ac-profesional.webp',
  },
  {
    badge: 'DEEP CLEANING',
    title: 'Jasa Cuci AC',
    subtitle: 'Cuci Steam & Overhaul',
    href: '/layanan/preventive-maintenance/',
    image: '/images/services/preventive-maintenance-ac.webp',
  },
];

const featuredHighlights = [
  {
    eyebrow: '0.5 PK – 2.5 PK Baru & Bekas',
    title: 'AC Split Wall Kantor',
    price: 'Rp 2.850.000',
    oldPrice: 'Rp 3.400.000',
    href: '/produk/ac-split-wall-mounted/',
    image: '/images/products/ac-split-wall-mounted.webp',
  },
  {
    eyebrow: '2 PK – 5 PK Plafon 4-Way',
    title: 'AC Cassette Komersial',
    price: 'Rp 11.500.000',
    oldPrice: 'Rp 13.200.000',
    href: '/produk/ac-cassette-4-way/',
    image: '/images/products/ac-cassette-4-way.webp',
  },
  {
    eyebrow: '3 PK – 5 PK Portable Event',
    title: 'Paket Sewa AC Standing',
    price: 'Rp 650.000',
    oldPrice: 'Rp 850.000',
    href: '/layanan/sewa-ac/',
    image: '/images/products/ac-floor-standing.webp',
  },
  {
    eyebrow: 'Cuci Steam + Cek Tekanan',
    title: 'Paket Cuci & Service AC',
    price: 'Rp 85.000',
    oldPrice: 'Rp 120.000',
    href: '/layanan/preventive-maintenance/',
    image: '/images/services/preventive-maintenance-ac.webp',
  },
];

const searchItems = [
  ...megaMenuServices.map((s) => ({
    title: s.title,
    desc: s.subtitle,
    url: s.href,
    category: 'Layanan',
    badge: s.badge,
  })),
  ...products.map((p) => ({
    title: p.data.title,
    desc: p.data.description,
    url: `/produk/${p.slug}/`,
    category: 'Produk AC',
    badge: p.data.capacity || 'AC Unit',
  })),
  ...solutions.map((sol) => ({
    title: sol.data.title,
    desc: sol.data.description,
    url: `/solusi/${sol.slug}/`,
    category: 'Solusi Bisnis',
    badge: sol.data.target,
  })),
  ...articles.map((a) => ({
    title: a.data.title,
    desc: a.data.description,
    url: `/artikel/${a.slug}/`,
    category: 'Panduan',
    badge: a.data.category,
  })),
];
---

<!-- Translucent Light Header (Numa-style 3-column layout with full-width Mega Menu) -->
<header
  id="main-header"
  data-is-home={isHomePage ? 'true' : 'false'}
  class="sticky top-0 z-40 font-sans"
>
  <!-- Separate glass background layer so child Mega Menu blur is never clipped -->
  <div class="absolute inset-0 bg-white/65 backdrop-blur-xl border-b border-white/60 shadow-[0_2px_20px_-8px_rgba(15,23,42,0.06)] pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-12 items-center h-[76px]">
      
      <!-- Left: Desktop Navigation (Beranda, Layanan, Tentang, Kontak) -->
      <nav class="hidden lg:flex lg:col-span-5 items-center gap-1.5 h-full text-[12px] font-medium tracking-[0.14em] uppercase text-slate-800">
        <a
          href="/"
          class:list={[
            "px-3.5 py-2 rounded-md hover:bg-slate-900/6 transition-colors",
            currentPath === '/' ? "font-bold text-slate-950" : "text-slate-800"
          ]}
        >
          Beranda
        </a>

        <!-- Mega Menu Trigger: LAYANAN (Full height wrapper so hover never drops between trigger and panel) -->
        <div id="layanan-nav-group" class="group static h-full flex items-center">
          <a
            href="/layanan/"
            id="layanan-nav-trigger"
            class:list={[
              "inline-flex items-center gap-2 px-4 py-2 rounded-md transition-colors group-hover:bg-slate-900/8",
              currentPath.startsWith('/layanan') || currentPath.startsWith('/sewa-ac')
                ? "bg-slate-900/8 font-bold text-slate-950"
                : "text-slate-800"
            ]}
          >
            <span>Layanan</span>
            <svg class="w-3.5 h-3.5 text-sky-700 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>

          <!-- Full-Width Mega Menu Panel (Zero hover gap from header bottom) -->
          <div
            id="layanan-mega-menu"
            class="absolute left-0 right-0 top-full pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200 z-50"
          >
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
              <div class="bg-white/98 backdrop-blur-2xl rounded-xl shadow-[0_24px_60px_-12px_rgba(15,23,42,0.16)] border border-slate-200/90 p-6 lg:p-7 space-y-6 normal-case tracking-normal">
                
                <!-- 1. Top Row: 5 Core Services Visual Cards -->
                <div class="space-y-3.5">
                  <div class="flex items-center justify-between text-[11px] font-mono">
                    <div class="flex items-center gap-2 font-bold tracking-[0.16em] uppercase text-slate-800">
                      <span class="w-2 h-2 rounded-full bg-teal-600"></span>
                      <span>KATEGORI LAYANAN UTAMA</span>
                    </div>
                    <span class="text-slate-500">5 Layanan Tata Udara Terpadu</span>
                  </div>

                  <div class="grid grid-cols-5 gap-3.5">
                    {megaMenuServices.map((item) => (
                      <a
                        href={item.href}
                        class="group/card relative block h-[156px] rounded-lg overflow-hidden bg-slate-200 border border-slate-200/80 shadow-2xs"
                      >
                        <img
                          src={item.image}
                          alt={item.title}
                          width="320"
                          height="200"
                          class="w-full h-full object-cover group-hover/card:scale-105 transition-transform duration-500 ease-out"
                          loading="lazy"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-900/40 to-slate-900/10"></div>

                        <!-- Top-left White Pill Badge -->
                        <div class="absolute top-3 left-3">
                          <span class="inline-block px-2.5 py-1 rounded-xs bg-white text-slate-900 font-mono text-[9px] font-bold tracking-[0.12em] uppercase shadow-2xs">
                            {item.badge}
                          </span>
                        </div>

                        <!-- Bottom Title, Subtitle & Arrow Box -->
                        <div class="absolute inset-x-3 bottom-3 flex items-end justify-between gap-2">
                          <div class="space-y-0.5 min-w-0">
                            <h3 class="font-bold text-[13px] text-white leading-tight">
                              {item.title}
                            </h3>
                            <p class="text-[11px] text-slate-200/95 font-normal leading-tight">
                              {item.subtitle}
                            </p>
                          </div>
                          <span class="w-6 h-6 rounded bg-white/20 group-hover/card:bg-white/35 backdrop-blur-xs text-white flex items-center justify-center shrink-0 transition-colors">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                            </svg>
                          </span>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>

                <!-- 2. Middle Row: Featured Units & Packages Strip -->
                <div class="pt-4 border-t border-slate-200/70 space-y-3.5">
                  <div class="flex items-center justify-between text-[11px] font-mono">
                    <div class="flex items-center gap-2 font-bold tracking-[0.16em] uppercase text-slate-800">
                      <span class="w-2 h-2 rounded-full bg-teal-600"></span>
                      <span>UNIT & PAKET PILIHAN TERBARU</span>
                    </div>
                    <a href="/produk/" class="text-slate-500 hover:text-slate-900 transition-colors">
                      Formula & Katalog Terkini
                    </a>
                  </div>

                  <div class="grid grid-cols-4 gap-3.5">
                    {featuredHighlights.map((prod) => (
                      <a
                        href={prod.href}
                        class="group/item flex items-center justify-between gap-3 p-3 rounded-lg border border-slate-200/90 hover:border-slate-300 bg-white hover:bg-slate-50/70 transition-all"
                      >
                        <div class="flex items-center gap-3 min-w-0">
                          <img
                            src={prod.image}
                            alt={prod.title}
                            width="56"
                            height="56"
                            class="w-12 h-12 rounded-md object-cover bg-slate-100 border border-slate-200/60 shrink-0"
                            loading="lazy"
                          />
                          <div class="min-w-0 space-y-0.5">
                            <span class="block text-[10px] font-mono text-teal-700 truncate">
                              {prod.eyebrow}
                            </span>
                            <h4 class="text-xs font-bold text-slate-900 truncate group-hover/item:text-teal-800 transition-colors">
                              {prod.title}
                            </h4>
                            <div class="flex items-baseline gap-1.5 font-mono">
                              <span class="text-xs font-bold text-slate-900">{prod.price}</span>
                              <span class="text-[10px] text-slate-400 line-through">{prod.oldPrice}</span>
                            </div>
                          </div>
                        </div>
                        <svg class="w-3.5 h-3.5 text-slate-400 group-hover/item:text-slate-800 group-hover/item:translate-x-0.5 transition-all shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                        </svg>
                      </a>
                    ))}
                  </div>
                </div>

                <!-- 3. Bottom Trust Footer Strip -->
                <div class="pt-3.5 border-t border-slate-200/70 flex items-center justify-between text-xs text-slate-600">
                  <div class="flex items-center gap-3">
                    <span class="inline-flex items-center gap-2 font-bold text-slate-900">
                      <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                      100% Bergaransi Resmi
                    </span>
                    <span class="text-slate-300">•</span>
                    <span>Teknisi Tersertifikasi Standar Vakum</span>
                    <span class="text-slate-300">•</span>
                    <span>Faktur Pajak & BAP Lengkap</span>
                  </div>
                  <span class="font-medium text-slate-600">
                    Gratis Survey Lokasi Malang Raya
                  </span>
                </div>

              </div>
            </div>
          </div>
        </div>

        <a
          href="/tentang-kami/"
          class:list={[
            "px-3.5 py-2 rounded-md hover:bg-slate-900/6 transition-colors",
            currentPath.startsWith('/tentang-kami') ? "font-bold text-slate-950" : "text-slate-800"
          ]}
        >
          Tentang
        </a>

        <a
          href="/kontak/"
          class:list={[
            "px-3.5 py-2 rounded-md hover:bg-slate-900/6 transition-colors",
            currentPath.startsWith('/kontak') ? "font-bold text-slate-950" : "text-slate-800"
          ]}
        >
          Kontak
        </a>
      </nav>

      <!-- Center: Minimalist Centered Brand Logo -->
      <div class="lg:col-span-2 flex lg:justify-center">
        <a href="/" class="inline-flex flex-col items-start lg:items-center group select-none">
          <span class="text-xl sm:text-[22px] font-normal tracking-[0.26em] text-slate-950 uppercase leading-none">
            AC<span class="text-slate-400 mx-0.5">·</span>NESIA
          </span>
          <span class="text-[9px] text-slate-500 font-medium tracking-[0.24em] uppercase mt-1.5">
            Mitra Bisnis Indonesia
          </span>
        </a>
      </div>

      <!-- Right: Minimalist Icon Actions (Search, WhatsApp CTA, RFQ Bag) -->
      <div class="lg:col-span-5 flex items-center justify-end gap-2 sm:gap-2.5">
        <!-- Search Icon Button -->
        <button
          id="search-btn"
          type="button"
          aria-label="Cari layanan dan produk AC"
          class="p-2 rounded-full text-slate-800 hover:bg-slate-900/6 transition-colors cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M21 21l-5.2-5.2m1.7-4.3a6 6 0 11-12 0 6 6 0 0112 0z"/>
          </svg>
        </button>

        <!-- RFQ Bag Trigger with Counter Badge -->
        <button
          type="button"
          data-open-rfq
          aria-label="Buka Keranjang Penawaran RFQ"
          class="relative p-2 rounded-full text-slate-800 hover:bg-slate-900/6 transition-colors cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="rfq-badge-counter absolute -top-0.5 -right-0.5 px-1.5 py-0.5 rounded-full bg-slate-900 text-white font-bold text-[10px] leading-none min-w-[18px] text-center shadow-2xs">
            0
          </span>
        </button>

        <!-- Direct WhatsApp Button -->
        <a
          href={waHeaderUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Chat WhatsApp ACNesia"
          class="inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-2 rounded-full bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-[11px] sm:text-xs tracking-normal shadow-xs transition-all select-none"
        >
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.625.846 5.059 2.284 7.033l-1.494 4.462 4.611-1.466c1.911 1.24 4.179 1.971 6.599 1.971 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
          </svg>
          <span>Chat WA</span>
        </a>

        <!-- Mobile Hamburger Toggle -->
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Buka navigasi mobile"
          class="lg:hidden p-2 rounded-lg border border-slate-200/80 text-slate-800 hover:bg-slate-100 transition-colors cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Slide-over Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden fixed inset-0 z-50 bg-slate-900/30 backdrop-blur-xs transition-opacity">
    <div class="fixed inset-y-0 right-0 w-full max-w-xs bg-white shadow-2xl p-6 flex flex-col justify-between overflow-y-auto font-sans">
      <div class="space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-200">
          <span class="text-base font-bold tracking-[0.22em] text-slate-900 uppercase">
            AC·NESIA
          </span>
          <button id="mobile-menu-close" type="button" aria-label="Tutup menu" class="p-1 text-slate-400 hover:text-slate-700 cursor-pointer">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <nav class="space-y-3 text-sm font-semibold text-slate-800">
          <a href="/" class="block py-2 border-b border-slate-100 hover:text-teal-700">Beranda</a>
          
          <div class="py-2 border-b border-slate-100 space-y-2">
            <a href="/layanan/" class="block font-bold text-slate-900 hover:text-teal-700">Layanan</a>
            <div class="pl-3 space-y-2 border-l-2 border-slate-100 text-xs font-medium text-slate-600">
              {megaMenuServices.map((s) => (
                <a href={s.href} class="block py-1 hover:text-teal-700">{s.title}</a>
              ))}
            </div>
          </div>

          <a href="/tentang-kami/" class="block py-2 border-b border-slate-100 hover:text-teal-700">Tentang</a>
          <a href="/kontak/" class="block py-2 border-b border-slate-100 hover:text-teal-700">Kontak</a>
        </nav>
      </div>

      <div class="pt-6 border-t border-slate-200 space-y-2.5">
        <a
          href={waHeaderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-xs tracking-normal shadow-xs select-none"
        >
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.625.846 5.059 2.284 7.033l-1.494 4.462 4.611-1.466c1.911 1.24 4.179 1.971 6.599 1.971 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
          </svg>
          <span>Chat WhatsApp Teknisi</span>
        </a>
        <button
          type="button"
          data-open-rfq
          onclick="document.getElementById('mobile-menu')?.classList.add('hidden')"
          class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-slate-900 text-white font-semibold text-xs tracking-normal shadow-xs select-none cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span>Keranjang Penawaran (RFQ)</span>
        </button>
        <div class="text-[11px] text-slate-400 text-center">
          {BUSINESS_INFO.hours.days}: {BUSINESS_INFO.hours.time}
        </div>
      </div>
    </div>
  </div>

  <!-- Instant Search Modal (Cmd+K / Ctrl+K) -->
  <div id="search-modal" class="hidden fixed inset-0 z-50 bg-slate-900/30 backdrop-blur-xs p-4 sm:p-6 md:p-20 overflow-y-auto">
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden font-sans">
      <div class="relative border-b border-slate-200 flex items-center px-4 py-3">
        <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Cari Jual AC Baru/Bekas, Sewa AC, Service, Pasang, Cuci AC..."
          class="w-full px-3 py-2 text-base sm:text-sm text-slate-900 focus:outline-none placeholder-slate-400 bg-transparent"
        />
        <button id="search-close" type="button" aria-label="Tutup pencarian" class="p-1 text-slate-400 hover:text-slate-700 text-xs font-semibold cursor-pointer">
          ESC
        </button>
      </div>

      <div id="search-results" class="max-h-96 overflow-y-auto p-2 space-y-1"></div>

      <div id="search-empty" class="hidden p-8 text-center space-y-2">
        <p class="text-sm font-semibold text-slate-700">Tidak menemukan yang Anda butuhkan?</p>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          Tim engineering ACNesia siap membantu konsultasi kapasitas atau pengadaan custom.
        </p>
        <div class="pt-2">
          <a href="/kontak/" class="inline-flex items-center gap-1.5 py-1.5 px-3.5 rounded-lg bg-slate-100 text-slate-800 hover:bg-slate-200 text-xs font-semibold transition-colors">
            <span>Tanya ACNesia</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script define:vars={{ searchItems }}>
  const searchBtn = document.getElementById('search-btn');
  const searchModal = document.getElementById('search-modal');
  const searchClose = document.getElementById('search-close');
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  const searchEmpty = document.getElementById('search-empty');

  function openSearch() {
    searchModal?.classList.remove('hidden');
    searchInput?.focus();
    renderResults(searchItems.slice(0, 6));
  }

  function closeSearch() {
    searchModal?.classList.add('hidden');
    if (searchInput) searchInput.value = '';
  }

  searchBtn?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);

  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) closeSearch();
  });

  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (searchModal?.classList.contains('hidden')) {
        openSearch();
      } else {
        closeSearch();
      }
    }
    if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
      closeSearch();
    }
  });

  function renderResults(items) {
    if (!searchResults) return;
    if (items.length === 0) {
      searchResults.innerHTML = '';
      searchEmpty?.classList.remove('hidden');
      return;
    }
    searchEmpty?.classList.add('hidden');
    searchResults.innerHTML = items
      .map(
        (item) => `
      <a href="${item.url}" class="flex items-start justify-between gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors border border-transparent hover:border-slate-200">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-bold uppercase tracking-wider text-teal-800 bg-teal-50 px-2 py-0.5 rounded">${item.category}</span>
            <span class="font-bold text-xs sm:text-sm text-slate-900">${item.title}</span>
          </div>
          <p class="text-xs text-slate-500 line-clamp-1">${item.desc}</p>
        </div>
        <span class="text-[10px] text-slate-400 font-medium shrink-0 mt-1">${item.badge || ''}</span>
      </a>
    `
      )
      .join('');
  }

  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    if (!query) {
      renderResults(searchItems.slice(0, 6));
      return;
    }
    const filtered = searchItems.filter(
      (item) =>
        item.title.toLowerCase().includes(query) ||
        item.desc.toLowerCase().includes(query) ||
        item.category.toLowerCase().includes(query) ||
        (item.badge && item.badge.toLowerCase().includes(query))
    );
    renderResults(filtered);
  });

  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuClose = document.getElementById('mobile-menu-close');

  mobileMenuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.remove('hidden');
  });

  mobileMenuClose?.addEventListener('click', () => {
    mobileMenu?.classList.add('hidden');
  });

  mobileMenu?.addEventListener('click', (e) => {
    if (e.target === mobileMenu) {
      mobileMenu.classList.add('hidden');
    }
  });
</script>
