---
import { BUSINESS_INFO } from '../../data/businessInfo';
import { getCollection } from 'astro:content';

export interface Props {
  isHomePage?: boolean;
}

const currentPath = Astro.url.pathname;
const { isHomePage = currentPath === '/' || currentPath === '' } = Astro.props;

// Fetch content collections for Instant Search Modal (Cmd+K / Ctrl+K)
const [products, services, solutions, articles] = await Promise.all([
  getCollection('produk'),
  getCollection('layanan'),
  getCollection('solusi'),
  getCollection('artikel'),
]);

const searchItems = [
  // Products
  ...products.map((p) => ({
    title: p.data.title,
    desc: p.data.description,
    url: `/produk/${p.slug}/`,
    category: 'Produk AC',
    badge: p.data.capacity || 'AC Unit',
  })),
  // Services
  ...services.map((s) => ({
    title: s.data.title,
    desc: s.data.description,
    url: `/layanan/${s.slug}/`,
    category: 'Layanan',
    badge: 'Service HVAC',
  })),
  // Solutions
  ...solutions.map((sol) => ({
    title: sol.data.title,
    desc: sol.data.description,
    url: `/solusi/${sol.slug}/`,
    category: 'Solusi Bisnis',
    badge: sol.data.target,
  })),
  // Articles
  ...articles.map((a) => ({
    title: a.data.title,
    desc: a.data.description,
    url: `/artikel/${a.slug}/`,
    category: 'Panduan',
    badge: a.data.category,
  })),
  // Static Core Routes
  {
    title: 'Sewa AC Standing & Komersial',
    desc: 'Layanan sewa pendingin ruangan harian, mingguan, dan bulanan untuk kantor dan event.',
    url: '/sewa-ac/',
    category: 'Layanan',
    badge: 'Rental AC',
  },
  {
    title: 'Pengadaan AC Kantor & Perusahaan Multi-Unit',
    desc: 'Pengadaan unit AC baru skala satuan hingga ratusan unit dengan penawaran B2B resmi.',
    url: '/pengadaan-ac/',
    category: 'Pengadaan',
    badge: 'B2B Procurement',
  },
  {
    title: 'Workshop & Lokasi ACNesia Malang',
    desc: 'Alamat workshop dan fasilitas teknisi di Jl. KH Malik Dalam, Kedungkandang, Kota Malang.',
    url: '/lokasi/',
    category: 'Perusahaan',
    badge: 'Lokasi',
  },
  {
    title: 'Kontak Tim Sales & Engineering',
    desc: 'Konsultasi teknis, permintaan survey lokasi, dan form RFQ penawaran harga resmi.',
    url: '/kontak/',
    category: 'Perusahaan',
    badge: 'Kontak',
  },
];
---

<!-- 1. Top Announcement Strip (Sleek Dark Navy, No Raw Phone Number) -->
<div class="bg-slate-950 text-slate-300 text-[11px] font-medium border-b border-slate-800/80 tracking-normal select-none relative z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex items-center justify-between gap-4">
    <!-- Left: Value Strip -->
    <div class="flex items-center gap-2 truncate">
      <span class="inline-flex items-center gap-1 text-red-400 font-semibold">
        <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-pulse"></span>
        ACNesia
      </span>
      <span class="hidden sm:inline text-slate-600">|</span>
      <span class="truncate text-slate-400 font-normal">
        Melayani Kebutuhan AC Bisnis • Pengadaan • Instalasi • Service • Maintenance • Sewa
      </span>
    </div>

    <!-- Right: Operational Hours & Location Link -->
    <div class="flex items-center gap-3 shrink-0 text-slate-400">
      <span class="hidden md:inline-flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="2"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2"/>
        </svg>
        <span>{BUSINESS_INFO.hours.days}: {BUSINESS_INFO.hours.time}</span>
      </span>
      <span class="hidden md:inline text-slate-700">•</span>
      <a href="/lokasi/" class="hover:text-white transition-colors flex items-center gap-1">
        <span>Workshop Malang</span>
        <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<!-- 2. Main Sticky Header (Transparent on Homepage Hero, Glass on Scroll & Inner Pages) -->
<header
  id="main-header"
  data-is-home={isHomePage ? 'true' : 'false'}
  class:list={[
    "sticky top-0 z-40 transition-all duration-300 font-sans",
    isHomePage
      ? "bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-2xs"
      : "bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-2xs"
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[68px]">
      <!-- Left: Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <span class="w-8 h-8 rounded-lg bg-red-700 group-hover:bg-red-800 transition-colors flex items-center justify-center text-white font-black text-base shadow-2xs">
          AC
        </span>
        <div class="flex flex-col">
          <span class="text-xl font-black tracking-tight text-slate-950 uppercase leading-none group-hover:text-red-800 transition-colors">
            ACNesia
          </span>
          <span class="text-[10px] text-red-800 font-semibold tracking-wider uppercase mt-1">
            Mitra Bisnis Indonesia
          </span>
        </div>
      </a>

      <!-- Center: Desktop Navigation Bar -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-xs font-semibold text-slate-700">
        <a
          href="/"
          class:list={[
            "hover:text-red-700 transition-colors py-2",
            currentPath === '/' ? "text-red-800 font-bold" : ""
          ]}
        >
          Beranda
        </a>

        <!-- Dropdown: Produk AC -->
        <div class="relative group py-2">
          <a
            href="/produk/"
            class:list={[
              "flex items-center gap-1 hover:text-red-700 transition-colors",
              currentPath.startsWith('/produk') ? "text-red-800 font-bold" : ""
            ]}
          >
            <span>Produk AC</span>
            <svg class="w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
          <div class="absolute left-0 top-full pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="p-3 bg-white rounded-xl shadow-xl border border-slate-200/80 space-y-1">
              <a href="/produk/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">Semua Produk AC</span>
                <span class="text-[11px] text-slate-500 block">Katalog lengkap unit pendingin</span>
              </a>
              <a href="/produk/ac-split/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">AC Split Wall Mounted</span>
                <span class="text-[11px] text-slate-500 block">0.5 - 2.5 PK ruang kerja & privat</span>
              </a>
              <a href="/produk/ac-cassette/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">AC Cassette 4-Way</span>
                <span class="text-[11px] text-slate-500 block">2 - 5 PK open office & meeting</span>
              </a>
              <a href="/produk/ac-floor-standing/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">AC Floor Standing</span>
                <span class="text-[11px] text-slate-500 block">3 - 5 PK heavy duty aula & lobi</span>
              </a>
              <a href="/produk/ac-commercial/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">AC Ducted & Central</span>
                <span class="text-[11px] text-slate-500 block">Sistem ducting tersembunyi komersial</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Dropdown: Layanan -->
        <div class="relative group py-2">
          <a
            href="/layanan/"
            class:list={[
              "flex items-center gap-1 hover:text-red-700 transition-colors",
              currentPath.startsWith('/layanan') ? "text-red-800 font-bold" : ""
            ]}
          >
            <span>Layanan</span>
            <svg class="w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
          <div class="absolute left-0 top-full pt-2 w-72 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="p-3 bg-white rounded-xl shadow-xl border border-slate-200/80 space-y-1">
              <a href="/layanan/jual-pengadaan-ac/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">Pengadaan AC Baru</span>
                <span class="text-[11px] text-slate-500 block">Pengadaan B2B multi-unit bergaransi</span>
              </a>
              <a href="/layanan/instalasi-ac/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">Instalasi AC Profesional</span>
                <span class="text-[11px] text-slate-500 block">Standar vakum pipa & perapian jalur</span>
              </a>
              <a href="/layanan/service-ac/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">Service & Perbaikan AC</span>
                <span class="text-[11px] text-slate-500 block">Troubleshooting akurat & cuci steam</span>
              </a>
              <a href="/layanan/preventive-maintenance/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">Preventive Maintenance</span>
                <span class="text-[11px] text-slate-500 block">Servis berkala jaga efisiensi listrik</span>
              </a>
              <a href="/layanan/kontrak-maintenance-ac/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">Kontrak Maintenance Perusahaan</span>
                <span class="text-[11px] text-slate-500 block">SLA darurat & faktur pajak lengkap</span>
              </a>
              <a href="/sewa-ac/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">Sewa AC Proyek & Event</span>
                <span class="text-[11px] text-slate-500 block">Sewa standing & split harian/bulanan</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Dropdown: Solusi Bisnis -->
        <div class="relative group py-2">
          <a
            href="/solusi/"
            class:list={[
              "flex items-center gap-1 hover:text-red-700 transition-colors",
              currentPath.startsWith('/solusi') ? "text-red-800 font-bold" : ""
            ]}
          >
            <span>Solusi Sektor</span>
            <svg class="w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
          <div class="absolute left-0 top-full pt-2 w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="p-3 bg-white rounded-xl shadow-xl border border-slate-200/80 space-y-1">
              <a href="/solusi/ac-kantor/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">AC untuk Kantor & Coworking</span>
                <span class="text-[11px] text-slate-500 block">Kenyamanan kerja tim tanpa berisik</span>
              </a>
              <a href="/solusi/ac-perusahaan/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">AC Perusahaan Multi-Cabang</span>
                <span class="text-[11px] text-slate-500 block">Satu pintu kontrak & standardisasi mutu</span>
              </a>
              <a href="/solusi/ac-instansi/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">AC Instansi & Lembaga Publik</span>
                <span class="text-[11px] text-slate-500 block">Kepatuhan SPK, BAP, & transparansi</span>
              </a>
              <a href="/solusi/ac-gedung/" class="block px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors">
                <span class="font-bold text-slate-900 block text-xs">AC Gedung Komersial & Ruko</span>
                <span class="text-[11px] text-slate-500 block">Sistem pendinginan multi-lantai</span>
              </a>
            </div>
          </div>
        </div>

        <a
          href="/sewa-ac/"
          class:list={[
            "hover:text-red-700 transition-colors py-2",
            currentPath.startsWith('/sewa-ac') ? "text-red-800 font-bold" : ""
          ]}
        >
          Sewa AC
        </a>

        <a
          href="/artikel/"
          class:list={[
            "hover:text-red-700 transition-colors py-2",
            currentPath.startsWith('/artikel') ? "text-red-800 font-bold" : ""
          ]}
        >
          Panduan
        </a>

        <a
          href="/tentang-kami/"
          class:list={[
            "hover:text-red-700 transition-colors py-2",
            currentPath.startsWith('/tentang-kami') ? "text-red-800 font-bold" : ""
          ]}
        >
          Tentang
        </a>

        <a
          href="/kontak/"
          class:list={[
            "hover:text-red-700 transition-colors py-2",
            currentPath.startsWith('/kontak') ? "text-red-800 font-bold" : ""
          ]}
        >
          Kontak
        </a>
      </nav>

      <!-- Right: Action Buttons & Instant Search -->
      <div class="flex items-center gap-2.5">
        <!-- Instant Search Button (Cmd+K / Ctrl+K) -->
        <button
          id="search-btn"
          type="button"
          aria-label="Cari produk dan layanan"
          class="flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-200 hover:border-slate-300 bg-slate-50 hover:bg-slate-100 text-slate-500 hover:text-slate-800 text-xs font-medium transition-all duration-200 cursor-pointer"
        >
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <span class="hidden sm:inline">Cari...</span>
          <kbd class="hidden md:inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded bg-white border border-slate-200 text-[10px] text-slate-400 font-mono shadow-2xs">
            <span class="text-xs">⌘</span>K
          </kbd>
        </button>

        <!-- Shopify B2B Cart / RFQ Drawer Trigger Button -->
        <button
          type="button"
          data-open-rfq
          aria-label="Buka Keranjang Penawaran RFQ"
          class="relative inline-flex items-center gap-2 py-2 px-3.5 rounded-lg bg-red-700 hover:bg-red-800 active:bg-red-900 text-white font-semibold text-xs tracking-normal shadow-xs hover:shadow transition-all duration-200 select-none cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="hidden sm:inline">Penawaran (RFQ)</span>
          <span class="rfq-badge-counter hidden px-1.5 py-0.5 rounded-full bg-white text-red-700 font-black text-[10px] leading-none shadow-2xs min-w-[18px] text-center">0</span>
        </button>

        <!-- Mobile Hamburger Toggle -->
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Buka navigasi mobile"
          class="lg:hidden p-2 rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Slide-over Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs transition-opacity">
    <div class="fixed inset-y-0 right-0 w-full max-w-xs bg-white shadow-2xl p-6 flex flex-col justify-between overflow-y-auto font-sans">
      <div class="space-y-6">
        <!-- Top Drawer Header -->
        <div class="flex items-center justify-between pb-4 border-b border-slate-200">
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-red-700 flex items-center justify-center text-white font-black text-sm">
              AC
            </span>
            <span class="text-lg font-black tracking-tight text-slate-900 uppercase">
              ACNesia
            </span>
          </div>
          <button id="mobile-menu-close" type="button" aria-label="Tutup menu" class="p-1 text-slate-400 hover:text-slate-700 cursor-pointer">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Nav Links in Mobile -->
        <nav class="space-y-3 text-sm font-semibold text-slate-800">
          <a href="/" class="block py-2 border-b border-slate-100 hover:text-red-700">Beranda</a>
          <a href="/produk/" class="block py-2 border-b border-slate-100 hover:text-red-700">Katalog Produk AC</a>
          <a href="/layanan/" class="block py-2 border-b border-slate-100 hover:text-red-700">Layanan Teknik AC</a>
          <a href="/solusi/" class="block py-2 border-b border-slate-100 hover:text-red-700">Solusi Sektor Bisnis</a>
          <a href="/sewa-ac/" class="block py-2 border-b border-slate-100 hover:text-red-700">Sewa AC Proyek</a>
          <a href="/pengadaan-ac/" class="block py-2 border-b border-slate-100 hover:text-red-700">Pengadaan B2B</a>
          <a href="/artikel/" class="block py-2 border-b border-slate-100 hover:text-red-700">Artikel & Panduan</a>
          <a href="/tentang-kami/" class="block py-2 border-b border-slate-100 hover:text-red-700">Tentang ACNesia</a>
          <a href="/kontak/" class="block py-2 border-b border-slate-100 hover:text-red-700">Kontak & Lokasi</a>
        </nav>
      </div>

      <div class="pt-6 border-t border-slate-200 space-y-3">
        <button
          type="button"
          data-open-rfq
          onclick="document.getElementById('mobile-menu')?.classList.add('hidden')"
          class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-red-700 text-white font-semibold text-xs tracking-normal shadow-xs select-none cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span>Keranjang Penawaran (RFQ)</span>
          <span class="rfq-badge-counter hidden px-1.5 py-0.5 rounded-full bg-white text-red-700 font-black text-[10px] leading-none">0</span>
        </button>
        <div class="text-[11px] text-slate-400 text-center">
          {BUSINESS_INFO.hours.days}: {BUSINESS_INFO.hours.time}
        </div>
      </div>
    </div>
  </div>

  <!-- Instant Search Modal (Cmd+K / Ctrl+K) -->
  <div id="search-modal" class="hidden fixed inset-0 z-50 bg-slate-950/60 backdrop-blur-xs p-4 sm:p-6 md:p-20 overflow-y-auto">
    <div class="max-w-2xl mx-auto bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden font-sans">
      <!-- Search Input Bar -->
      <div class="relative border-b border-slate-200 flex items-center px-4 py-3">
        <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Cari AC Split, Cassette, Service, Maintenance, Sewa..."
          class="w-full px-3 py-2 text-base sm:text-sm text-slate-900 focus:outline-none placeholder-slate-400 bg-transparent"
        />
        <button id="search-close" type="button" aria-label="Tutup pencarian" class="p-1 text-slate-400 hover:text-slate-700 text-xs font-semibold cursor-pointer">
          ESC
        </button>
      </div>

      <!-- Live Search Results List -->
      <div id="search-results" class="max-h-96 overflow-y-auto p-2 space-y-1">
        <!-- Results will be dynamically populated by JS -->
      </div>

      <!-- Zero / Empty State Template -->
      <div id="search-empty" class="hidden p-8 text-center space-y-2">
        <p class="text-sm font-semibold text-slate-700">Tidak menemukan yang Anda butuhkan?</p>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          Tim engineering ACNesia siap membantu konsultasi kapasitas atau pengadaan custom.
        </p>
        <div class="pt-2">
          <a href="/kontak/" class="inline-flex items-center gap-1.5 py-1.5 px-3.5 rounded-lg bg-red-50 text-red-800 hover:bg-red-100 text-xs font-semibold transition-colors">
            <span>Tanya ACNesia</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script define:vars={{ searchItems }}>
  // Initialize Instant Search Data & Logic
  const searchBtn = document.getElementById('search-btn');
  const searchModal = document.getElementById('search-modal');
  const searchClose = document.getElementById('search-close');
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  const searchEmpty = document.getElementById('search-empty');

  function openSearch() {
    searchModal?.classList.remove('hidden');
    searchInput?.focus();
    renderResults(searchItems.slice(0, 6));
  }

  function closeSearch() {
    searchModal?.classList.add('hidden');
    if (searchInput) searchInput.value = '';
  }

  searchBtn?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);

  searchModal?.addEventListener('click', (e) => {
    if (e.target === searchModal) closeSearch();
  });

  // Global Keyboard Shortcuts (Cmd+K, Ctrl+K, Escape)
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (searchModal?.classList.contains('hidden')) {
        openSearch();
      } else {
        closeSearch();
      }
    }
    if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
      closeSearch();
    }
  });

  function renderResults(items) {
    if (!searchResults) return;
    if (items.length === 0) {
      searchResults.innerHTML = '';
      searchEmpty?.classList.remove('hidden');
      return;
    }
    searchEmpty?.classList.add('hidden');
    searchResults.innerHTML = items
      .map(
        (item) => `
      <a href="${item.url}" class="flex items-start justify-between gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors border border-transparent hover:border-slate-200">
        <div class="space-y-0.5">
          <div class="flex items-center gap-2">
            <span class="text-[10px] font-bold uppercase tracking-wider text-red-800 bg-red-50 px-2 py-0.5 rounded">${item.category}</span>
            <span class="font-bold text-xs sm:text-sm text-slate-900">${item.title}</span>
          </div>
          <p class="text-xs text-slate-500 line-clamp-1">${item.desc}</p>
        </div>
        <span class="text-[10px] text-slate-400 font-medium shrink-0 mt-1">${item.badge || ''}</span>
      </a>
    `
      )
      .join('');
  }

  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    if (!query) {
      renderResults(searchItems.slice(0, 6));
      return;
    }
    const filtered = searchItems.filter(
      (item) =>
        item.title.toLowerCase().includes(query) ||
        item.desc.toLowerCase().includes(query) ||
        item.category.toLowerCase().includes(query) ||
        (item.badge && item.badge.toLowerCase().includes(query))
    );
    renderResults(filtered);
  });

  // Mobile Menu Drawer Logic
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuClose = document.getElementById('mobile-menu-close');

  mobileMenuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.remove('hidden');
  });

  mobileMenuClose?.addEventListener('click', () => {
    mobileMenu?.classList.add('hidden');
  });

  mobileMenu?.addEventListener('click', (e) => {
    if (e.target === mobileMenu) {
      mobileMenu.classList.add('hidden');
    }
  });
</script>
