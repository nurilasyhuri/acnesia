---
export interface Props {
  isHomePage?: boolean;
}

const currentPath = Astro.url.pathname;
const { isHomePage = currentPath === '/' || currentPath === '' } = Astro.props;

const layananSeoItems = [
  {
    title: 'Jual & Pengadaan AC Baru dan Bekas B2B',
    desc: 'Supplier pengadaan AC baru bergaransi resmi, unit second rekondisi QC, & borongan lelang AC bekas kantor/gedung.',
    href: '/pengadaan-ac/',
  },
  {
    title: 'Sewa AC Standing & Paket Genset Silent',
    desc: 'Rental AC Floor Standing 3 PK – 10 PK & paket daya Genset Silent harian, mingguan, atau bulanan untuk event & proyek.',
    href: '/sewa-ac/',
  },
  {
    title: 'Instalasi Pipa Vakum & Kontrak Service AMC',
    desc: 'Jasa pasang pipa tembaga ASTM vakum 500 micron, cuci steam terjadwal, & kontrak maintenance tahunan gedung.',
    href: '/layanan/',
  },
];

const navLinks = [
  { label: 'Katalog', href: '/produk/' },
  { label: 'Panduan', href: '/artikel/' },
  { label: 'Tentang', href: '/tentang-kami/' },
  { label: 'Kontak', href: '/kontak/' },
];

const isLayananActive =
  currentPath.startsWith('/layanan') ||
  currentPath.startsWith('/sewa-ac') ||
  currentPath.startsWith('/pengadaan-ac');
---

<header
  id="main-header"
  data-is-home={isHomePage ? 'true' : 'false'}
  class="sticky top-0 z-40 h-[72px] md:h-20 bg-[#020617]/95 backdrop-blur-md border-b border-white/10 font-sans"
>
  <div class="w-full h-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-3">
    <!-- Left: Brand Identity -->
    <a href="/" class="inline-flex items-center gap-2.5 shrink-0 select-none min-w-0">
      <span class="w-9 h-9 rounded-full bg-white/10 border border-white/20 text-white font-bold text-xs flex items-center justify-center tracking-tight shrink-0">
        SA
      </span>
      <div class="flex flex-col min-w-0">
        <div class="flex items-center gap-1.5 text-sm sm:text-base font-bold tracking-tight leading-none">
          <span class="text-white">SENTRA</span>
          <span class="text-[#fb923c]">AC</span>
        </div>
        <span class="text-[10px] text-slate-400 font-medium leading-none mt-1 truncate">
          Jual, Sewa, Service &amp; Pasang B2B
        </span>
      </div>
    </a>

    <!-- Center: Desktop Navigation -->
    <nav aria-label="Navigasi Utama" class="hidden lg:flex items-center gap-7 text-xs font-medium text-slate-300">
      <a
        href="/"
        class:list={[
          'transition-colors py-1',
          isHomePage ? 'text-[#fb923c] font-semibold' : 'hover:text-white text-slate-300',
        ]}
      >
        Beranda
      </a>

      <div class="relative group" id="desktop-layanan-dropdown">
        <button
          type="button"
          id="desktop-layanan-btn"
          aria-expanded="false"
          aria-haspopup="true"
          class:list={[
            'inline-flex items-center gap-1.5 py-2 transition-colors cursor-pointer',
            isLayananActive ? 'text-[#fb923c] font-semibold' : 'text-slate-300 hover:text-white',
          ]}
        >
          <span>Layanan</span>
          <svg
            aria-hidden="true"
            class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div
          id="desktop-layanan-menu"
          class="hidden group-hover:block group-focus-within:block absolute left-0 top-full pt-2 w-[380px] z-50"
        >
          <div class="rounded-2xl bg-[#020617] border border-white/15 shadow-2xl p-3 space-y-1">
            {layananSeoItems.map((item) => (
              <a
                href={item.href}
                class="block rounded-xl p-3 hover:bg-white/5 transition-colors group/item"
              >
                <span class="block text-xs font-bold text-white group-hover/item:text-[#fb923c] transition-colors mb-1">
                  {item.title}
                </span>
                <p class="text-[11px] leading-relaxed text-slate-400">
                  {item.desc}
                </p>
              </a>
            ))}
          </div>
        </div>
      </div>

      {navLinks.map((link) => {
        const isActive =
          currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class:list={[
              'transition-colors py-1',
              isActive ? 'text-[#fb923c] font-semibold' : 'hover:text-white text-slate-300',
            ]}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right: Single Primary Action & Mobile Menu Toggle -->
    <div class="flex items-center gap-2.5 shrink-0">
      <button
        type="button"
        data-open-rfq
        aria-label="Minta Surat Penawaran Harga (SPH)"
        class="hidden md:inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-[#c2410c] hover:bg-[#ea580c] text-white text-xs font-semibold transition-colors cursor-pointer select-none"
      >
        <span>Minta SPH</span>
        <span id="rfq-header-subtotal" class="sr-only">0 Item</span>
        <span class="rfq-badge-counter hidden px-1.5 py-0.5 rounded-full bg-white text-slate-950 font-bold text-[10px] leading-none min-w-[18px] text-center">
          0
        </span>
      </button>

      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Buka menu navigasi"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg border border-white/15 bg-white/5 text-slate-200 hover:bg-white/10 transition-colors cursor-pointer"
      >
        <svg id="icon-menu-open" aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-menu-close" aria-hidden="true" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="mobile-drawer" class="fixed inset-0 z-50 lg:hidden hidden font-sans">
  <div id="mobile-drawer-backdrop" class="fixed inset-0 bg-slate-950/70 backdrop-blur-xs"></div>

  <div class="fixed inset-y-0 right-0 w-full max-w-sm bg-[#020617] text-white shadow-2xl border-l border-white/10 flex flex-col justify-between overflow-y-auto">
    <div class="p-4 border-b border-white/10 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-full bg-white/10 border border-white/20 text-white font-bold text-xs flex items-center justify-center">
          SA
        </span>
        <div>
          <span class="font-bold text-sm text-white tracking-tight">SENTRA </span>
          <span class="font-bold text-sm text-[#fb923c] tracking-tight">AC</span>
        </div>
      </div>
      <button
        id="mobile-drawer-close"
        type="button"
        aria-label="Tutup menu"
        class="inline-flex items-center justify-center w-10 h-10 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 cursor-pointer"
      >
        <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="p-5 flex-1 overflow-y-auto">
      <nav aria-label="Menu Mobile" class="space-y-4 text-sm font-medium text-slate-200">
        <div class="space-y-1">
          <a href="/" class="block px-3 py-2 rounded-lg hover:bg-white/5">Beranda</a>
          <a href="/produk/" class="block px-3 py-2 rounded-lg hover:bg-white/5">Katalog Unit &amp; Paket</a>
          <a href="/pengadaan-ac/" class="block px-3 py-2 rounded-lg hover:bg-white/5">Jual &amp; Pengadaan AC B2B</a>
          <a href="/sewa-ac/" class="block px-3 py-2 rounded-lg hover:bg-white/5">Sewa AC Standing &amp; Genset</a>
          <a href="/layanan/" class="block px-3 py-2 rounded-lg hover:bg-white/5">Instalasi &amp; Kontrak Service</a>
          <a href="/artikel/" class="block px-3 py-2 rounded-lg hover:bg-white/5">Panduan Teknis</a>
          <a href="/tentang-kami/" class="block px-3 py-2 rounded-lg hover:bg-white/5">Tentang Kami</a>
          <a href="/kontak/" class="block px-3 py-2 rounded-lg hover:bg-white/5">Kontak</a>
        </div>
      </nav>
    </div>

    <div class="p-4 border-t border-white/10">
      <button
        type="button"
        data-open-rfq
        class="w-full py-3 px-5 rounded-full bg-[#c2410c] hover:bg-[#ea580c] text-white font-semibold text-xs flex items-center justify-center gap-2 cursor-pointer"
      >
        <span>Minta SPH</span>
      </button>
    </div>
  </div>
</div>

<script>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const mobileClose = document.getElementById('mobile-drawer-close');
  const mobileBackdrop = document.getElementById('mobile-drawer-backdrop');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');

  function toggleMobileDrawer(open: boolean) {
    if (!mobileDrawer || !mobileBtn) return;
    mobileDrawer.classList.toggle('hidden', !open);
    mobileBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  }

  mobileBtn?.addEventListener('click', () => {
    const isHidden = mobileDrawer?.classList.contains('hidden');
    toggleMobileDrawer(Boolean(isHidden));
  });
  mobileClose?.addEventListener('click', () => toggleMobileDrawer(false));
  mobileBackdrop?.addEventListener('click', () => toggleMobileDrawer(false));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      toggleMobileDrawer(false);
    }
  });
</script>
