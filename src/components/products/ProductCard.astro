---
export interface Props {
  product: {
    title: string;
    description: string;
    category: string;
    condition?: string;
    capacity?: string;
    price?: number;
    priceDisplay?: string;
    compareAtPriceDisplay?: string;
    stockStatus: string;
    thumbnail: string;
    slug: string;
    brand?: string;
  };
}

const { product } = Astro.props;

const categoryLabels: Record<string, string> = {
  'ac-split': 'AC Split Wall',
  'ac-cassette': 'AC Cassette 4-Way',
  'ac-floor-standing': 'AC Floor Standing',
  'ac-commercial': 'AC Ceiling & Duct',
  'paket-jasa': 'Paket Jasa & Sewa',
};

const displayCategory = categoryLabels[product.category] || product.category;
---

<a
  href={`/produk/${product.slug}/`}
  class="group h-full flex flex-col justify-between rounded-xl bg-white border border-slate-200 hover:border-slate-300 overflow-hidden transition-colors font-sans"
>
  <div>
    <div class="aspect-4/3 bg-slate-100 overflow-hidden">
      <img
        src={product.thumbnail}
        alt={`Unit ${product.title} - Sentra AC`}
        width="600"
        height="450"
        class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300 ease-out"
        decoding="async"
      />
    </div>

    <div class="p-4 space-y-1.5">
      <div class="flex items-center justify-between gap-2 text-xs text-slate-500">
        <span class="font-semibold text-[#c2410c]">
          {displayCategory}
        </span>
        {product.capacity && <span>{product.capacity}</span>}
      </div>

      <h3 class="font-bold text-slate-900 text-sm leading-snug line-clamp-2 group-hover:text-[#c2410c] transition-colors">
        {product.title}
      </h3>

      <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
        {product.description}
      </p>
    </div>
  </div>

  <div class="px-4 pb-4 pt-2 flex items-baseline justify-between gap-2">
    <span class="font-bold text-slate-900 text-sm">
      {product.priceDisplay || 'Sesuai Penawaran SPH'}
    </span>
    {product.compareAtPriceDisplay && (
      <span class="text-[11px] text-slate-400 line-through">
        {product.compareAtPriceDisplay}
      </span>
    )}
  </div>
</a>
