---
import { BUSINESS_INFO } from '../../data/businessInfo';
---

<div id="rfq-drawer-backdrop" class="fixed inset-0 z-50 bg-slate-950/50 backdrop-blur-xs transition-opacity duration-200 opacity-0 pointer-events-none font-sans">
  <div
    id="rfq-drawer-panel"
    class="fixed inset-y-0 right-0 w-full max-w-md bg-white shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-200 ease-out border-l border-slate-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="rfq-drawer-title"
  >
    <!-- Drawer Header -->
    <div class="p-4 sm:p-5 border-b border-slate-200 flex items-center justify-between bg-[#020617] text-white">
      <div>
        <h2 id="rfq-drawer-title" class="font-bold text-sm sm:text-base text-white leading-tight">
          Permintaan SPH &amp; Estimasi
        </h2>
        <p class="text-[11px] text-slate-400">
          <span id="rfq-items-count-text">0 item</span> dalam daftar permintaan SPH
        </p>
      </div>

      <button
        id="rfq-drawer-close"
        type="button"
        aria-label="Tutup panel SPH"
        class="inline-flex items-center justify-center w-10 h-10 rounded-full text-slate-400 hover:text-white hover:bg-white/10 transition-colors cursor-pointer"
      >
        <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Drawer Body -->
    <div class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-5">
      <!-- Empty State -->
      <div id="rfq-empty-state" class="rounded-xl bg-slate-50 border border-slate-200 p-4 text-xs text-slate-600 leading-relaxed">
        Belum ada unit dipilih dari katalog. Anda dapat langsung mengisi rincian kebutuhan proyek di bawah ini untuk meminta Surat Penawaran Harga (SPH) resmi.
      </div>

      <!-- Items List -->
      <div id="rfq-items-container" class="space-y-2.5 hidden" aria-live="polite"></div>

      <!-- Checkout & B2B Form Fields -->
      <div id="rfq-form-section" class="space-y-3">
        <span class="text-xs font-bold text-slate-900 block">
          Detail Pemohon &amp; Lokasi Proyek
        </span>

        <p id="rfq-error-msg" role="alert" class="hidden text-xs font-semibold text-[#c2410c] bg-orange-50 border border-orange-200 rounded-lg px-3 py-2"></p>

        <div class="space-y-2.5 text-xs">
          <div>
            <label for="rfq-input-name" class="block font-semibold text-slate-700 mb-1">
              Nama Penerima / PIC <span class="text-[#c2410c]">*</span>
            </label>
            <input
              id="rfq-input-name"
              type="text"
              placeholder="Contoh: Bpk. Hendra"
              class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white text-base sm:text-xs text-slate-900 focus:border-[#c2410c] transition-colors"
            />
          </div>

          <div>
            <label for="rfq-input-company" class="block font-semibold text-slate-700 mb-1">
              Perusahaan / Instansi <span class="text-slate-400 font-normal">(e-Faktur PPN)</span>
            </label>
            <input
              id="rfq-input-company"
              type="text"
              placeholder="Contoh: PT Sumber Makmur"
              class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white text-base sm:text-xs text-slate-900 focus:border-[#c2410c] transition-colors"
            />
          </div>

          <div>
            <label for="rfq-input-location" class="block font-semibold text-slate-700 mb-1">
              Alamat / Lokasi Proyek <span class="text-[#c2410c]">*</span>
            </label>
            <input
              id="rfq-input-location"
              type="text"
              placeholder="Contoh: Lowokwaru, Kota Malang / Rungkut, Surabaya"
              class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white text-base sm:text-xs text-slate-900 focus:border-[#c2410c] transition-colors"
            />
          </div>

          <div>
            <label for="rfq-input-notes" class="block font-semibold text-slate-700 mb-1">
              Rincian Kebutuhan Unit / Sewa / Instalasi
            </label>
            <textarea
              id="rfq-input-notes"
              rows="3"
              placeholder="Contoh: Sewa 4 unit AC Standing 5 PK + Genset 40 kVA / Pengadaan 10 unit AC Split 1.5 PK"
              class="w-full px-3 py-2 rounded-lg border border-slate-300 bg-white text-base sm:text-xs text-slate-900 focus:border-[#c2410c] transition-colors resize-none"
            ></textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Drawer Footer: Subtotal & Checkout -->
    <div class="p-4 sm:p-5 border-t border-slate-200 bg-slate-50 space-y-3">
      <div class="flex items-baseline justify-between">
        <span class="text-xs font-semibold text-slate-600">Estimasi Subtotal:</span>
        <span id="rfq-subtotal-display" class="text-base sm:text-lg font-extrabold text-slate-900">
          Sesuai Penawaran
        </span>
      </div>

      <button
        id="rfq-submit-wa"
        type="button"
        class="w-full inline-flex items-center justify-center py-3.5 px-5 rounded-full bg-[#c2410c] hover:bg-[#ea580c] text-white font-bold text-xs sm:text-sm transition-colors select-none cursor-pointer"
      >
        Kirim Permintaan SPH
      </button>

      <div class="flex items-center justify-between text-[11px] text-slate-500">
        <button
          id="rfq-clear-btn"
          type="button"
          class="hidden text-slate-500 hover:text-[#c2410c] transition-colors cursor-pointer"
        >
          Kosongkan Daftar
        </button>
        <span>SPK, BOQ &amp; e-Faktur PPN</span>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ whatsappNumber: BUSINESS_INFO.whatsappNumber }}>
  const STORAGE_KEY = 'sentraac_rfq_items';

  function formatRupiah(amount) {
    if (!amount || amount <= 0) return 'Rp 0';
    return 'Rp ' + Number(amount).toLocaleString('id-ID');
  }

  function getItems() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    } catch {
      return [];
    }
  }

  function saveItems(items) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
    updateBadges(items);
    renderDrawerItems(items);
  }

  function calculateSubtotal(items) {
    return items.reduce((acc, item) => {
      const unitPrice = Number(item.price || 0);
      const qty = Number(item.quantity || 1);
      return acc + unitPrice * qty;
    }, 0);
  }

  function updateBadges(items) {
    const totalCount = items.reduce((acc, item) => acc + (item.quantity || 1), 0);
    const totalRp = calculateSubtotal(items);

    const badges = document.querySelectorAll('.rfq-badge-counter');
    badges.forEach((el) => {
      el.textContent = totalCount.toString();
      if (totalCount > 0) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    const headerSubtotal = document.getElementById('rfq-header-subtotal');
    if (headerSubtotal) {
      if (totalCount === 0) {
        headerSubtotal.textContent = '0 Item';
      } else if (totalRp > 0) {
        headerSubtotal.textContent = formatRupiah(totalRp);
      } else {
        headerSubtotal.textContent = `${totalCount} Item`;
      }
    }

    const subtotalEl = document.getElementById('rfq-subtotal-display');
    if (subtotalEl) {
      subtotalEl.textContent = totalRp > 0 ? formatRupiah(totalRp) : 'Sesuai Penawaran';
    }

    const countText = document.getElementById('rfq-items-count-text');
    if (countText) {
      countText.textContent = `${items.length} produk (${totalCount} unit)`;
    }

    const emptyState = document.getElementById('rfq-empty-state');
    const itemsContainer = document.getElementById('rfq-items-container');
    const clearBtn = document.getElementById('rfq-clear-btn');

    if (items.length === 0) {
      emptyState?.classList.remove('hidden');
      itemsContainer?.classList.add('hidden');
      clearBtn?.classList.add('hidden');
    } else {
      emptyState?.classList.add('hidden');
      itemsContainer?.classList.remove('hidden');
      clearBtn?.classList.remove('hidden');
    }
  }

  function renderDrawerItems(items) {
    const container = document.getElementById('rfq-items-container');
    if (!container) return;

    if (items.length === 0) {
      container.innerHTML = '';
      return;
    }

    container.innerHTML = items
      .map((item, idx) => {
        const qty = Number(item.quantity || 1);
        const unitPrice = Number(item.price || 0);
        const lineTotal = unitPrice * qty;
        const priceLabel =
          lineTotal > 0
            ? formatRupiah(lineTotal)
            : item.priceDisplay || 'Sesuai Spesifikasi';

        return `
      <div class="p-3 rounded-lg border border-slate-200 bg-white flex items-start justify-between gap-3">
        <div class="space-y-1 min-w-0 flex-1">
          <div class="flex items-center gap-1.5 text-[11px] text-[#c2410c] font-semibold">
            <span>${item.category || 'Unit AC'}</span>
            ${item.capacity ? `<span class="text-slate-300">·</span><span class="text-slate-600">${item.capacity}</span>` : ''}
          </div>
          <h4 class="font-bold text-xs text-slate-900 leading-snug line-clamp-2">
            ${item.title}
          </h4>
          <div class="pt-1.5 flex items-center justify-between gap-2">
            <div class="inline-flex items-center border border-slate-200 rounded-md bg-slate-50">
              <button
                type="button"
                data-change-qty="${idx}"
                data-delta="-1"
                aria-label="Kurangi jumlah ${item.title}"
                class="w-7 h-7 flex items-center justify-center text-xs font-bold text-slate-700 hover:bg-slate-200 rounded-l-md cursor-pointer"
              >
                &minus;
              </button>
              <span class="w-8 text-center text-xs font-bold text-slate-900">${qty}</span>
              <button
                type="button"
                data-change-qty="${idx}"
                data-delta="1"
                aria-label="Tambah jumlah ${item.title}"
                class="w-7 h-7 flex items-center justify-center text-xs font-bold text-slate-700 hover:bg-slate-200 rounded-r-md cursor-pointer"
              >
                &#43;
              </button>
            </div>
            <span class="text-xs font-extrabold text-slate-900">${priceLabel}</span>
          </div>
        </div>

        <button
          type="button"
          data-remove-idx="${idx}"
          aria-label="Hapus ${item.title}"
          class="p-1.5 text-slate-400 hover:text-[#c2410c] transition-colors rounded-md hover:bg-orange-50 cursor-pointer"
        >
          <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
      </div>
    `;
      })
      .join('');

    container.querySelectorAll('[data-change-qty]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const idx = parseInt(target.getAttribute('data-change-qty'), 10);
        const delta = parseInt(target.getAttribute('data-delta'), 10);
        const current = getItems();
        if (current[idx]) {
          current[idx].quantity = Math.max(1, (current[idx].quantity || 1) + delta);
          saveItems(current);
        }
      });
    });

    container.querySelectorAll('[data-remove-idx]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const idx = parseInt(target.getAttribute('data-remove-idx'), 10);
        const current = getItems();
        current.splice(idx, 1);
        saveItems(current);
      });
    });
  }

  const backdrop = document.getElementById('rfq-drawer-backdrop');
  const panel = document.getElementById('rfq-drawer-panel');
  const closeBtn = document.getElementById('rfq-drawer-close');
  const clearBtn = document.getElementById('rfq-clear-btn');
  const submitWaBtn = document.getElementById('rfq-submit-wa');
  const errorMsg = document.getElementById('rfq-error-msg');

  function showError(msg) {
    if (!errorMsg) return;
    errorMsg.textContent = msg;
    errorMsg.classList.remove('hidden');
  }

  function clearError() {
    if (!errorMsg) return;
    errorMsg.textContent = '';
    errorMsg.classList.add('hidden');
  }

  function openDrawer() {
    clearError();
    backdrop?.classList.remove('opacity-0', 'pointer-events-none');
    backdrop?.classList.add('opacity-100');
    panel?.classList.remove('translate-x-full');
    panel?.classList.add('translate-x-0');
    document.body.classList.add('overflow-hidden');
  }

  function closeDrawer() {
    backdrop?.classList.add('opacity-0', 'pointer-events-none');
    backdrop?.classList.remove('opacity-100');
    panel?.classList.add('translate-x-full');
    panel?.classList.remove('translate-x-0');
    document.body.classList.remove('overflow-hidden');
  }

  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) closeDrawer();
  });

  clearBtn?.addEventListener('click', () => {
    saveItems([]);
    clearError();
  });

  window.addEventListener('sentraac:open-rfq', openDrawer);

  window.addEventListener('sentraac:add-rfq', (e) => {
    const detail = e.detail;
    if (!detail || !detail.title) return;
    const current = getItems();
    const existingIdx = current.findIndex(
      (item) => item.title === detail.title && item.capacity === detail.capacity
    );
    if (existingIdx >= 0) {
      current[existingIdx].quantity = (current[existingIdx].quantity || 1) + (detail.quantity || 1);
      if (detail.price) current[existingIdx].price = Number(detail.price);
      if (detail.priceDisplay) current[existingIdx].priceDisplay = detail.priceDisplay;
    } else {
      current.push({
        title: detail.title,
        category: detail.category || 'Unit AC',
        capacity: detail.capacity || '',
        price: Number(detail.price || 0),
        priceDisplay: detail.priceDisplay || '',
        quantity: detail.quantity || 1,
        notes: detail.notes || '',
      });
    }
    saveItems(current);
    openDrawer();
  });

  document.querySelectorAll('[data-open-rfq]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openDrawer();
    });
  });

  submitWaBtn?.addEventListener('click', () => {
    const items = getItems();

    const nameInput = document.getElementById('rfq-input-name');
    const companyInput = document.getElementById('rfq-input-company');
    const locationInput = document.getElementById('rfq-input-location');
    const notesInput = document.getElementById('rfq-input-notes');

    const name = nameInput?.value.trim();
    const company = companyInput?.value.trim();
    const location = locationInput?.value.trim();
    const notes = notesInput?.value.trim();

    if (!name) {
      showError('Mohon isi Nama Penerima / PIC terlebih dahulu.');
      nameInput?.focus();
      return;
    }
    if (!location) {
      showError('Mohon isi Alamat / Lokasi Proyek terlebih dahulu.');
      locationInput?.focus();
      return;
    }

    clearError();

    const totalRp = calculateSubtotal(items);
    let text = `Halo Tim B2B Sentra AC, saya ingin mengajukan Surat Penawaran Harga (SPH):\n\n`;
    text += `Data Pemohon:\n`;
    text += `- Nama PIC: ${name}\n`;
    if (company) text += `- Perusahaan / Instansi: ${company}\n`;
    text += `- Lokasi Proyek: ${location}\n`;

    if (items.length > 0) {
      text += `\nDaftar Unit (${items.length} Item):\n`;
      items.forEach((item, i) => {
        const qty = Number(item.quantity || 1);
        const lineRp = Number(item.price || 0) * qty;
        const priceStr = lineRp > 0 ? ` — ${formatRupiah(lineRp)}` : '';
        text += `${i + 1}. ${item.title} (x${qty})${priceStr}\n`;
      });
      if (totalRp > 0) {
        text += `\nEstimasi Subtotal: ${formatRupiah(totalRp)}\n`;
      }
    }

    if (notes) {
      text += `\nRincian Kebutuhan: ${notes}\n`;
    }

    text += `\nMohon konfirmasi penawaran SPH dan jadwal pengiriman/pemasangan. Terima kasih.`;

    const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
    window.open(url, '_blank');
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDrawer();
    }
  });

  const initialItems = getItems();
  updateBadges(initialItems);
  renderDrawerItems(initialItems);
</script>
