---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateRentalInquiryUrl } from '../../utils/whatsapp';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Sewa AC Standing & Genset B2B', url: '/sewa-ac/' },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);

const rentalPackages = [
  {
    name: 'Sewa Harian (Event Korporat & Exhibition)',
    badge: 'Event & Konvensi',
    duration: '1 s/d 3 Hari',
    description: 'Solusi pendingin dan daya cadangan instan untuk acara korporat, RUPS, seminar, wisuda, pameran, atau peresmian pabrik.',
    features: [
      'Unit AC Floor Standing 5 PK & 10 PK + opsi paket Genset Silent',
      'Termasuk jasa antar, instalasi pipa/kabel & bongkar di lokasi',
      'Termasuk kabel power 3 Phase ekstra tebal & panel distribusi MCB',
      'Opsi pendampingan teknisi & operator genset standby selama acara',
    ],
  },
  {
    name: 'Sewa Mingguan (Proyek & Posko Lapangan)',
    badge: 'Proyek & Pameran',
    duration: '1 s/d 4 Minggu',
    description: 'Pilihan ekonomis untuk site office proyek konstruksi, tenda roder pameran, ruang server sementara, atau masa renovasi gedung.',
    features: [
      'Tarif sewa mingguan khusus B2B lebih hemat dibanding tarif harian',
      'Pemeriksaan fungsi AC & suplai daya genset berkala oleh teknisi',
      'Jaminan penggantian unit cadangan cepat jika terjadi kendala teknis',
      'Dukungan dokumen SPK, BAST & e-Faktur Pajak PPN resmi',
    ],
  },
  {
    name: 'Sewa Bulanan & Tahunan (Kontrak Korporat)',
    badge: 'Kontrak OpEx B2B',
    duration: '1 Bulan s/d 1 Tahun',
    description: 'Sewa jangka panjang untuk kantor cabang transisi, direksi keet konstruksi, pabrik, atau fasilitas operasional tanpa beban CapEx.',
    features: [
      'Tanpa biaya belanja modal (CapEx) pembelian unit AC & genset baru',
      'Bebas biaya maintenance & cuci steam berkala selama masa kontrak',
      'Perbaikan suku cadang, freon & servis rutin 100% ditanggung Sentra AC',
      'Skema pembayaran invoice bulanan transparan (OpEx perusahaan)',
    ],
  },
];

const rentalUnits = [
  {
    name: 'AC Floor Standing 5 PK & 10 PK',
    category: 'Pendingin Heavy Duty Event & Gedung',
    coverage: 'Luas area 40 – 150 m² / unit',
    specs: 'Daya 3.800 – 9.500 W (1 Phase / 3 Phase 380V), High Static Dual Blower',
    idealFor: 'Tenda Roder, hall konvensi, ruang rapat direksi, ruang server darurat.',
  },
  {
    name: 'Paket Genset Silent 20 kVA – 100 kVA',
    category: 'Suplai Daya AC & Backup Proyek B2B',
    coverage: 'Mampu menyuplai 3 – 15 unit AC Standing 5 PK',
    specs: 'Tipe Silent Box kedap suara, output stabil 3 Phase 380V, termasuk kabel & panel',
    idealFor: 'Lokasi event outdoor, proyek konstruksi belum masuk PLN, backup daya gedung.',
  },
  {
    name: 'Misty Fan / Cooling Fan Industrial',
    category: 'Pendingin Pendukung Semi-Outdoor',
    coverage: 'Luas area 25 – 40 m² / unit',
    specs: 'Tangki air 60 Liter, hembusan kabut mikro bertekanan untuk area semi-terbuka',
    idealFor: 'Area registrasi tamu VIP, selasar gudang, tenda semi-outdoor korporat.',
  },
];

const defaultRentalWaUrl = generateRentalInquiryUrl('AC Standing & Genset Silent', 'Harian / Bulanan B2B', 'sewa-ac-page');
---

<BaseLayout
  title="Sewa AC Standing & Genset Silent B2B Malang Surabaya - Sentra AC"
  description="Jasa sewa AC Floor Standing 5 PK, 10 PK dan paket Genset Silent harian, mingguan, serta bulanan untuk event korporat & proyek di Jawa Timur."
  canonical={ensureAbsoluteUrl('/sewa-ac/')}
  jsonLd={breadcrumbSchema}
  keywords={[
    'sewa ac dan genset',
    'sewa ac standing malang surabaya',
    'rental ac standing 5 pk 10 pk',
    'sewa genset silent event proyek',
    'sewa ac bulanan kantor b2b',
    'rental ac dan genset jawa timur',
    'sentra ac sewa ac genset',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-3.5">
        <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-bold text-slate-950 tracking-tight leading-tight">
          Sewa AC Standing 5 PK – 10 PK &amp; Genset Silent untuk Proyek, Event &amp; Gedung
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Solusi satu pintu penyewaan AC Floor Standing kapasitas besar sekaligus suplai daya Genset Silent untuk acara korporat, pameran, proyek konstruksi, dan kantor sementara di Malang Raya, Surabaya, serta Sidoarjo lengkap dengan dukungan e-Faktur Pajak PPN.
        </p>
      </div>
    </div>
  </section>

  <!-- Duration Packages -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-2xl space-y-1.5">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-950 tracking-tight">
          Pilihan Paket Durasi Sewa AC &amp; Genset
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Sesuaikan skema penyewaan dengan agenda acara maupun operasional fasilitas kantor Anda.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {rentalPackages.map((pkg) => (
          <div class="rounded-xl bg-white border border-slate-200 p-6 space-y-4">
            <div class="flex items-center justify-between gap-2 text-xs">
              <span class="font-semibold text-[#c2410c]">{pkg.badge}</span>
              <span class="text-slate-500 font-medium">{pkg.duration}</span>
            </div>

            <h3 class="text-base sm:text-lg font-bold text-slate-950 leading-snug">{pkg.name}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{pkg.description}</p>

            <div class="pt-3 border-t border-slate-100 space-y-2">
              <span class="text-xs font-semibold text-slate-900 block">Cakupan Paket:</span>
              <ul class="space-y-1.5 list-disc pl-4 text-xs text-slate-700">
                {pkg.features.map((feat) => (
                  <li class="leading-relaxed">{feat}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Rental Units Specifications Matrix -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-2xl space-y-1.5">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-950 tracking-tight">
          Spesifikasi Unit Rental
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Gunakan panduan kapasitas berikut untuk memperkirakan jumlah unit pendingin dan daya genset di lokasi Anda.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {rentalUnits.map((unit) => (
          <div class="p-6 rounded-xl bg-slate-50 border border-slate-200 space-y-4">
            <div>
              <span class="text-xs font-semibold text-[#c2410c]">{unit.category}</span>
              <h3 class="text-base sm:text-lg font-bold text-slate-950 mt-1">{unit.name}</h3>
            </div>

            <div class="space-y-2 text-xs">
              <div class="flex items-start gap-2">
                <span class="font-semibold text-slate-700 shrink-0 w-24">Cakupan Luas:</span>
                <span class="text-slate-600">{unit.coverage}</span>
              </div>
              <div class="flex items-start gap-2">
                <span class="font-semibold text-slate-700 shrink-0 w-24">Spesifikasi:</span>
                <span class="text-slate-600">{unit.specs}</span>
              </div>
              <div class="flex items-start gap-2 pt-2 border-t border-slate-200">
                <span class="font-semibold text-slate-700 shrink-0 w-24">Ideal Untuk:</span>
                <span class="text-slate-600">{unit.idealFor}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SOP & Terms of Rental + Single End-of-Page Contact CTA -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-3xl space-y-1.5">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-950">Prosedur Sewa AC &amp; Genset</h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Proses pemesanan rental transparan dan terorganisir untuk kelancaran acara maupun operasional kantor Anda.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs text-slate-700">
        <div class="p-5 rounded-xl bg-white border border-slate-200 space-y-1.5">
          <span class="block text-xs font-bold text-[#c2410c]">01</span>
          <h3 class="font-bold text-slate-950 text-sm">Konfirmasi Jadwal &amp; Daya</h3>
          <p class="leading-relaxed text-slate-600">
            Pemesanan disarankan minimal H-3 sebelum pelaksanaan acara. Tim kami membantu menghitung beban daya listrik PLN atau kapasitas Genset Silent yang diperlukan.
          </p>
        </div>
        <div class="p-5 rounded-xl bg-white border border-slate-200 space-y-1.5">
          <span class="block text-xs font-bold text-[#c2410c]">02</span>
          <h3 class="font-bold text-slate-950 text-sm">Instalasi H-1</h3>
          <p class="leading-relaxed text-slate-600">
            Tim teknisi melakukan pengiriman dan instalasi pada H-1 atau beberapa jam sebelum acara dimulai sesuai izin akses loading gedung.
          </p>
        </div>
        <div class="p-5 rounded-xl bg-white border border-slate-200 space-y-1.5">
          <span class="block text-xs font-bold text-[#c2410c]">03</span>
          <h3 class="font-bold text-slate-950 text-sm">Teknisi Standby</h3>
          <p class="leading-relaxed text-slate-600">
            Untuk acara korporat penting, tersedia opsi teknisi standby yang memantau kestabilan temperatur dan jalur pembuangan air selama acara berlangsung.
          </p>
        </div>
        <div class="p-5 rounded-xl bg-white border border-slate-200 space-y-1.5">
          <span class="block text-xs font-bold text-[#c2410c]">04</span>
          <h3 class="font-bold text-slate-950 text-sm">Pembayaran &amp; Faktur Pajak</h3>
          <p class="leading-relaxed text-slate-600">
            Tersedia skema Down Payment (DP) saat booking tanggal dan pelunasan saat unit terpasang rapi, lengkap dengan invoice resmi perusahaan dan e-Faktur Pajak.
          </p>
        </div>
      </div>

      <!-- Single End-of-Page Quote Banner -->
      <div class="mt-8 rounded-xl bg-white border border-slate-200 p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-1.5 max-w-xl">
          <h3 class="text-lg sm:text-xl font-bold text-slate-950">Konsultasi Kapasitas &amp; Penjadwalan Sewa</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Kirimkan tanggal pelaksanaan, lokasi gedung, dan perkiraan luas ruangan melalui WhatsApp tim sewa Sentra AC.
          </p>
        </div>
        <div class="shrink-0">
          <a
            href={defaultRentalWaUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-semibold text-xs sm:text-sm border border-slate-300 transition-colors"
          >
            Konsultasi via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
