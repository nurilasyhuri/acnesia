---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { BUSINESS_INFO } from '../data/businessInfo';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../utils/seo';
import { generateGeneralInquiryUrl } from '../utils/whatsapp';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Tentang Kami', url: '/tentang-kami/' },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const waUrl = generateGeneralInquiryUrl('tentang-kami-cta');

const pillars = [
  {
    title: 'Keaslian Unit 100% Bergaransi Pabrik',
    desc: 'Kami menyuplai unit pendingin langsung melalui jaringan distributor prinsipal resmi (Daikin, Panasonic, Gree, Mitsubishi Electric) lengkap dengan kartu garansi agen terdaftar.',
  },
  {
    title: 'Standar Rekayasa & Vakum Sistem',
    desc: 'Teknisi Sentra AC menggunakan peralatan instalasi berstandar industri: manifold gauge digital, pompa vakum 2-stage, flaring tool presisi, dan pipa tembaga ketebalan standar ASTM 0.8mm.',
  },
  {
    title: 'Administrasi B2B & Kepatuhan Pajak',
    desc: 'Setiap transaksi korporat didukung oleh Surat Penawaran Harga (SPH), Rencana Anggaran Biaya (RAB), Berita Acara Serah Terima (BAST), dan e-Faktur Pajak resmi.',
  },
  {
    title: 'Responsibilitas Jangka Panjang',
    desc: 'Melalui skema kontrak preventive maintenance, kami merawat siklus hidup aset pendingin gedung Anda agar selalu bekerja efisien dan hemat energi.',
  },
];
---

<BaseLayout
  title="Profil Sentra AC: Jual Beli, Sewa, Pasang & Service AC - Sentra AC"
  description="Profil Sentra AC: spesialis jual beli AC baru dan bekas, sewa AC standing, instalasi pipa vakum, cuci berkala, & kontrak service AC kantor di Malang Raya."
  canonical={ensureAbsoluteUrl('/tentang-kami/')}
  jsonLd={breadcrumbSchema}
  keywords={[
    'tentang sentra ac',
    'profil perusahaan sentra ac',
    'mitra bisnis indonesia sentra ac',
    'kontraktor hvac malang',
    'supplier ac kantor malang',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Header -->
  <section class="bg-white py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-3.5">
        <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-bold text-slate-950 tracking-tight leading-tight">
          Sentra AC — Pusat Jual Beli, Sewa, Pasang &amp; Service AC B2B Jawa Timur
        </h1>
        <p class="text-base sm:text-lg font-semibold text-slate-800">
          {BUSINESS_INFO.valueProposition}
        </p>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Sentra AC didirikan untuk menjawab kebutuhan sektor bisnis, perkantoran, instansi pemerintah, dan pengelola gedung komersial akan mitra sistem pendingin ruangan yang dapat diandalkan, berstandar rekayasa jelas, dan tertib secara administrasi legalitas.
        </p>
      </div>
    </div>
  </section>

  <!-- Narrative Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <div class="lg:col-span-7 space-y-4 text-xs sm:text-sm text-slate-600 leading-relaxed">
          <h2 class="text-xl sm:text-3xl font-bold text-slate-950 tracking-tight">
            Pendekatan Rekayasa Tata Udara Komersial
          </h2>
          <p>
            Di sektor komersial—seperti ruang kantor berokupansi ratusan staf, ruang server perbankan, lobi hotel, atau ruang rapat direksi—kerusakan sistem AC berarti penurunan produktivitas kerja, gangguan operasional, dan kerugian finansial nyata.
          </p>
          <p>
            Banyak perusahaan menghadapi kendala teknisi panggilan lepas yang tidak konsisten, pemasangan pipa tanpa proses vakum digital yang benar, serta ketiadaan bukti Berita Acara Serah Terima dan Faktur Pajak.
          </p>
          <p>
            <strong class="text-slate-900">Sentra AC menyatukan seluruh mata rantai tata udara dalam satu pintu:</strong> mulai dari pengadaan unit baru maupun rekondisi, perencanaan kapasitas PK ruangan yang tepat, instalasi rapi dengan pipa ASTM 0.8mm, hingga program perawatan preventif berkala berbasis kontrak.
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-xl bg-white border border-slate-200 p-6 sm:p-8 space-y-4">
            <h3 class="text-lg sm:text-xl font-bold text-slate-950">Spesialis Tata Udara Komersial</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Berpusat di Kota Malang dengan hub proyek di koridor Surabaya–Sidoarjo, Sentra AC melayani korporasi, institusi pendidikan, fasilitas kesehatan, dan jaringan cabang bisnis di Jawa Timur.
            </p>

            <div class="pt-4 border-t border-slate-200 space-y-3 text-xs">
              <div class="flex items-start gap-3">
                <span class="font-bold text-slate-700 w-28 shrink-0">Workshop:</span>
                <span class="text-slate-600">{BUSINESS_INFO.address.formatted}</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="font-bold text-slate-700 w-28 shrink-0">Layanan Inti:</span>
                <span class="text-slate-600">{BUSINESS_INFO.brandDescriptor}</span>
              </div>
              <div class="flex items-start gap-3">
                <span class="font-bold text-slate-700 w-28 shrink-0">Telepon B2B:</span>
                <span class="text-slate-600">{BUSINESS_INFO.phone}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Pillars Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-2xl space-y-1.5">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-950 tracking-tight">
          Empat Pilar Standar Kerja Sentra AC
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Landasan operasional yang memastikan setiap pekerjaan bernilai investasi jangka panjang bagi fasilitas Anda.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {pillars.map((pillar) => (
          <div class="p-6 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
            <h3 class="text-base sm:text-lg font-bold text-slate-950">{pillar.title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{pillar.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="py-14 lg:py-16 bg-slate-50 text-slate-900 text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-950">
        Mulai Kemitraan Tata Udara dengan Sentra AC
      </h2>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-2xl mx-auto">
        Jadwalkan konsultasi awal untuk evaluasi sistem AC di kantor Anda atau diskusikan kebutuhan pengadaan proyek bersama kami.
      </p>
      <div class="pt-2">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-semibold text-sm border border-slate-300 transition-colors"
        >
          Konsultasi via WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
