---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';

const articles = await getCollection('artikel');
const sortedArticles = articles.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const featuredArticle = sortedArticles[0];
const regularArticles = sortedArticles.slice(1);

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Artikel & Panduan AC', url: '/artikel/' },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return d.toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<BaseLayout
  title="Panduan Hitung PK, Harga, Pasang & Service AC Kantor - Sentra AC"
  description="Kumpulan artikel panduan menghitung kapasitas PK AC ruangan, perbandingan AC Split vs Cassette, jadwal cuci AC, & tips hemat listrik kantor dari Sentra AC."
  canonical={ensureAbsoluteUrl('/artikel/')}
  jsonLd={breadcrumbSchema}
  keywords={[
    'artikel ac kantor',
    'panduan menghitung pk ac',
    'perawatan ac berkala',
    'ac cassette vs split',
    'kontrak maintenance hvac',
    'sentra ac malang',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Header -->
  <section class="bg-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-3">
        <h1 class="text-2xl sm:text-4xl font-bold text-slate-950 tracking-tight leading-tight">
          Panduan Teknis Hitung PK, Perawatan, Pasang &amp; Pemilihan AC Kantor
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Disusun oleh tim teknisi dan praktisi HVAC Sentra AC untuk membantu manajer fasilitas, pengelola gedung, serta tim pengadaan memilih kapasitas AC yang tepat, merawat kompresor, dan menekan biaya listrik operasional.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Article Hero Banner -->
  {featuredArticle && (
    <section class="py-10 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <a
          href={`/artikel/${featuredArticle.slug}/`}
          class="group block rounded-xl bg-white border border-slate-200 overflow-hidden hover:border-slate-300 transition-colors"
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 items-center">
            <div class="lg:col-span-7 aspect-16/10 lg:aspect-auto h-full overflow-hidden bg-slate-100">
              <img
                src={featuredArticle.data.heroImage}
                alt={`Panduan ${featuredArticle.data.title} - Sentra AC`}
                width="800"
                height="500"
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
                loading="eager"
              />
            </div>
            <div class="lg:col-span-5 p-6 sm:p-8 space-y-3.5">
              <div class="flex items-center gap-2 text-xs text-slate-500">
                <span class="font-semibold text-[#c2410c]">
                  {featuredArticle.data.category || 'Panduan Teknis'}
                </span>
                <span>·</span>
                <span>{formatDate(featuredArticle.data.publishDate)}</span>
              </div>

              <h2 class="text-lg sm:text-2xl font-bold text-slate-950 group-hover:text-[#c2410c] transition-colors leading-snug">
                {featuredArticle.data.title}
              </h2>

              <p class="text-xs sm:text-sm text-slate-600 line-clamp-3 leading-relaxed">
                {featuredArticle.data.description}
              </p>

              <p class="pt-1 text-xs font-medium text-slate-500">
                {featuredArticle.data.author}
              </p>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Regular Articles Grid -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="flex items-center justify-between">
        <h2 class="text-lg sm:text-xl font-bold text-slate-950">Semua Panduan &amp; Artikel B2B</h2>
        <span class="text-xs text-slate-500">{sortedArticles.length} Publikasi</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {regularArticles.map((article) => (
          <a
            href={`/artikel/${article.slug}/`}
            class="group rounded-xl bg-white border border-slate-200 hover:border-slate-300 transition-colors overflow-hidden block"
          >
            <div class="aspect-16/10 bg-slate-100 overflow-hidden">
              <img
                src={article.data.heroImage}
                alt={`Artikel ${article.data.title} - Sentra AC`}
                width="600"
                height="375"
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
                loading="lazy"
              />
            </div>

            <div class="p-5 space-y-2.5">
              <div class="flex items-center gap-2 text-xs text-slate-500">
                <span class="font-semibold text-[#c2410c]">{article.data.category || 'Wawasan AC'}</span>
                <span>·</span>
                <span>{formatDate(article.data.publishDate)}</span>
              </div>

              <h3 class="font-bold text-slate-950 group-hover:text-[#c2410c] transition-colors leading-snug line-clamp-2 text-base">
                {article.data.title}
              </h3>

              <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                {article.data.description}
              </p>

              <p class="pt-1 text-xs text-slate-500 font-medium">
                {article.data.author}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
