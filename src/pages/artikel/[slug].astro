---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getArticleSchema, getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

export async function getStaticPaths() {
  const articles = await getCollection('artikel');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article, allArticles: articles },
  }));
}

interface Props {
  article: any;
  allArticles: Array<any>;
}

const { article, allArticles } = Astro.props;
const { Content } = await article.render();

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Artikel & Panduan AC', url: '/artikel/' },
  { name: article.data.title, url: `/artikel/${article.slug}/` },
];

const articleJsonLd = getArticleSchema({
  title: article.data.title,
  description: article.data.description,
  publishDate: article.data.publishDate,
  author: article.data.author,
  heroImage: article.data.heroImage,
  slug: article.slug,
});

const breadcrumbJsonLd = getBreadcrumbSchema(breadcrumbs);

const combinedJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [articleJsonLd, breadcrumbJsonLd],
};

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return d.toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const waConsultUrl = generateGeneralInquiryUrl(`artikel-${article.slug}`);

const relatedArticles = allArticles
  .filter((a) => a.slug !== article.slug)
  .slice(0, 3);
---

<BaseLayout
  title={`${article.data.title} | ACNesia`}
  description={article.data.description}
  canonical={ensureAbsoluteUrl(`/artikel/${article.slug}/`)}
  image={article.data.heroImage}
  type="article"
  author={article.data.author}
  jsonLd={combinedJsonLd}
  keywords={article.data.tags || ['artikel ac kantor', 'tata udara']}
>
  <!-- Breadcrumb -->
  <div class="bg-white border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Article Header Section -->
  <article class="py-10 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      
      <!-- Meta Tag & Category -->
      <div class="flex items-center gap-3 text-xs">
        <span class="px-3 py-1 rounded-full font-bold bg-red-100 text-red-900">
          {article.data.category || 'Panduan Rekayasa AC'}
        </span>
        <span class="text-slate-400">•</span>
        <time datetime={article.data.publishDate} class="text-slate-500 font-medium">
          {formatDate(article.data.publishDate)}
        </time>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-950 tracking-tight leading-tight">
        {article.data.title}
      </h1>

      <!-- Subtitle Description -->
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
        {article.data.description}
      </p>

      <!-- Author Byline -->
      <div class="flex items-center gap-3 py-4 border-y border-slate-200 text-xs">
        <div class="w-10 h-10 rounded-full bg-red-700 text-white flex items-center justify-center font-bold text-sm shadow-xs">
          AC
        </div>
        <div>
          <div class="font-bold text-slate-900">{article.data.author}</div>
          <div class="text-slate-500">Divisi Rekayasa & Tata Udara ACNesia Mitra Bisnis Indonesia</div>
        </div>
      </div>

      <!-- Hero Image -->
      <div class="rounded-3xl overflow-hidden bg-slate-100 aspect-16/10 shadow-md">
        <img
          src={article.data.heroImage}
          alt={article.data.title}
          width="900"
          height="562"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>

      <!-- Editorial Body (Medium-like clean typography without harsh divider lines) -->
      <div class="pt-6 prose prose-slate prose-lg max-w-none prose-headings:font-bold prose-headings:text-slate-950 prose-p:text-slate-700 prose-p:leading-relaxed prose-li:text-slate-700 prose-strong:text-slate-900 prose-hr:border-transparent prose-table:text-sm">
        <Content />
      </div>

      <!-- Tags Strip -->
      {article.data.tags && (
        <div class="pt-8 border-t border-slate-200 flex flex-wrap items-center gap-2">
          <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-2">Topik:</span>
          {article.data.tags.map((tag: string) => (
            <span class="px-3 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- Integrated Consultation Callout Box -->
      <div class="mt-12 rounded-3xl bg-gradient-to-br from-slate-900 via-slate-800 to-slate-950 p-8 sm:p-10 text-white relative overflow-hidden shadow-xl space-y-4">
        <div class="relative z-10 max-w-xl space-y-2">
          <span class="text-xs font-bold text-red-400 uppercase tracking-wider">Konsultasi Teknis</span>
          <h3 class="text-xl sm:text-2xl font-extrabold">Ingin Menghitung Beban Pendingin Fasilitas Anda?</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Hindari salah beli unit atau kompresor cepat jebol. Diskusikan denah dan kebutuhan AC kantor Anda bersama konsultan ACNesia.
          </p>
        </div>
        <div class="relative z-10 pt-2 flex flex-wrap items-center gap-3">
          <a
            href={waConsultUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-md transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
            </svg>
            <span>Tanya Rekomendasi Teknis via WA</span>
          </a>
          <a
            href="/layanan/"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white font-semibold text-xs border border-white/20 transition-colors"
          >
            <span>Lihat Semua Layanan ACNesia</span>
          </a>
        </div>
      </div>

    </div>
  </article>

  <!-- Related Articles -->
  {relatedArticles.length > 0 && (
    <section class="py-12 bg-slate-50 border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <h2 class="text-xl font-bold text-slate-900">Panduan Terkait Lainnya</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedArticles.map((rel) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-5 hover:shadow-md transition-all flex flex-col justify-between">
              <div class="space-y-2">
                <span class="text-[10px] font-bold text-red-800 uppercase tracking-wider">{rel.data.category || 'Wawasan AC'}</span>
                <h3 class="font-bold text-slate-900 text-sm line-clamp-2">
                  <a href={`/artikel/${rel.slug}/`} class="hover:text-red-800">
                    {rel.data.title}
                  </a>
                </h3>
                <p class="text-xs text-slate-500 line-clamp-2">{rel.data.description}</p>
              </div>
              <div class="pt-4 border-t border-slate-100 mt-4">
                <a href={`/artikel/${rel.slug}/`} class="text-xs font-semibold text-red-700 hover:underline inline-flex items-center gap-1">
                  <span>Baca Artikel</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
