---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getArticleSchema, getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

export async function getStaticPaths() {
  const articles = await getCollection('artikel');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article, allArticles: articles },
  }));
}

interface Props {
  article: any;
  allArticles: Array<any>;
}

const { article, allArticles } = Astro.props;
const { Content } = await article.render();

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Artikel & Panduan AC', url: '/artikel/' },
  { name: article.data.title, url: `/artikel/${article.slug}/` },
];

const articleJsonLd = getArticleSchema({
  title: article.data.title,
  description: article.data.description,
  publishDate: article.data.publishDate,
  author: article.data.author,
  heroImage: article.data.heroImage,
  slug: article.slug,
});

const breadcrumbJsonLd = getBreadcrumbSchema(breadcrumbs);

const combinedJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [articleJsonLd, breadcrumbJsonLd],
};

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return d.toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}

const waConsultUrl = generateGeneralInquiryUrl(`artikel-${article.slug}`);

const relatedArticles = allArticles
  .filter((a) => a.slug !== article.slug)
  .slice(0, 3);
---

<BaseLayout
  title={`${article.data.title} - Sentra AC`}
  description={article.data.description}
  canonical={ensureAbsoluteUrl(`/artikel/${article.slug}/`)}
  image={article.data.heroImage}
  type="article"
  author={article.data.author}
  jsonLd={combinedJsonLd}
  keywords={article.data.tags || ['artikel ac kantor', 'tata udara']}
>
  <div class="bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Article Header & Body Section -->
  <article class="py-10 md:py-14 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-4">
        <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
          <span class="font-semibold text-[#c2410c]">
            {article.data.category || 'Panduan Rekayasa AC'}
          </span>
          <span>·</span>
          <time datetime={article.data.publishDate} class="font-medium">
            {formatDate(article.data.publishDate)}
          </time>
          <span>·</span>
          <span>Oleh {article.data.author}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl lg:text-[40px] font-bold text-slate-950 tracking-tight leading-tight">
          {article.data.title}
        </h1>

        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          {article.data.description}
        </p>

        <div class="pt-2 rounded-xl overflow-hidden bg-slate-100 aspect-16/10 border border-slate-200">
          <img
            src={article.data.heroImage}
            alt={`Ilustrasi ${article.data.title} - Sentra AC`}
            width="900"
            height="562"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      </div>

      <!-- Editorial Body -->
      <div class="pt-8 prose max-w-none">
        <Content />
      </div>

      <!-- Tags Strip (Inline Typographic Flow Invariant) -->
      {article.data.tags && (
        <div class="mt-4 flex flex-wrap items-baseline gap-x-2.5 gap-y-1 text-xs text-slate-600">
          <span class="font-semibold text-[#c2410c]">Tag:</span>
          {article.data.tags.map((tag: string) => (
            <span class="py-0.5 text-slate-600">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- End-of-Article Consultation Callout Box -->
      <div class="mt-10 rounded-xl bg-slate-50 border border-slate-200 p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-5">
        <div class="max-w-xl space-y-1.5">
          <h2 class="text-lg sm:text-xl font-bold text-slate-950">
            Perhitungan Beban Pendingin &amp; Pengajuan SPH Kantor
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Diskusikan denah ruangan dan kebutuhan kapasitas unit bersama tim estimator B2B Sentra AC.
          </p>
        </div>
        <div class="shrink-0">
          <a
            href={waConsultUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-semibold text-xs sm:text-sm border border-slate-300 transition-colors"
          >
            Konsultasi via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </article>

  <!-- Related Articles -->
  {relatedArticles.length > 0 && (
    <section class="py-12 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <h2 class="text-xl font-bold text-slate-950">Panduan Terkait Lainnya</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedArticles.map((rel) => (
            <a
              href={`/artikel/${rel.slug}/`}
              class="group rounded-xl border border-slate-200 bg-white p-5 hover:border-slate-300 transition-colors block space-y-2"
            >
              <span class="block text-xs font-semibold text-[#c2410c]">{rel.data.category || 'Wawasan AC'}</span>
              <h3 class="font-bold text-slate-950 group-hover:text-[#c2410c] transition-colors text-sm sm:text-base line-clamp-2">
                {rel.data.title}
              </h3>
              <p class="text-xs text-slate-600 line-clamp-2">{rel.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
