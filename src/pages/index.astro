---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/products/ProductCard.astro';
import { getLocalBusinessSchema, getWebsiteSchema } from '../utils/seo';
import { getCollection } from 'astro:content';
import { generateGeneralInquiryUrl } from '../utils/whatsapp';

const products = await getCollection('produk');
const sortedProducts = products.sort((a, b) => a.data.orderPriority - b.data.orderPriority);

const localBusinessSchema = getLocalBusinessSchema();
const websiteSchema = getWebsiteSchema();
const waInquiryUrl = generateGeneralInquiryUrl('homepage-final-cta');

const homeKeywords = [
  'jual ac baru dan bekas',
  'sewa ac malang',
  'jasa service ac',
  'jasa pasang ac',
  'jasa cuci ac',
  'pengadaan ac kantor',
  'jual beli ac bekas kantor',
  'supplier ac indonesia',
];

const coreServices = [
  {
    badge: 'BARU & SECOND',
    title: 'Jual AC Baru dan Bekas',
    desc: 'Unit Baru & Rekondisi',
    href: '/layanan/jual-pengadaan-ac/',
    image: '/images/services/pengadaan-ac-kantor.webp',
    rfqCategory: 'Jual Beli AC',
    rfqCapacity: 'Baru / Second',
    detail: 'Penyediaan unit AC baru bergaransi resmi pabrik, penjualan AC second rekondisi siap pakai, serta terima borongan & tukar tambah (trade-in) AC bekas kantor segala kondisi.',
  },
  {
    badge: 'HARIAN & BULANAN',
    title: 'Sewa AC',
    desc: 'Standing & Split Event',
    href: '/layanan/sewa-ac/',
    image: '/images/services/sewa-ac-standing.webp',
    rfqCategory: 'Sewa Unit',
    rfqCapacity: 'Harian / Bulanan',
    detail: 'Penyediaan unit AC Floor Standing 3 PK – 5 PK dan AC Split untuk acara korporat, pameran, ruang rapat darurat, maupun kontrak sewa bulanan proyek.',
  },
  {
    badge: 'CEPAT TANGGAP',
    title: 'Jasa Service AC',
    desc: 'Perbaikan & Cek Freon',
    href: '/layanan/service-ac/',
    image: '/images/services/service-ac-kantor.webp',
    rfqCategory: 'Layanan Service',
    rfqCapacity: 'Perbaikan & Freon',
    detail: 'Penanganan keluhan AC tidak dingin, bocor air di ruang kerja, suara kompresor kasar, pengecekan tekanan freon, hingga penggantian sparepart bergaransi.',
  },
  {
    badge: 'STANDAR VAKUM',
    title: 'Jasa Pasang AC',
    desc: 'Instalasi & Relokasi',
    href: '/layanan/instalasi-ac/',
    image: '/images/services/instalasi-ac-profesional.webp',
    rfqCategory: 'Layanan Instalasi',
    rfqCapacity: 'Pasang & Relokasi',
    detail: 'Pemasangan unit AC baru maupun bongkar pasang relokasi antar ruangan/gedung. Wajib prosedur mesin vakum digital, pipa tembaga tebal, dan uji ampere kelistrikan.',
  },
  {
    badge: 'DEEP CLEANING',
    title: 'Jasa Cuci AC',
    desc: 'Cuci Steam & Overhaul',
    href: '/layanan/preventive-maintenance/',
    image: '/images/services/preventive-maintenance-ac.webp',
    rfqCategory: 'Perawatan Rutin',
    rfqCapacity: 'Satuan / Kontrak',
    detail: 'Pencucian steam bertekanan tinggi pada evaporator indoor, blower, jalur drainase, dan kondensor outdoor untuk memulihkan hembusan dingin serta menekan tagihan listrik.',
  },
];
---

<BaseLayout
  title="Jual AC Baru & Bekas, Sewa, Service, Pasang & Cuci AC - ACNesia"
  description="Mitra satu pintu Jual AC Baru dan Bekas, Sewa AC, Jasa Service AC, Jasa Pasang AC, dan Jasa Cuci AC berstandar profesional untuk kantor dan bisnis di Indonesia."
  keywords={homeKeywords}
  jsonLd={[localBusinessSchema, websiteSchema]}
>
  <!-- 1. HERO + 5 LAYANAN SHOWCASE (Seamless Translucent Daylight Backdrop) -->
  <section class="relative -mt-[76px] pt-[124px] pb-16 lg:pt-[140px] lg:pb-20 bg-gradient-to-b from-sky-100/90 via-sky-50/55 to-white text-slate-900 font-sans overflow-hidden border-b border-slate-200/70">
    <!-- Translucent Architectural Background Image -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img
        src="/images/hero/hero-acnesia.webp"
        alt="Sistem Tata Udara Komersial ACNesia"
        width="1920"
        height="1080"
        class="w-full h-full object-cover opacity-15 saturate-50"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-sky-100/55 via-white/75 to-white backdrop-blur-[2px]"></div>
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[960px] h-[420px] rounded-full bg-sky-200/40 blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      <!-- Top Hero Copy -->
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/85 backdrop-blur-md border border-slate-200/90 text-slate-700 text-[11px] font-mono font-bold tracking-[0.14em] uppercase shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-teal-600"></span>
          <span>ACNesia • Mitra Tata Udara Indonesia</span>
        </div>

        <div class="space-y-4">
          <h1 class="text-3xl sm:text-5xl lg:text-[54px] font-black text-slate-950 tracking-tight leading-[1.12]">
            Semua Kebutuhan AC Bisnis,<br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-700 via-sky-700 to-slate-900">
              Satu Mitra Terpercaya.
            </span>
          </h1>
          <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
            Layanan satu pintu <strong>Jual AC Baru dan Bekas</strong>, <strong>Sewa AC</strong>, <strong>Jasa Service AC</strong>, <strong>Jasa Pasang AC</strong>, dan <strong>Jasa Cuci AC</strong> berstandar teknis presisi untuk kantor, gedung, dan bisnis.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-2.5 sm:gap-3 pt-1">
          <a
            href={waInquiryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-xs sm:text-sm tracking-normal shadow-sm transition-all select-none cursor-pointer whitespace-nowrap"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.625.846 5.059 2.284 7.033l-1.494 4.462 4.611-1.466c1.911 1.24 4.179 1.971 6.599 1.971 6.627 0 12-5.373 12-12s-5.373-12-12-12z"/>
            </svg>
            <span>Chat WhatsApp Sekarang</span>
          </a>

          <a
            href="#katalog-ac"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs sm:text-sm tracking-normal shadow-sm transition-all select-none cursor-pointer whitespace-nowrap"
          >
            <span>Jelajahi Unit & Spesifikasi</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>
          </a>

          <button
            type="button"
            data-open-rfq
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl bg-white/90 hover:bg-white backdrop-blur-md border border-slate-300 text-slate-900 font-semibold text-xs sm:text-sm tracking-normal shadow-2xs transition-all select-none cursor-pointer whitespace-nowrap"
          >
            <svg class="w-4 h-4 text-teal-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span>Keranjang Penawaran (RFQ)</span>
          </button>
        </div>
      </div>

      <!-- 5 Layanan Utama Showcase Card Panel (Modeled directly after Numa Screenshot) -->
      <div id="layanan-utama" class="rounded-2xl bg-white/90 backdrop-blur-xl border border-slate-200/90 shadow-[0_20px_50px_-15px_rgba(15,23,42,0.08)] p-5 sm:p-7 space-y-5 scroll-mt-24">
        <div class="flex items-center justify-between text-[11px] font-mono">
          <div class="flex items-center gap-2 font-bold tracking-[0.16em] uppercase text-slate-800">
            <span class="w-2 h-2 rounded-full bg-teal-600"></span>
            <span>KATEGORI LAYANAN UTAMA</span>
          </div>
          <a href="/layanan/" class="text-slate-500 hover:text-slate-900 transition-colors">
            5 Layanan Tata Udara Terpadu &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
          {coreServices.map((srv) => (
            <a
              href={srv.href}
              class="group relative block h-[168px] rounded-lg overflow-hidden bg-slate-200 border border-slate-200/80 shadow-2xs"
            >
              <img
                src={srv.image}
                alt={srv.title}
                width="360"
                height="220"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-900/40 to-slate-900/10"></div>

              <!-- Top-left White Badge -->
              <div class="absolute top-3 left-3">
                <span class="inline-block px-2.5 py-1 rounded-xs bg-white text-slate-900 font-mono text-[9px] font-bold tracking-[0.12em] uppercase shadow-2xs">
                  {srv.badge}
                </span>
              </div>

              <!-- Bottom Title, Subtitle & Square Arrow -->
              <div class="absolute inset-x-3 bottom-3 flex items-end justify-between gap-2">
                <div class="space-y-0.5 min-w-0">
                  <h2 class="font-bold text-[13px] text-white leading-tight">
                    {srv.title}
                  </h2>
                  <p class="text-[11px] text-slate-200/95 font-normal leading-tight">
                    {srv.desc}
                  </p>
                </div>
                <span class="w-6 h-6 rounded bg-white/20 group-hover:bg-white/35 backdrop-blur-xs text-white flex items-center justify-center shrink-0 transition-colors">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>

        <!-- Bottom Trust Bar inside Panel -->
        <div class="pt-3.5 border-t border-slate-200/70 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs text-slate-600">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <span class="inline-flex items-center gap-2 font-bold text-slate-900">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              100% Bergaransi Resmi
            </span>
            <span class="text-slate-300">•</span>
            <span>Teknisi Tersertifikasi Standar Vakum</span>
            <span class="text-slate-300">•</span>
            <span>Faktur Pajak & BAP Lengkap</span>
          </div>
          <span class="font-medium text-slate-600">
            Gratis Survey Lokasi Malang Raya
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. FEATURED PRODUCTS CATALOG (Equal-Height Grid) -->
  <section id="katalog-ac" class="py-16 md:py-20 bg-slate-50/70 border-b border-slate-200/70 font-sans scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-slate-200 mb-8">
        <div class="space-y-1">
          <span class="text-[11px] font-mono font-bold uppercase tracking-[0.14em] text-teal-700">Unit Baru & Second Siap Pakai</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            Katalog Unit AC & Spesifikasi
          </h2>
          <p class="text-xs sm:text-sm text-slate-600">
            Pilih unit untuk langsung ditambahkan ke daftar permintaan penawaran (RFQ) resmi.
          </p>
        </div>

        <!-- Segmented Tab Filter -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1 md:pb-0">
          <button
            type="button"
            data-filter-tab="all"
            class="home-tab-btn active px-3.5 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-white cursor-pointer select-none"
          >
            Semua
          </button>
          <button
            type="button"
            data-filter-tab="ac-split"
            class="home-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 cursor-pointer select-none"
          >
            Split Wall
          </button>
          <button
            type="button"
            data-filter-tab="ac-cassette"
            class="home-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 cursor-pointer select-none"
          >
            Cassette 4-Way
          </button>
          <button
            type="button"
            data-filter-tab="ac-floor-standing"
            class="home-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 cursor-pointer select-none"
          >
            Floor Standing
          </button>
          <button
            type="button"
            data-filter-tab="ac-commercial"
            class="home-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 cursor-pointer select-none"
          >
            Ducted Central
          </button>
        </div>
      </div>

      <!-- Product Showcase (Equal Height Flex/Grid) -->
      <div id="home-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch">
        {sortedProducts.map((product) => (
          <div data-product-category={product.data.category} class="product-item-wrap h-full">
            <ProductCard product={{
              title: product.data.title,
              description: product.data.description,
              category: product.data.category,
              capacity: product.data.capacity,
              priceDisplay: product.data.priceDisplay,
              stockStatus: product.data.stockStatus,
              thumbnail: product.data.thumbnail,
              slug: product.slug,
              brand: product.data.brand,
            }} />
          </div>
        ))}
      </div>

      <!-- Trade-In / Used AC Note -->
      <div class="mt-12 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-600">
        <p>
          Punya stok AC kantor lama yang ingin dijual borongan atau ditukar tambah (<em>trade-in</em>) dengan unit baru? Tim ACNesia siap melakukan taksiran harga terbaik.
        </p>
        <a
          href="/layanan/jual-pengadaan-ac/"
          class="shrink-0 font-bold text-teal-800 hover:text-teal-950 underline underline-offset-4"
        >
          Pelajari Jual AC Baru dan Bekas &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- 3. EDITORIAL SPLIT: RINCIAN CAKUPAN 5 LAYANAN UTAMA -->
  <section class="py-20 bg-white font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-5 space-y-4 lg:sticky lg:top-28">
          <span class="text-[11px] font-mono font-bold uppercase tracking-[0.14em] text-teal-700">Cakupan Teknis & RFQ</span>
          <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight">
            Satu Rekanan untuk Seluruh Siklus Tata Udara
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Tidak perlu membagi tanggung jawab antara toko penjual unit, tukang pasang lepas, dan jasa cuci panggilan. ACNesia mengintegrasikan kelima layanan inti tata udara dalam satu standar kerja profesional.
          </p>
          <div class="pt-2">
            <button
              type="button"
              data-open-rfq
              class="inline-flex items-center gap-2 py-2.5 px-5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs tracking-normal shadow-xs transition-colors cursor-pointer select-none"
            >
              <span>Ajukan Paket Layanan di RFQ</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
          </div>
        </div>

        <div class="lg:col-span-7 divide-y divide-slate-200">
          {coreServices.map((srv, idx) => (
            <div class="py-5 first:pt-0 last:pb-0 space-y-2">
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  <span class="font-mono text-xs font-bold text-teal-700">0{idx + 1}</span>
                  <h3 class="font-bold text-base text-slate-900">
                    <a href={srv.href} class="hover:text-teal-800 transition-colors">
                      {srv.title}
                    </a>
                  </h3>
                </div>
                <button
                  type="button"
                  data-rfq-add
                  data-title={srv.title}
                  data-category={srv.rfqCategory}
                  data-capacity={srv.rfqCapacity}
                  class="text-xs font-bold text-teal-700 hover:text-teal-900 cursor-pointer shrink-0"
                >
                  + Tambah RFQ
                </button>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed pl-7">
                {srv.detail}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. B2B ENGINEERING COMPARISON MATRIX (Light Translucent Table) -->
  <section class="py-16 md:py-20 bg-gradient-to-b from-slate-50 via-sky-50/40 to-slate-50 border-t border-b border-slate-200/80 text-slate-900 font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-2 mb-10">
        <span class="text-[11px] font-mono font-bold uppercase tracking-[0.14em] text-teal-700">Standar Mutu Proyek</span>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-950">
          Standar Kerja ACNesia vs Teknisi Lepas Biasa
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Perbedaan parameter teknis operasional yang menjamin ketahanan unit pendingin ruangan Anda.
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl bg-white/85 backdrop-blur-md border border-slate-200/90 shadow-2xs">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50/80 text-slate-600 font-semibold">
              <th class="py-4 px-6 w-1/4">Parameter Kerja</th>
              <th class="py-4 px-6 w-3/8 text-slate-500">Teknisi Panggilan Biasa</th>
              <th class="py-4 px-6 w-3/8 text-teal-800 font-bold">Standar Rekayasa ACNesia</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200/70 text-slate-700">
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">Jual AC Baru & Bekas</td>
              <td class="py-4 px-6 text-slate-500">Unit second tanpa pengecekan kebocoran atau garansi jelas</td>
              <td class="py-4 px-6 text-slate-900 font-medium">Unit baru bergaransi resmi & unit bekas lulus uji kompresor, cuci overhaul, plus garansi fungsi.</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">Prosedur Pasang & Vakum</td>
              <td class="py-4 px-6 text-slate-500">Sering dilewati atau hanya <em>flushing freon</em></td>
              <td class="py-4 px-6 text-slate-900 font-medium">Wajib mesin vakum digital untuk memastikan nol kelembapan udara di dalam pipa tembaga.</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">Kejujuran Service & Cuci</td>
              <td class="py-4 px-6 text-slate-500">Sering klaim "tambah freon" tanpa cek titik bocor</td>
              <td class="py-4 px-6 text-slate-900 font-medium">Pengecekan tekanan manifold transparan, cuci steam menyeluruh dengan plastik pelindung rapi.</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">Kelengkapan Administrasi</td>
              <td class="py-4 px-6 text-slate-500">Nota kuitansi tulis tangan tanpa legalitas</td>
              <td class="py-4 px-6 text-slate-900 font-medium">Surat Perintah Kerja (SPK), Berita Acara Pekerjaan (BAP), invoice resmi, dan Faktur Pajak.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 5. FINAL CONVERSION SECTION (Light Translucent Glass) -->
  <section class="py-20 bg-gradient-to-b from-white via-sky-50/50 to-slate-100/80 text-slate-900 font-sans">
