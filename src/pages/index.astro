      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <button
          type="button"
          data-open-rfq
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3.5 px-8 rounded-xl bg-red-700 hover:bg-red-800 text-white font-bold text-sm tracking-normal shadow-sm transition-colors cursor-pointer select-none"
