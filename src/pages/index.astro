  <!-- 9. FINAL CONVERSION SECTION (Single WhatsApp Contact Button as authorized by preferences) -->
  <section class="py-20 bg-slate-950 text-white font-sans">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
