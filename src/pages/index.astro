---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/products/ProductCard.astro';
import { getLocalBusinessSchema, getWebsiteSchema } from '../utils/seo';
import { getCollection } from 'astro:content';
import { generateGeneralInquiryUrl } from '../utils/whatsapp';

const [products, articles] = await Promise.all([
  getCollection('produk'),
  getCollection('artikel'),
]);

const sortedProducts = products.sort((a, b) => a.data.orderPriority - b.data.orderPriority);

const localBusinessSchema = getLocalBusinessSchema();
const websiteSchema = getWebsiteSchema();
const waInquiryUrl = generateGeneralInquiryUrl('homepage-final-cta');

const homeKeywords = [
  'pengadaan ac kantor',
  'jual ac perusahaan',
  'kontrak maintenance ac kantor',
  'preventive maintenance ac b2b',
  'sewa ac standing',
  'service ac komersial',
  'instalasi ac gedung',
  'supplier ac indonesia',
];

// Clean category collections for editorial showcase
const collections = [
  {
    title: 'AC Split Wall',
    desc: 'Ruang kerja & kantor privat',
    capacity: '1/2 PK - 2.5 PK',
    href: '/produk/ac-split/',
    image: '/images/products/ac-split-wall-mounted.webp',
  },
  {
    title: 'AC Cassette 4-Way',
    desc: 'Plafon aula & ruang meeting',
    capacity: '2 PK - 5 PK',
    href: '/produk/ac-cassette/',
    image: '/images/products/ac-cassette-4-way.webp',
  },
  {
    title: 'AC Floor Standing',
    desc: 'Lobi & aula pertemuan besar',
    capacity: '3 PK - 5 PK',
    href: '/produk/ac-floor-standing/',
    image: '/images/products/ac-floor-standing.webp',
  },
  {
    title: 'AC Ducted Central',
    desc: 'Integrasi tata udara tersembunyi',
    capacity: '3 PK - 10 PK',
    href: '/produk/ac-commercial/',
    image: '/images/products/ac-ceiling-ducted.webp',
  },
  {
    title: 'Sewa AC Proyek',
    desc: 'Rental fleksibel harian & bulanan',
    capacity: 'Ready Kirim',
    href: '/sewa-ac/',
    image: '/images/services/sewa-ac-standing.webp',
  },
];
---

<BaseLayout
  title="Pengadaan Unit AC Kantor, Instalasi & Service B2B - ACNesia"
  description="Solusi pengadaan AC kantor baru bergaransi resmi, jasa instalasi berstandar vakum, kontrak maintenance berkala, dan sewa unit untuk bisnis di Indonesia."
  keywords={homeKeywords}
  jsonLd={[localBusinessSchema, websiteSchema]}
>
  <!-- 1. HERO SECTION (Apple / Modern B2B Editorial - Zero Cards) -->
  <section class="relative min-h-[90vh] lg:min-h-screen flex items-center justify-center bg-slate-950 text-white font-sans overflow-hidden pt-20 pb-16">
    <!-- Background Technical HVAC Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero/hero-acnesia.webp"
        alt="Sistem Tata Udara Komersial ACNesia"
        width="1920"
        height="1080"
        class="w-full h-full object-cover opacity-20"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-slate-950/90"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      <!-- Minimalist Eyebrow -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-slate-900/90 border border-slate-800 text-red-400 text-xs font-semibold tracking-wide">
        <span class="w-2 h-2 rounded-full bg-red-500"></span>
        <span>ACNesia • Mitra Bisnis Indonesia</span>
      </div>

      <!-- Main Headline -->
      <div class="space-y-4">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.12]">
          Semua Kebutuhan AC Bisnis,<br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 via-amber-200 to-white">
            Satu Mitra.
          </span>
        </h1>
        <p class="text-sm sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal">
          Pengadaan unit baru bergaransi pabrik, instalasi berstandar teknik pendingin presisi, kontrak preventive maintenance terjadwal, dan sewa unit untuk perkantoran dan fasilitas komersial.
        </p>
      </div>

      <!-- Primary Action Buttons (No CTA spam) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-2">
        <a
          href="#katalog-ac"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3.5 px-7 rounded-xl bg-red-700 hover:bg-red-800 text-white font-bold text-sm tracking-normal shadow-sm transition-all select-none cursor-pointer"
        >
          <span>Jelajahi Katalog B2B</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
          </svg>
        </a>

        <button
          type="button"
          data-open-rfq
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3.5 px-7 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-white font-semibold text-sm tracking-normal shadow-sm transition-all select-none cursor-pointer"
        >
          <svg class="w-4 h-4 fill-none stroke-currentColor text-red-400" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span>Buka Keranjang RFQ</span>
          <span class="rfq-badge-counter hidden px-1.5 py-0.5 rounded-full bg-red-700 text-white font-black text-[10px] leading-none min-w-[18px]">0</span>
        </button>
      </div>

      <!-- Unboxed Capability Strip (Clean Divided Row, NO CARDS) -->
      <div class="pt-10 border-t border-slate-800/80 max-w-4xl mx-auto">
        <div class="grid grid-cols-2 sm:grid-cols-5 divide-y sm:divide-y-0 sm:divide-x divide-slate-800 text-center text-xs">
          <div class="py-2.5 px-3">
            <span class="font-bold text-white block">Pengadaan AC</span>
            <span class="text-[11px] text-slate-400">Unit Baru & Multi-Unit</span>
          </div>
          <div class="py-2.5 px-3">
            <span class="font-bold text-white block">Instalasi Rapi</span>
            <span class="text-[11px] text-slate-400">Standar Mesin Vakum</span>
          </div>
          <div class="py-2.5 px-3">
            <span class="font-bold text-white block">Service Rutin</span>
            <span class="text-[11px] text-slate-400">Cuci Steam Bertekanan</span>
          </div>
          <div class="py-2.5 px-3">
            <span class="font-bold text-white block">Maintenance</span>
            <span class="text-[11px] text-slate-400">Kontrak Terjadwal B2B</span>
          </div>
          <div class="py-2.5 px-3 col-span-2 sm:col-span-1">
            <span class="font-bold text-white block">Legalitas B2B</span>
            <span class="text-[11px] text-slate-400">Faktur Pajak & BAP</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. EDITORIAL COLLECTION SHOWCASE (Minimalist, Unboxed Product Categories) -->
  <section class="py-16 bg-white font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-baseline justify-between border-b border-slate-200 pb-4 mb-8">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-red-800">Lini Tata Udara</span>
          <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight mt-0.5">
            Kategori Unit Pendingin Ruangan
          </h2>
        </div>
        <a href="/produk/" class="text-xs font-semibold text-slate-600 hover:text-red-800 transition-colors">
          Semua Katalog &rarr;
        </a>
      </div>

      <!-- Linear Category Strip (Unboxed, Image + Typography) -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        {collections.map((col) => (
          <a href={col.href} class="group block space-y-3">
            <div class="aspect-4/3 rounded-xl overflow-hidden bg-slate-100 border border-slate-200/80 group-hover:border-slate-300 transition-colors">
              <img
                src={col.image}
                alt={col.title}
                width="400"
                height="300"
                class="w-full h-full object-cover group-hover:scale-104 transition-transform duration-500 ease-out"
                loading="lazy"
              />
            </div>
            <div class="space-y-0.5">
              <h3 class="font-bold text-sm text-slate-900 group-hover:text-red-800 transition-colors">
                {col.title}
              </h3>
              <p class="text-xs text-slate-500 line-clamp-1">{col.desc}</p>
              <span class="text-[11px] font-semibold text-red-700 block">{col.capacity}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. FEATURED PRODUCTS CATALOG (Unboxed Grid with Segmented Tab Filter) -->
  <section id="katalog-ac" class="py-16 md:py-20 bg-slate-50 font-sans scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-slate-200 mb-8">
        <div class="space-y-1">
          <span class="text-[11px] font-bold uppercase tracking-wider text-red-800">Unit Komersial</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            Katalog Produk & Spesifikasi
          </h2>
          <p class="text-xs sm:text-sm text-slate-600">
            Pilih unit untuk langsung ditambahkan ke proposal penawaran (RFQ) resmi perusahaan.
          </p>
        </div>

        <!-- Segmented Tab Filter -->
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1 md:pb-0">
          <button
            type="button"
            data-filter-tab="all"
            class="home-tab-btn active px-3.5 py-1.5 rounded-lg text-xs font-bold bg-slate-900 text-white cursor-pointer select-none"
          >
            Semua
          </button>
          <button
            type="button"
            data-filter-tab="ac-split"
            class="home-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 cursor-pointer select-none"
          >
            Split Wall
          </button>
          <button
            type="button"
            data-filter-tab="ac-cassette"
            class="home-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 cursor-pointer select-none"
          >
            Cassette 4-Way
          </button>
          <button
            type="button"
            data-filter-tab="ac-floor-standing"
            class="home-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 cursor-pointer select-none"
          >
            Floor Standing
          </button>
          <button
            type="button"
            data-filter-tab="ac-commercial"
            class="home-tab-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-white text-slate-700 border border-slate-200 hover:bg-slate-100 cursor-pointer select-none"
          >
            Ducted Central
          </button>
        </div>
      </div>

      <!-- Product Showcase (Clean, Unboxed Cards) -->
      <div id="home-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {sortedProducts.map((product) => (
          <div data-product-category={product.data.category} class="product-item-wrap">
            <ProductCard product={{
              title: product.data.title,
              description: product.data.description,
              category: product.data.category,
              capacity: product.data.capacity,
              priceDisplay: product.data.priceDisplay,
              stockStatus: product.data.stockStatus,
              thumbnail: product.data.thumbnail,
              slug: product.slug,
              brand: product.data.brand,
            }} />
          </div>
        ))}
      </div>

      <!-- Clean Typographic Procurement Note (No Boxed Card) -->
      <div class="mt-14 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-600">
        <p>
          Memerlukan sistem skala besar (VRV / VRF, Chiller, Multi-Split)? Tim sales engineering ACNesia siap menyusun Bill of Quantity (BOQ) dan RAB custom.
        </p>
        <button
          type="button"
          data-open-rfq
          class="shrink-0 font-bold text-red-800 hover:text-red-900 underline underline-offset-4 cursor-pointer"
        >
          Ajukan Spesifikasi Khusus di RFQ &rarr;
        </button>
      </div>
    </div>
  </section>

  <!-- 4. EDITORIAL SPLIT: LAYANAN TEKNIK & ENGINEERING (Zero Boxed Cards!) -->
  <section class="py-20 bg-white font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <!-- Left: Editorial Section Lead -->
        <div class="lg:col-span-5 space-y-4 lg:sticky lg:top-24">
          <span class="text-[11px] font-bold uppercase tracking-wider text-red-800">Layanan Teknik Terpadu</span>
          <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight leading-tight">
            Satu Rekanan untuk Seluruh Siklus Tata Udara
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            Tidak perlu membagi tanggung jawab antara toko penjualan, tukang pasang lepas, dan teknisi pembersih. ACNesia mengintegrasikan pengadaan, instalasi presisi, hingga kontrak perawatan dalam satu kontrak kerja sama profesional.
          </p>
          <div class="pt-2">
            <button
              type="button"
              data-open-rfq
              class="inline-flex items-center gap-2 py-2.5 px-5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs tracking-normal shadow-xs transition-colors cursor-pointer select-none"
            >
              <span>Ajukan Paket Layanan di RFQ</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
          </div>
        </div>

        <!-- Right: Linear Numbered Services List (Divided Rows, Zero Cards) -->
        <div class="lg:col-span-7 divide-y divide-slate-200">
          <!-- Row 1: Instalasi -->
          <div class="py-6 first:pt-0 space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-bold text-red-800">01</span>
                <h3 class="font-bold text-base text-slate-900">Instalasi Berstandar Pompa Vakum</h3>
              </div>
              <button
                type="button"
                data-rfq-add
                data-title="Jasa Instalasi & Vakum Standar Sistem"
                data-category="Layanan Teknik"
                data-capacity="Sesuai Unit"
                class="text-xs font-bold text-red-700 hover:text-red-900 cursor-pointer"
              >
                + Tambah RFQ
              </button>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed pl-7">
              Pemasangan rapi unit split, cassette 4-way, floor standing, hingga ducted. Menggunakan pipa tembaga standar tebal, mesin vakum mutlak untuk mengevakuasi udara dan uap air, serta pengukuran ampere kelistrikan sebelum serah terima.
            </p>
          </div>

          <!-- Row 2: Service & Cuci Steam -->
          <div class="py-6 space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-bold text-red-800">02</span>
                <h3 class="font-bold text-base text-slate-900">Service Berkala & Cuci Steam Bertekanan</h3>
              </div>
              <button
                type="button"
                data-rfq-add
                data-title="Service & Cuci Steam AC Rutin"
                data-category="Layanan Service"
                data-capacity="Multi-Unit"
                class="text-xs font-bold text-red-700 hover:text-red-900 cursor-pointer"
              >
                + Tambah RFQ
              </button>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed pl-7">
              Pembersihan intensif coil evaporator, blower, talang drainase, dan kondensor outdoor. Memulihkan kapasitas pendinginan, menghilangkan bau tidak sedap, dan memangkas beban kerja kompresor yang memicu lonjakan tagihan listrik.
            </p>
          </div>

          <!-- Row 3: Kontrak Maintenance -->
          <div class="py-6 space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-bold text-red-800">03</span>
                <h3 class="font-bold text-base text-slate-900">Kontrak Preventive Maintenance B2B</h3>
              </div>
              <button
                type="button"
                data-rfq-add
                data-title="Kontrak Preventive Maintenance B2B Perusahaan"
                data-category="Pemeliharaan B2B"
                data-capacity="Kontrak Berkala"
                class="text-xs font-bold text-red-700 hover:text-red-900 cursor-pointer"
              >
                + Tambah RFQ
              </button>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed pl-7">
              Perawatan terstruktur terjadwal (bulanan / 2 bulanan / kuartalan) khusus untuk gedung perkantoran, instansi, dan bisnis cabang. Dilengkapi pencatatan logsheet digital per unit, audit tekanan freon, dan prioritas emergency response.
            </p>
          </div>

          <!-- Row 4: Sewa AC Proyek -->
          <div class="py-6 last:pb-0 space-y-3">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-bold text-red-800">04</span>
                <h3 class="font-bold text-base text-slate-900">Penyewaan AC Standing & Proyek Komersial</h3>
              </div>
              <button
                type="button"
                data-rfq-add
                data-title="Paket Sewa AC Standing Komersial"
                data-category="Sewa Unit"
                data-capacity="Harian / Bulanan"
                class="text-xs font-bold text-red-700 hover:text-red-900 cursor-pointer"
              >
                + Tambah RFQ
              </button>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed pl-7">
              Penyediaan unit AC Floor Standing kapasitas 3 PK hingga 5 PK untuk event korporasi, ruang rapat sementara, pameran, atau kantor proyek lapangan. Fleksibel sistem sewa harian, mingguan, maupun kontrak bulanan.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. B2B ENGINEERING COMPARISON MATRIX (Clean Table Layout - ZERO CARDS) -->
  <section class="py-16 md:py-20 bg-slate-900 text-white font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-2 mb-10">
        <span class="text-[11px] font-bold uppercase tracking-wider text-red-400">Standar Mutu Proyek</span>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight">
          Standar Rekayasa ACNesia vs Pengadaan Biasa
        </h2>
        <p class="text-xs sm:text-sm text-slate-300">
          Perbedaan parameter teknis operasional yang menjamin ketahanan unit pendingin ruangan bisnis Anda.
        </p>
      </div>

      <!-- Comparison Table (Stripe / Apple Style) -->
      <div class="overflow-x-auto border-t border-b border-slate-800">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-slate-800 text-slate-400 font-semibold">
              <th class="py-4 pr-6 w-1/4">Parameter Kerja</th>
              <th class="py-4 px-6 w-3/8 text-slate-400">Teknisi Servis Biasa</th>
              <th class="py-4 pl-6 w-3/8 text-red-400 font-bold">Standar Rekayasa B2B ACNesia</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80 text-slate-300">
            <tr>
              <td class="py-4 pr-6 font-bold text-white">Penentuan Kapasitas PK</td>
              <td class="py-4 px-6 text-slate-400">Tebakan perkiraan luas ruangan saja</td>
              <td class="py-4 pl-6 text-slate-100 font-medium">Kalkulasi beban kalor (BTU/h) berbasis volume ruang, okupansi staf, dan perangkat elektronik.</td>
            </tr>
            <tr>
              <td class="py-4 pr-6 font-bold text-white">Prosedur Vakum Pipa</td>
              <td class="py-4 px-6 text-slate-400">Sering dilewati atau hanya *flushing freon* (buang freon)</td>
              <td class="py-4 pl-6 text-slate-100 font-medium">Wajib mesin vakum digital hingga &le; 500 micron untuk memastikan nol kelembapan udara.</td>
            </tr>
            <tr>
              <td class="py-4 pr-6 font-bold text-white">Kelengkapan Administrasi</td>
              <td class="py-4 px-6 text-slate-400">Nota kuitansi manual toko tanpa PPN</td>
              <td class="py-4 pl-6 text-slate-100 font-medium">Surat Perintah Kerja (SPK), Berita Acara Pekerjaan (BAP), invoice resmi, dan Faktur Pajak PPN.</td>
            </tr>
            <tr>
              <td class="py-4 pr-6 font-bold text-white">Uji Teknis Serah Terima</td>
              <td class="py-4 px-6 text-slate-400">Hanya cek hembusan angin dingin</td>
              <td class="py-4 pl-6 text-slate-100 font-medium">Pengukuran delta suhu intake-outlet, uji ampere kelistrikan, dan tes kemiringan drainase air.</td>
            </tr>
            <tr>
              <td class="py-4 pr-6 font-bold text-white">Perawatan Berkala</td>
              <td class="py-4 px-6 text-slate-400">Menunggu unit rusak atau bocor baru dipanggil</td>
              <td class="py-4 pl-6 text-slate-100 font-medium">Jadwal preventif terstruktur dengan logsheet performa digital dan SLA prioritas darurat.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 6. HOW IT WORKS: CONTINUOUS LINEAR WORKFLOW (Zero Detached Cards!) -->
  <section class="py-20 bg-white font-sans">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-baseline justify-between border-b border-slate-200 pb-4 mb-12">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-red-800">Alur Kerja Sistematis</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-0.5">
            Tahapan Eksekusi Pengadaan & Pemeliharaan
          </h2>
        </div>
        <span class="text-xs text-slate-400">6 Langkah Terarah</span>
      </div>

      <!-- Linear Timeline Grid (Bordered flow, not cards) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-10">
        <!-- Step 1 -->
        <div class="space-y-2 border-t-2 border-red-700 pt-3">
          <span class="font-mono text-xs font-bold text-red-700">01 / IDENTIFIKASI</span>
          <h3 class="font-bold text-sm text-slate-900">Sampaikan Rincian Kebutuhan</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Customer menginformasikan kebutuhan: unit baru, keluhan kerusakan, jadwal servis rutin kantor, atau sewa event lapangan.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="space-y-2 border-t-2 border-slate-300 pt-3">
          <span class="font-mono text-xs font-bold text-slate-500">02 / KONSULTASI</span>
          <h3 class="font-bold text-sm text-slate-900">Rekomendasi Kapasitas & Unit</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Sales engineering menghitung beban BTU/h dan merekomendasikan pilihan tipe unit (split, cassette, standing) yang paling efisien.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="space-y-2 border-t-2 border-slate-300 pt-3">
          <span class="font-mono text-xs font-bold text-slate-500">03 / SURVEY LAPANGAN</span>
          <h3 class="font-bold text-sm text-slate-900">Pemeriksaan Jalur & Panel Daya</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
