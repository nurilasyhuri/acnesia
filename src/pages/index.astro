---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/products/ProductCard.astro';
import { getLocalBusinessSchema, getWebsiteSchema } from '../utils/seo';
import { getCollection } from 'astro:content';
import { generateGeneralInquiryUrl } from '../utils/whatsapp';

const [products, articles] = await Promise.all([
  getCollection('produk'),
  getCollection('artikel'),
]);

const featuredProducts = products
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.orderPriority - b.data.orderPriority);

const localBusinessSchema = getLocalBusinessSchema();
const websiteSchema = getWebsiteSchema();
const waInquiryUrl = generateGeneralInquiryUrl('homepage-hero');

const homeKeywords = [
  'acnesia mitra bisnis indonesia',
  'pengadaan ac kantor',
  'jual ac perusahaan',
  'kontrak maintenance ac kantor',
  'preventive maintenance ac',
  'sewa ac standing',
  'service ac malang',
  'instalasi ac gedung',
  'supplier ac komersial',
];
---

<BaseLayout
  title="ACNesia — Mitra Bisnis Indonesia | Jual, Instalasi, Service & Sewa AC"
  description="Solusi satu pintu pendingin udara bisnis: pengadaan AC baru, instalasi profesional, service berkala, kontrak preventive maintenance, dan sewa AC untuk kantor, instansi, dan gedung di Indonesia."
  keywords={homeKeywords}
  jsonLd={[localBusinessSchema, websiteSchema]}
>
  <!-- 1. HERO SECTION (100% Viewport / 100dvh) -->
  <section class="relative min-h-[90vh] lg:min-h-screen flex items-center justify-center bg-slate-950 overflow-hidden font-sans pt-12 pb-20">
    <!-- Background Technical Overlay with Subtle Ambient Lighting -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero/hero-acnesia.webp"
        alt="Sistem Pendingin Ruangan Komersial ACNesia"
        width="1920"
        height="1080"
        class="w-full h-full object-cover opacity-25"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-slate-950/90"></div>
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-red-700/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-950/80 border border-red-600/30 text-red-300 text-xs font-semibold tracking-wide shadow-sm">
        <span class="w-2 h-2 rounded-full bg-red-400 animate-pulse"></span>
        <span>ACNesia • Mitra Bisnis Indonesia</span>
      </div>

      <!-- Main Headline -->
      <div class="space-y-4">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.15]">
          Semua Kebutuhan AC Bisnis,<br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 via-amber-200 to-white">
            Satu Mitra.
          </span>
        </h1>
        <p class="text-sm sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal">
          Pengadaan, instalasi, service, maintenance berkala, dan sewa AC untuk kantor, instansi, perusahaan, dan kebutuhan komersial di Indonesia.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-2">
        <a
          href="/produk/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3.5 px-7 rounded-xl bg-red-700 hover:bg-red-600 active:bg-red-800 text-white font-bold text-sm tracking-normal shadow-lg transition-all duration-200 select-none"
        >
          <span>Lihat Produk & Layanan</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>

        <a
          href="/kontak/#rfq"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3.5 px-7 rounded-xl bg-slate-900/90 hover:bg-slate-800 border border-slate-700 text-slate-200 font-semibold text-sm tracking-normal transition-all duration-200 select-none"
        >
          <span>Minta Survey & Penawaran</span>
        </a>
      </div>

      <!-- Factual Micro-Proof Badges (No Fake Numbers) -->
      <div class="pt-8 border-t border-slate-800/80 grid grid-cols-2 sm:grid-cols-5 gap-3 text-center text-xs text-slate-400 max-w-4xl mx-auto">
        <div class="p-2.5 rounded-xl bg-slate-900/50 border border-slate-800/80">
          <span class="font-bold text-white block">Pengadaan AC</span>
          <span class="text-[11px] text-slate-400">Unit Baru Bergaransi</span>
        </div>
        <div class="p-2.5 rounded-xl bg-slate-900/50 border border-slate-800/80">
          <span class="font-bold text-white block">Instalasi Rapi</span>
          <span class="text-[11px] text-slate-400">Standar Vakum Sistem</span>
        </div>
        <div class="p-2.5 rounded-xl bg-slate-900/50 border border-slate-800/80">
          <span class="font-bold text-white block">Service Rutin</span>
          <span class="text-[11px] text-slate-400">Cuci Steam & Perbaikan</span>
        </div>
        <div class="p-2.5 rounded-xl bg-slate-900/50 border border-slate-800/80">
          <span class="font-bold text-white block">Maintenance</span>
          <span class="text-[11px] text-slate-400">Kontrak Terjadwal B2B</span>
        </div>
        <div class="p-2.5 rounded-xl bg-slate-900/50 border border-slate-800/80 col-span-2 sm:col-span-1">
          <span class="font-bold text-white block">Sewa AC</span>
          <span class="text-[11px] text-slate-400">Standing & Split Proyek</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. HOMEPAGE SERVICE ARCHITECTURE (5 Pilar Layanan Utama) -->
  <section class="py-20 bg-white font-sans border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-14">
        <span class="text-xs font-bold uppercase tracking-wider text-red-800 bg-red-50 px-3 py-1 rounded-full border border-red-100">
          Layanan Komprehensif
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Solusi Seluruh Siklus Kebutuhan AC Anda
        </h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Dari pengadaan unit pertama, pemasangan teknik presisi, hingga kontrak pemeliharaan jangka panjang.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6">
        <!-- Card 1: Jual & Pengadaan -->
        <a href="/layanan/jual-pengadaan-ac/" class="group p-6 rounded-2xl bg-slate-50 hover:bg-white border border-slate-200 hover:border-red-300 hover:shadow-lg transition-all duration-300 flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-red-100 text-red-800 flex items-center justify-center font-bold text-sm">
              01
            </div>
            <h3 class="font-bold text-base text-slate-900 group-hover:text-red-800 transition-colors">
              Jual & Pengadaan AC
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Unit AC Split, Cassette, Standing, hingga Ducted untuk kebutuhan 1 unit hingga pengadaan multi-unit perusahaan.
            </p>
          </div>
          <span class="text-xs font-semibold text-red-700 group-hover:text-red-800 flex items-center gap-1">
            Lihat Pengadaan <span class="group-hover:translate-x-1 transition-transform">→</span>
          </span>
        </a>

        <!-- Card 2: Instalasi -->
        <a href="/layanan/instalasi-ac/" class="group p-6 rounded-2xl bg-slate-50 hover:bg-white border border-slate-200 hover:border-red-300 hover:shadow-lg transition-all duration-300 flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-red-100 text-red-800 flex items-center justify-center font-bold text-sm">
              02
            </div>
            <h3 class="font-bold text-base text-slate-900 group-hover:text-red-800 transition-colors">
              Instalasi AC
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Pemasangan unit baru, perapian jalur pipa, proses vakum wajib, dan relokasi AC sesuai kondisi layout gedung.
            </p>
          </div>
          <span class="text-xs font-semibold text-red-700 group-hover:text-red-800 flex items-center gap-1">
            Lihat Instalasi <span class="group-hover:translate-x-1 transition-transform">→</span>
          </span>
        </a>

        <!-- Card 3: Service -->
        <a href="/layanan/service-ac/" class="group p-6 rounded-2xl bg-slate-50 hover:bg-white border border-slate-200 hover:border-red-300 hover:shadow-lg transition-all duration-300 flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-red-100 text-red-800 flex items-center justify-center font-bold text-sm">
              03
            </div>
            <h3 class="font-bold text-base text-slate-900 group-hover:text-red-800 transition-colors">
              Service AC
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Pemeriksaan menyeluruh, cuci steam evaporator/kondensor, perbaikan kebocoran pipa, dan penggantian sparepart.
            </p>
          </div>
          <span class="text-xs font-semibold text-red-700 group-hover:text-red-800 flex items-center gap-1">
            Lihat Service <span class="group-hover:translate-x-1 transition-transform">→</span>
          </span>
        </a>

        <!-- Card 4: Maintenance -->
        <a href="/layanan/preventive-maintenance/" class="group p-6 rounded-2xl bg-slate-50 hover:bg-white border border-slate-200 hover:border-red-300 hover:shadow-lg transition-all duration-300 flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-red-100 text-red-800 flex items-center justify-center font-bold text-sm">
              04
            </div>
            <h3 class="font-bold text-base text-slate-900 group-hover:text-red-800 transition-colors">
              Maintenance AC
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Perawatan berkala terjadwal untuk menjaga efisiensi daya listrik, mendeteksi masalah lebih dini, dan merawat aset.
            </p>
          </div>
          <span class="text-xs font-semibold text-red-700 group-hover:text-red-800 flex items-center gap-1">
            Lihat Maintenance <span class="group-hover:translate-x-1 transition-transform">→</span>
          </span>
        </a>

        <!-- Card 5: Sewa AC -->
        <a href="/sewa-ac/" class="group p-6 rounded-2xl bg-slate-50 hover:bg-white border border-slate-200 hover:border-red-300 hover:shadow-lg transition-all duration-300 flex flex-col justify-between space-y-6">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-xl bg-red-100 text-red-800 flex items-center justify-center font-bold text-sm">
              05
            </div>
            <h3 class="font-bold text-base text-slate-900 group-hover:text-red-800 transition-colors">
              Sewa AC
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Penyewaan AC Standing & Split fleksibel harian, mingguan, atau bulanan untuk kantor sementara, event, dan proyek.
            </p>
          </div>
          <span class="text-xs font-semibold text-red-700 group-hover:text-red-800 flex items-center gap-1">
            Lihat Rental <span class="group-hover:translate-x-1 transition-transform">→</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. B2B SOLUTION SECTION -->
  <section class="py-20 bg-slate-900 text-white font-sans relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column -->
        <div class="lg:col-span-6 space-y-6">
          <span class="text-xs font-bold uppercase tracking-wider text-red-400 bg-slate-950/80 px-3.5 py-1 rounded-full border border-red-900/80 inline-block">
            Solusi Skala Bisnis
          </span>
          <h2 class="text-2xl sm:text-4xl font-black tracking-tight leading-tight">
            AC untuk Satu Ruangan, Satu Kantor, hingga Kebutuhan Perusahaan.
          </h2>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Konsultasikan jumlah ruangan, kebutuhan kapasitas PK, unit yang sudah tersedia, atau kebutuhan project Anda. ACNesia membantu proses dari identifikasi kebutuhan teknis hingga quotation resmi.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700/80 space-y-1">
              <span class="font-bold text-white text-sm block">Kantor & Coworking</span>
              <span class="text-xs text-slate-400 block">Suhu stabil hening, mendukung produktivitas kerja harian.</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700/80 space-y-1">
              <span class="font-bold text-white text-sm block">Perusahaan & Cabang</span>
              <span class="text-xs text-slate-400 block">Standardisasi vendor, satu pintu kontrak, dan faktur pajak.</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700/80 space-y-1">
              <span class="font-bold text-white text-sm block">Instansi & Lembaga</span>
              <span class="text-xs text-slate-400 block">Kepatuhan SPK, transparansi anggaran, & Berita Acara (BAP).</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700/80 space-y-1">
              <span class="font-bold text-white text-sm block">Gedung & Komersial</span>
              <span class="text-xs text-slate-400 block">Integrasi ducting central, cassette 4-way, & AC standing.</span>
            </div>
          </div>

          <div class="pt-4">
            <a
              href="/kontak/#rfq"
              class="inline-flex items-center gap-2 py-3 px-6 rounded-xl bg-red-700 hover:bg-red-600 text-white font-bold text-xs sm:text-sm tracking-normal shadow-md transition-colors"
            >
              <span>Konsultasi Kebutuhan AC Bisnis</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </div>

        <!-- Right Column (Visual / Key Metrics) -->
        <div class="lg:col-span-6">
          <div class="relative rounded-2xl overflow-hidden border border-slate-800 shadow-2xl bg-slate-950 p-6 sm:p-8 space-y-6">
            <h3 class="text-base sm:text-lg font-bold text-white border-b border-slate-800 pb-3">
              Karakter Layanan B2B ACNesia
            </h3>

            <div class="space-y-4 text-xs sm:text-sm text-slate-300">
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-red-950/60 text-red-400 flex items-center justify-center shrink-0 mt-0.5">
                  ✓
                </div>
                <div>
                  <strong class="text-white block">Perhitungan Beban Kalor (BTU/h) Terukur:</strong>
                  Kapasitas dihitung berbasis volume ruang dan panas elektronik, bukan tebak-tebakan.
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-red-950/60 text-red-400 flex items-center justify-center shrink-0 mt-0.5">
                  ✓
                </div>
                <div>
                  <strong class="text-white block">SOP Teknik Pendingin Standar:</strong>
                  Wajib mesin vakum, pipa tembaga tebal, dan uji ampere kelistrikan sebelum serah terima.
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-red-950/60 text-red-400 flex items-center justify-center shrink-0 mt-0.5">
                  ✓
                </div>
                <div>
                  <strong class="text-white block">Legalitas & Pembukuan Transparan:</strong>
                  Tersedia kwitansi resmi, Berita Acara Pekerjaan (BAP), dan Faktur Pajak lengkap.
                </div>
              </div>
            </div>

            <div class="p-4 rounded-xl bg-slate-950/40 border border-red-900/50 text-xs text-red-200">
              Butuh survey lokasi untuk gedung kantor Anda? Hubungi sales engineering kami untuk menjadwalkan kunjungan teknis.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. FEATURED PRODUCTS (Katalog AC Unggulan) -->
  <section class="py-20 bg-slate-50 font-sans border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div class="space-y-2">
          <span class="text-xs font-bold uppercase tracking-wider text-red-800 bg-red-50 px-3 py-1 rounded-full border border-red-100">
            Katalog Unit AC
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Pilihan Unit Pendingin Udara Komersial
          </h2>
          <p class="text-xs sm:text-sm text-slate-600">
            Tersedia unit AC Split, Cassette, Floor Standing, hingga Ducted Central bergaransi pabrik.
          </p>
        </div>

        <a
          href="/produk/"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-red-800 hover:text-red-900 transition-colors"
        >
          <span>Lihat Semua Produk</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((product) => (
          <ProductCard product={{
            title: product.data.title,
            description: product.data.description,
            category: product.data.category,
            capacity: product.data.capacity,
            priceDisplay: product.data.priceDisplay,
            stockStatus: product.data.stockStatus,
            thumbnail: product.data.thumbnail,
            slug: product.slug,
            brand: product.data.brand,
          }} />
        ))}
      </div>
    </div>
  </section>

  <!-- 5. CORPORATE MAINTENANCE SECTION -->
  <section class="py-20 bg-white font-sans border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 rounded-3xl p-8 sm:p-12 lg:p-16 text-white relative overflow-hidden shadow-xl">
        <div class="relative z-10 max-w-3xl space-y-6">
          <span class="text-xs font-bold uppercase tracking-wider text-red-400 bg-slate-950 px-3.5 py-1 rounded-full border border-red-900">
            B2B Maintenance Contract
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-tight">
            Maintenance AC Lebih Terjadwal untuk Bisnis Anda.
          </h2>
          <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
            Untuk perusahaan dengan banyak unit AC, maintenance yang terjadwal membantu pengelolaan unit menjadi lebih sistematis, menekan pemborosan daya listrik gedung, dan mencegah kerusakan mendadak di tengah jam kerja.
          </p>

          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a
              href="/layanan/kontrak-maintenance-ac/"
              class="inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl bg-red-700 hover:bg-red-600 text-white font-bold text-xs sm:text-sm tracking-normal shadow-md transition-colors"
            >
              <span>Ajukan Kontrak Maintenance</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>

            <a
              href="/kontak/#rfq"
              class="inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs sm:text-sm transition-colors border border-slate-700"
            >
              <span>Minta Proposal SLA</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. HOW IT WORKS (6 Tahap Alur Kerja Profesional) -->
  <section class="py-20 bg-slate-50 font-sans border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-14">
        <span class="text-xs font-bold uppercase tracking-wider text-red-800 bg-red-50 px-3 py-1 rounded-full border border-red-100">
          Alur Kerja Transparan
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Bagaimana ACNesia Bekerja Bersama Anda
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Tahapan sistematis dari konsultasi awal hingga dukungan purna jual.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Step 1 -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 space-y-3">
          <span class="text-xs font-black text-red-700 tracking-wider">01 — SAMPAIKAN KEBUTUHAN</span>
          <h3 class="font-bold text-sm text-slate-900">Deskripsikan Kebutuhan AC</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Customer menjelaskan tipe kebutuhan: pengadaan unit baru, kendala perbaikan, rencana jadwal perawatan rutin, atau sewa event.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 space-y-3">
          <span class="text-xs font-black text-red-700 tracking-wider">02 — KONSULTASI TEKNIS</span>
          <h3 class="font-bold text-sm text-slate-900">Identifikasi & Rekomendasi</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Tim sales engineering mengidentifikasi kapasitas PK, tipe unit yang tepat, dan estimasi beban pendinginan ruangan.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 space-y-3">
          <span class="text-xs font-black text-red-700 tracking-wider">03 — SURVEY JIKA DIPERLUKAN</span>
          <h3 class="font-bold text-sm text-slate-900">Pemeriksaan Lapangan</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Survey lokasi dilakukan untuk proyek multi-unit, memeriksa jalur instalasi pipa, rute drainase, dan kapasitas daya listrik.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 space-y-3">
          <span class="text-xs font-black text-red-700 tracking-wider">04 — QUOTATION & RAB</span>
          <h3 class="font-bold text-sm text-slate-900">Penawaran Transparan</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Penerbitan proposal penawaran resmi mencakup spesifikasi komponen, biaya material bantu, ongkos jasa, dan term of payment.
          </p>
        </div>

        <!-- Step 5 -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 space-y-3">
          <span class="text-xs font-black text-red-700 tracking-wider">05 — PELAKSANAAN KERJA</span>
          <h3 class="font-bold text-sm text-slate-900">Eksekusi Berstandar SOP</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Teknisi bersertifikat melaksanakan instalasi dengan standar vakum, service bersih, atau pengantaran unit sewa tepat waktu.
          </p>
        </div>

        <!-- Step 6 -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 space-y-3">
          <span class="text-xs font-black text-red-700 tracking-wider">06 — AFTER-SALES SUPPORT</span>
          <h3 class="font-bold text-sm text-slate-900">Garansi & Follow-Up</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Dukungan purna jual, klaim garansi instalasi pipa, Berita Acara Pekerjaan (BAP), dan monitoring siklus servis berkala.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. KNOWLEDGE HUB / ARTIKEL TEKNIS -->
  <section class="py-20 bg-white font-sans border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div class="space-y-2">
          <span class="text-xs font-bold uppercase tracking-wider text-red-800 bg-red-50 px-3 py-1 rounded-full border border-red-100">
            Knowledge Hub
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Panduan & Artikel Teknik AC
          </h2>
          <p class="text-xs sm:text-sm text-slate-600">
            Wawasan seputar perhitungan PK, efisiensi energi, dan manajemen perawatan AC kantor.
          </p>
        </div>

        <a
          href="/artikel/"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-red-800 hover:text-red-900 transition-colors"
        >
          <span>Lihat Semua Panduan</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {articles.slice(0, 4).map((a) => (
          <a href={`/artikel/${a.slug}/`} class="group flex flex-col justify-between rounded-2xl bg-slate-50 hover:bg-white border border-slate-200 hover:border-red-300 hover:shadow-lg transition-all duration-300 overflow-hidden">
            <div>
              <div class="aspect-16/10 overflow-hidden bg-slate-200">
                <img
                  src={a.data.heroImage}
                  alt={a.data.title}
                  width="500"
                  height="300"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-5 space-y-2">
                <span class="text-[10px] font-bold uppercase tracking-wider text-red-800">
                  {a.data.category}
                </span>
                <h3 class="font-bold text-sm text-slate-900 group-hover:text-red-800 transition-colors line-clamp-2 leading-snug">
                  {a.data.title}
                </h3>
                <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                  {a.data.description}
                </p>
              </div>
            </div>
            <div class="p-5 pt-0 text-[11px] text-slate-400">
              {a.data.publishDate}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. FINAL CTA SECTION (RFQ Form Link) -->
  <section class="py-20 bg-slate-950 text-white font-sans relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 relative z-10">
      <span class="text-xs font-bold uppercase tracking-wider text-red-400 bg-slate-950 px-3.5 py-1 rounded-full border border-red-900">
        Konsultasi Bebas Biaya Awal
      </span>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight">
        Siap Meningkatkan Efisiensi AC Bisnis Anda?
      </h2>
      <p class="text-sm sm:text-base text-slate-300 max-w-xl mx-auto leading-relaxed">
        Sampaikan kebutuhan pengadaan unit baru, kendala perbaikan, atau permintaan kontrak maintenance berkala kepada tim kami.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/kontak/#rfq"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3.5 px-8 rounded-xl bg-red-700 hover:bg-red-600 text-white font-bold text-sm tracking-normal shadow-lg transition-colors"
        >
          <span>Ajukan Permintaan Penawaran (RFQ)</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>

        <a
          href={waInquiryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3.5 px-8 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-200 font-semibold text-sm transition-colors"
        >
          <span>Chat Sales WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
