      <!-- Hairline Divided Accordion (Apple / Stripe style) -->
      <div class="divide-y divide-slate-200" id="faq-accordion">
        <details class="group py-4.5 [&_summary::-webkit-details-marker]:hidden cursor-pointer">
          <summary class="flex items-center justify-between font-bold text-sm text-slate-900">
            <span>Apakah ACNesia dapat menerbitkan Faktur Pajak & dokumen BAP resmi?</span>
