          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. KNOWLEDGE HUB / ARTIKEL TEKNIS (Editorial Broadsheet Layout) -->
  <section class="py-16 bg-slate-50 font-sans">
