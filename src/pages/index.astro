---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalBusinessSchema, getWebsiteSchema } from '../utils/seo';
import { generateGeneralInquiryUrl } from '../utils/whatsapp';

const localBusinessSchema = getLocalBusinessSchema();
const websiteSchema = getWebsiteSchema();
const waInquiryUrl = generateGeneralInquiryUrl('homepage-consultation-cta');

const homeKeywords = [
  'jual ac baru dan bekas b2b',
  'pengadaan ac kantor dan gedung',
  'sewa ac standing dan genset',
  'rental ac standing malang surabaya',
  'sewa genset silent proyek event',
  'instalasi ac pipa vakum digital',
  'kontrak service ac gedung amc',
  'jual beli borongan ac bekas kantor',
];

const mainServices = [
  {
    title: 'Jual AC Baru & Bekas B2B',
    desc: 'Pengadaan AC baru bergaransi resmi, unit rekondisi lolos QC, dan beli borongan AC bekas kantor.',
    href: '/pengadaan-ac/',
    image: '/images/services/pengadaan-ac-kantor.webp',
    alt: 'Pengadaan dan jual beli unit AC Split, Cassette, dan Standing baru maupun bekas rekondisi bergaransi B2B',
  },
  {
    title: 'Sewa AC Standing & Genset',
    desc: 'Rental AC Floor Standing 3 PK hingga 10 PK beserta paket Genset Silent untuk event dan proyek.',
    href: '/sewa-ac/',
    image: '/images/services/sewa-ac-standing.webp',
    alt: 'Layanan sewa AC Floor Standing 3 PK hingga 10 PK dan paket Genset Silent untuk event korporat serta proyek gedung',
  },
  {
    title: 'Instalasi Vakum & Kontrak AMC',
    desc: 'Pemasangan pipa tembaga ASTM 0.8mm dengan vakum digital 500 micron dan kontrak servis berkala.',
    href: '/layanan/instalasi-ac/',
    image: '/images/services/instalasi-ac-profesional.webp',
    alt: 'Teknisi instalasi pipa tembaga ASTM dan vakum digital serta kontrak maintenance AC tahunan',
  },
];

const workflowSteps = [
  {
    num: '01',
    title: 'Konsultasi Kebutuhan',
    desc: 'Estimasi kapasitas PK & BTU ruangan via kalkulator atau survei lokasi.',
  },
  {
    num: '02',
    title: 'Penawaran SPH Resmi',
    desc: 'Rincian BOQ & SPH resmi lengkap dengan SPK serta e-Faktur PPN.',
  },
  {
    num: '03',
    title: 'Pengiriman Same-Day',
    desc: 'Armada kirim unit & tim teknisi langsung dari workshop terdekat.',
  },
  {
    num: '04',
    title: 'Siap Pakai & Garansi',
    desc: 'Lolos uji vakum 500 micron, suhu dingin & garansi kerja resmi.',
  },
];

const catalogProducts = [
  {
    title: 'Set AC Split Standard 0.5 – 1 PK',
    priceDisplay: 'Rp 2.850.000',
    unit: '/ unit',
    href: '/produk/ac-split-wall-mounted/',
    image: '/images/products/ac-split-wall-mounted.webp',
    alt: 'Unit AC Split Wall Mounted 0.5 PK dan 1 PK R32 untuk ruang kerja kantor',
  },
  {
    title: 'Set AC Split Inverter R32 1 – 2 PK',
    priceDisplay: 'Rp 4.350.000',
    unit: '/ unit',
    href: '/produk/ac-split-inverter-hemat-listrik/',
    image: '/images/services/ac-split-vs-cassette.webp',
    alt: 'Unit AC Split Inverter R32 hemat listrik untuk operasional kantor harian',
  },
  {
    title: 'AC Ceiling Cassette 4-Way 2 – 5 PK',
    priceDisplay: 'Rp 11.800.000',
    unit: '/ unit',
    href: '/produk/ac-cassette-4-way/',
    image: '/images/products/ac-cassette-4-way.webp',
    alt: 'Unit AC Ceiling Cassette 4-Way hembusan 360 derajat untuk ruang rapat gedung',
  },
  {
    title: 'AC Floor Standing 3 PK & 5 PK',
    priceDisplay: 'Rp 14.500.000',
    unit: '/ unit',
    href: '/produk/ac-floor-standing-commercial/',
    image: '/images/products/ac-floor-standing.webp',
    alt: 'Unit AC Floor Standing komersial kapasitas 3 PK dan 5 PK untuk hall dan aula',
  },
  {
    title: 'Sewa AC Standing 3 – 5 PK Lengkap',
    priceDisplay: 'Rp 650.000',
    unit: '/ hari',
    href: '/produk/paket-sewa-ac-standing-harian-bulanan/',
    image: '/images/services/sewa-ac-standing.webp',
    alt: 'Paket sewa AC Floor Standing 3 PK dan 5 PK harian maupun bulanan termasuk kabel',
  },
  {
    title: 'Paket Pasang Pipa ASTM + Vakum',
    priceDisplay: 'Rp 750.000',
    unit: '/ titik',
    href: '/produk/paket-pasang-ac-pipa-vakum/',
    image: '/images/services/instalasi-ac-profesional.webp',
    alt: 'Paket instalasi AC pipa tembaga 3 meter ketebalan 0.8mm dan vakum digital',
  },
];

const projectDocs = [
  {
    tag: 'Malang Pusat',
    title: 'Instalasi AC Cassette Ruang Rapat Gedung',
    image: '/images/services/ac-gedung-solusi.webp',
    alt: 'Dokumentasi instalasi AC Ceiling Cassette 4-Way pada plafon gedung bertingkat',
    href: '/solusi/ac-gedung/',
  },
  {
    tag: 'Workshop Buring',
    title: 'Pusat Stok Unit AC Baru & Rekondisi QC',
    image: '/images/services/pengadaan-ac-kantor.webp',
    alt: 'Stok unit AC Split, Cassette, dan Floor Standing di gudang utama Sentra AC',
    href: '/pengadaan-ac/',
  },
  {
    tag: 'Kawasan Industri PIER',
    title: 'Kontrak Preventive Maintenance Pabrik',
    image: '/images/services/ac-perusahaan-solusi.webp',
    alt: 'Pemeliharaan berkala sistem pendingin ruangan kantor dan fasilitas industri',
    href: '/solusi/ac-perusahaan/',
  },
  {
    tag: 'Komersial & Ritel',
    title: 'Pemasangan Jalur Pipa Tembaga & Vakum',
    image: '/images/services/instalasi-ac-profesional.webp',
    alt: 'Pekerjaan pemipaan tembaga ASTM dan pemvakuman digital di area komersial',
    href: '/layanan/instalasi-ac/',
  },
  {
    tag: 'Instansi & Kampus',
    title: 'Pengadaan AC Ruang Kuliah & Laboratorium',
    image: '/images/services/ac-instansi-solusi.webp',
    alt: 'Pengadaan dan pemasangan unit AC untuk gedung kampus dan instansi pemerintah',
    href: '/solusi/ac-instansi/',
  },
  {
    tag: 'Perkantoran Surabaya',
    title: 'Cuci Steam Hydro-Wash Terjadwal Bulanan',
    image: '/images/services/kapan-cuci-ac-kantor.webp',
    alt: 'Proses cuci steam evaporator dan kondensor AC kantor tanpa mengganggu kerja',
    href: '/layanan/preventive-maintenance/',
  },
  {
    tag: 'Event & Exhibition',
    title: 'Sewa AC Standing 5 PK Acara Korporat',
    image: '/images/services/sewa-ac-standing.webp',
    alt: 'Penempatan unit sewa AC Floor Standing 5 PK untuk kebutuhan event dan pameran',
    href: '/sewa-ac/',
  },
  {
    tag: 'Likuidasi Aset Kantor',
    title: 'Tukar Tambah & Borongan AC Bekas Kantor',
    image: '/images/services/jual-beli-ac-bekas.webp',
    alt: 'Pembongkaran dan penaksiran unit AC bekas kantor secara borongan oleh tim Sentra AC',
    href: '/layanan/jual-beli-ac-bekas/',
  },
  {
    tag: 'Gedung Komersial',
    title: 'Sistem AC Ceiling Ducted & Tata Udara',
    image: '/images/products/ac-ceiling-ducted.webp',
    alt: 'Instalasi unit AC Ceiling Ducted berkapasitas besar untuk gedung komersial',
    href: '/produk/ac-commercial/',
  },
];
---

<BaseLayout
  title="Jual AC Baru & Bekas, Sewa AC & Genset B2B Jawa Timur - Sentra AC"
  description="Pusat jual beli AC baru dan bekas B2B, sewa AC standing & genset silent, serta instalasi vakum 0.8mm di Malang, Surabaya & Sidoarjo ber-eFaktur."
  keywords={homeKeywords}
  jsonLd={[localBusinessSchema, websiteSchema]}
>
  <!-- SECTION 1: DARK FULL-BLEED INDUSTRIAL HERO -->
  <section class="relative bg-[#020617] text-white h-[844px] md:h-[900px] flex flex-col justify-between overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero/hero-sentraac.webp"
        alt="Teknisi Sentra AC melakukan instalasi dan pengecekan unit AC komersial gedung"
        width="1440"
        height="900"
        class="w-full h-full object-cover object-center opacity-45"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#020617] via-[#020617]/90 to-[#020617]/35"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#020617] via-transparent to-[#020617]/50"></div>
    </div>

    <div class="relative z-10 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-12 sm:pt-16 lg:pt-24 pb-6 flex-1 flex flex-col justify-center">
      <div class="max-w-2xl space-y-5">
        <p class="text-xs sm:text-sm font-semibold text-[#fb923c]">
          Malang Raya, Surabaya, Sidoarjo &amp; Pasuruan
        </p>

        <h1 class="text-[30px] leading-[34px] tracking-[-0.75px] md:text-[48px] md:leading-[50px] md:tracking-[-1.2px] lg:text-[56px] lg:leading-[60px] lg:tracking-[-1.4px] font-bold text-white">
          Jual AC Baru &amp; Bekas, Sewa AC &amp; Genset B2B
        </h1>

        <p class="text-[14px] leading-[22.75px] md:text-[16px] md:leading-[24px] text-slate-300 max-w-xl font-normal">
          Pusat pengadaan jual beli AC baru dan bekas bergaransi, sewa AC standing &amp; paket genset silent, serta instalasi pipa ASTM 0.8mm di Malang Raya, Surabaya, dan Sidoarjo. Ratusan unit siap kirim same-day lengkap e-Faktur PPN.
        </p>

        <div class="pt-2">
          <button
            type="button"
            data-open-rfq
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-[#c2410c] hover:bg-[#ea580c] text-white text-xs sm:text-sm font-semibold transition-colors cursor-pointer"
          >
            Minta SPH
          </button>
        </div>
      </div>
    </div>

    <!-- Bottom Hero 4-Metric Technical Spec Strip -->
    <div class="relative z-10 border-t border-white/10 bg-[#020617]/75 backdrop-blur-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 lg:py-7">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-10 lg:gap-14">
          <div>
            <div class="text-xl sm:text-2xl font-bold text-white leading-none">
              0.8 <span class="text-xs font-semibold text-[#fb923c]">mm</span>
            </div>
            <div class="text-[11px] text-slate-400 mt-1">Pipa Tembaga ASTM</div>
          </div>

          <div>
            <div class="text-xl sm:text-2xl font-bold text-white leading-none">
              500 <span class="text-xs font-semibold text-emerald-400">Micron</span>
            </div>
            <div class="text-[11px] text-slate-400 mt-1">Vakum Digital Wajib</div>
          </div>

          <div>
            <div class="text-xl sm:text-2xl font-bold text-white leading-none">
              2 <span class="text-xs font-semibold text-slate-300">Hub</span>
            </div>
            <div class="text-[11px] text-slate-400 mt-1">Malang &amp; Surabaya-Sidoarjo</div>
          </div>

          <div>
            <div class="text-xl sm:text-2xl font-bold text-white leading-none">
              R32 / R410A
            </div>
            <div class="text-[11px] text-slate-400 mt-1">Standar K3 &amp; e-Faktur</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: LAYANAN UTAMA + ALUR LAYANAN -->
  <section class="bg-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 lg:space-y-20">
      <div class="space-y-8">
        <h2 class="text-[24px] leading-[32px] tracking-[-0.6px] md:text-[30px] md:leading-[36px] md:tracking-[-0.75px] lg:text-[36px] lg:leading-[40px] lg:tracking-[-0.9px] font-bold text-slate-950">
          Layanan Tata Udara &amp; HVAC
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {mainServices.map((srv) => (
            <a href={srv.href} class="group block space-y-3.5">
              <div class="aspect-4/3 rounded-2xl overflow-hidden bg-slate-100">
                <img
                  src={srv.image}
                  alt={srv.alt}
                  width="480"
                  height="360"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <div class="space-y-1">
                <h3 class="text-[16px] leading-[24px] md:text-[18px] md:leading-[28px] font-bold text-slate-950 group-hover:text-[#c2410c] transition-colors">
                  {srv.title}
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  {srv.desc}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Part B: Alur Kerja -->
      <div class="space-y-6">
        <h3 class="text-[20px] leading-[28px] md:text-[24px] md:leading-[32px] font-bold text-slate-950">
          Alur Layanan Proyek B2B
        </h3>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          {workflowSteps.map((step) => (
            <div class="rounded-2xl bg-slate-50 border border-slate-100 p-5 sm:p-6 space-y-2">
              <span class="block text-lg sm:text-xl font-bold text-[#c2410c]">{step.num}</span>
              <h4 class="text-xs sm:text-sm font-bold text-slate-950">
                {step.title}
              </h4>
              <p class="text-xs text-slate-600 leading-relaxed">
                {step.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: REFERENSI UNIT & PAKET STANDAR (3x2 CLEAN SHOWCASE) -->
  <section id="katalog-produk" class="bg-slate-50 py-14 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10 md:space-y-14">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <h2 class="text-[24px] leading-[32px] tracking-[-0.6px] md:text-[30px] md:leading-[36px] md:tracking-[-0.75px] lg:text-[36px] lg:leading-[40px] lg:tracking-[-0.9px] font-bold text-slate-950">
          Unit AC &amp; Paket Standar ASTM 0.8mm
        </h2>
        <a href="/produk/" class="text-xs sm:text-sm font-semibold text-[#c2410c] hover:underline underline-offset-4">
          Lihat Semua Katalog
        </a>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-3 gap-x-5 sm:gap-x-10 gap-y-10 md:gap-y-14">
        {catalogProducts.map((item) => (
          <a
            href={item.href}
            class="group flex flex-col items-center text-center space-y-3 md:space-y-4"
          >
            <div class="w-full aspect-square max-w-[160px] md:max-w-[260px] mx-auto rounded-2xl overflow-hidden bg-white border border-slate-200/80 p-2.5 md:p-4 flex items-center justify-center">
              <img
                src={item.image}
                alt={item.alt}
                width="320"
                height="320"
                class="w-full h-full object-cover rounded-xl group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="space-y-1">
              <h3 class="text-xs sm:text-sm font-bold text-slate-950 group-hover:text-[#c2410c] transition-colors">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-500">
                <strong class="font-bold text-slate-950">{item.priceDisplay}</strong>{' '}
                <span class="text-slate-400 text-xs">{item.unit}</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 4: DOKUMENTASI PROYEK & CAKUPAN SEKTOR -->
  <section class="bg-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 lg:space-y-10">
      <h2 class="text-[24px] leading-[32px] tracking-[-0.6px] md:text-[30px] md:leading-[36px] md:tracking-[-0.75px] lg:text-[36px] lg:leading-[40px] lg:tracking-[-0.9px] font-bold text-slate-950">
        Dokumentasi Layanan &amp; Sektor
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
        {projectDocs.map((doc) => (
          <a
            href={doc.href}
            class="group relative aspect-16/10 rounded-2xl overflow-hidden bg-[#020617] block"
          >
            <img
              src={doc.image}
              alt={doc.alt}
              width="440"
              height="275"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 opacity-85"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#020617]/95 via-[#020617]/35 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5 space-y-1">
              <span class="block text-xs font-medium text-[#fb923c]">
                {doc.tag}
              </span>
              <h3 class="text-sm sm:text-base font-bold text-white leading-snug">
                {doc.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 5: STANDAR KESELAMATAN & TEKNIS INSTALASI -->
  <section class="bg-[#020617] text-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <div class="lg:col-span-6 space-y-6">
          <h2 class="text-[24px] leading-[32px] tracking-[-0.6px] md:text-[30px] md:leading-[36px] md:tracking-[-0.75px] lg:text-[36px] lg:leading-[40px] lg:tracking-[-0.9px] font-bold text-white">
            Standar Keselamatan &amp; Kualitas Instalasi AC
          </h2>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Setiap titik instalasi dan perawatan unit dijalankan mengikuti prosedur operasional terukur untuk mencegah kebocoran refrigeran serta menjaga usia kompresor.
          </p>

          <div class="divide-y divide-white/10 border-y border-white/10">
            <div class="py-4 space-y-1">
              <h3 class="text-xs sm:text-sm font-bold text-[#fb923c]">
                Pipa Tembaga 0.8mm ASTM
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                Tembaga seamless tahan tekanan tinggi R32 &amp; R410A dengan insulasi closed-cell anti-kondensasi.
              </p>
            </div>

            <div class="py-4 space-y-1">
              <h3 class="text-xs sm:text-sm font-bold text-[#fb923c]">
                Vakum Digital ≤ 500 Micron
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                Wajib pompa vakum dua tahap &amp; manifold gauge digital sebelum sirkulasi refrigeran dibuka.
              </p>
            </div>

            <div class="py-4 space-y-1">
              <h3 class="text-xs sm:text-sm font-bold text-[#fb923c]">
                Protokol Kartu QC &amp; BAST
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed">
                Pencatatan tekanan PSI, arus Ampere, dan suhu hembusan tiap unit pada Berita Acara Serah Terima.
              </p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 space-y-5">
          <div class="rounded-2xl overflow-hidden bg-white/[0.02] aspect-16/9">
            <img
              src="/images/services/preventive-maintenance-ac.webp"
              alt="Teknisi bersertifikat melakukan pengukuran tekanan manifold dan vakum digital"
              width="640"
              height="360"
              class="w-full h-full object-cover opacity-90"
              loading="lazy"
            />
          </div>

          <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs">
            <div class="space-y-1">
              <dt class="font-bold text-white">Permenaker No. 5/2018</dt>
              <dd class="text-slate-400 leading-relaxed">Kepatuhan K3 lingkungan kerja &amp; tata udara gedung.</dd>
            </div>
            <div class="space-y-1">
              <dt class="font-bold text-white">ASTM B280 &amp; JIS H3300</dt>
              <dd class="text-slate-400 leading-relaxed">Spesifikasi pipa tembaga seamless tekanan tinggi.</dd>
            </div>
            <div class="space-y-1">
              <dt class="font-bold text-white">Dokumentasi BAST</dt>
              <dd class="text-slate-400 leading-relaxed">Pelabelan riwayat servis &amp; uji kelayakan unit.</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 6: FASILITAS FISIK / WORKSHOP MALANG & HUB SURABAYA-SIDOARJO -->
  <section class="bg-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <h2 class="text-[24px] leading-[32px] tracking-[-0.6px] md:text-[30px] md:leading-[36px] md:tracking-[-0.75px] lg:text-[36px] lg:leading-[40px] lg:tracking-[-0.9px] font-bold text-slate-950">
        Workshop Malang &amp; Hub Surabaya Sidoarjo
      </h2>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div class="aspect-16/10 rounded-2xl overflow-hidden bg-slate-100">
            <img
              src="/images/services/ac-kantor-solusi.webp"
              alt="Fasilitas workshop dan gudang stok unit AC Sentra AC di Kedungkandang Kota Malang"
              width="600"
              height="375"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <div class="space-y-1.5">
            <h3 class="text-[16px] leading-[24px] md:text-[18px] md:leading-[28px] font-bold text-slate-950">
              Workshop Malang (Kedungkandang)
            </h3>
            <p class="text-xs text-slate-700 font-medium">
              Jl. KH Malik Dalam, Buring, Kedungkandang, Kota Malang 65136
            </p>
            <p class="text-xs text-slate-500 leading-relaxed">
              Jangkauan: Kota Malang, Lowokwaru, Blimbing, Klojen, Sukun, Kota Batu, Singosari, Lawang &amp; Kepanjen.
            </p>
          </div>
        </div>

        <div class="space-y-4">
          <div class="aspect-16/10 rounded-2xl overflow-hidden bg-slate-100">
            <img
              src="/images/services/kontrak-maintenance-perusahaan.webp"
              alt="Armada operasional layanan proyek pengadaan dan sewa AC wilayah Surabaya dan Sidoarjo"
              width="600"
              height="375"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <div class="space-y-1.5">
            <h3 class="text-[16px] leading-[24px] md:text-[18px] md:leading-[28px] font-bold text-slate-950">
              Hub Proyek Surabaya &amp; Sidoarjo (Waru – Rungkut)
            </h3>
            <p class="text-xs text-slate-700 font-medium">
              Koridor Logistik Waru – Rungkut Industri, Sidoarjo &amp; Surabaya, Jawa Timur
            </p>
            <p class="text-xs text-slate-500 leading-relaxed">
              Jangkauan: Surabaya Pusat/Timur, Rungkut SIER, Sidoarjo, Gedangan, Pasuruan PIER, Pandaan &amp; Gresik.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 7: KONSULTASI KAPASITAS PK & ESTIMASI PROYEK -->
  <section id="kalkulator-pk" class="bg-slate-50 py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden bg-slate-100 aspect-4/5 max-w-md mx-auto lg:max-w-none">
            <img
              src="/images/services/hitung-pk-ac-kantor.webp"
              alt="Tim konsultan dan estimator teknis HVAC Sentra AC siap menghitung kebutuhan PK ruangan"
              width="480"
              height="600"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-2">
            <h2 class="text-[24px] leading-[32px] tracking-[-0.6px] md:text-[30px] md:leading-[36px] md:tracking-[-0.75px] lg:text-[36px] lg:leading-[40px] lg:tracking-[-0.9px] font-bold text-slate-950">
              Kalkulator Kapasitas PK &amp; Estimasi Proyek
            </h2>
            <p class="text-[14px] leading-[22.75px] md:text-[16px] md:leading-[24px] text-slate-600">
              Hitung perkiraan beban BTU/PK ruangan di bawah ini sebelum mengajukan Surat Penawaran Harga (SPH) atau penjadwalan survei lokasi.
            </p>
          </div>

          <div class="rounded-2xl bg-white border border-slate-200/80 p-5 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <span class="text-xs font-bold text-slate-900">
                Kalkulator Kebutuhan PK Ruangan
              </span>
              <span id="pk-calc-btu" class="text-xs font-semibold text-[#c2410c]">
                Estimasi: ~11.700 BTU/h — Rekomendasi AC Split 1.5 PK (Rp 4.850.000)
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="calc-area" class="block text-[11px] font-semibold text-slate-600 mb-1">
                  Luas Ruangan (m²)
                </label>
                <input
                  id="calc-area"
                  type="number"
                  min="6"
                  max="500"
                  value="18"
                  class="w-full px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 text-slate-950 font-semibold text-xs"
                />
              </div>

              <div>
                <label for="calc-room-type" class="block text-[11px] font-semibold text-slate-600 mb-1">
                  Fungsi Ruangan
                </label>
                <select
                  id="calc-room-type"
                  class="w-full px-3.5 py-2 rounded-xl bg-slate-50 border border-slate-200 text-slate-950 font-semibold text-xs"
                >
                  <option value="650" selected>Ruang Kerja Kantor (650 BTU/m²)</option>
                  <option value="750">Ruang Rapat / Aula (750 BTU/m²)</option>
                  <option value="850">Ruang Server / Komersial (850 BTU/m²)</option>
                  <option value="550">Kamar / Ruang Privat (550 BTU/m²)</option>
                </select>
              </div>
            </div>
          </div>

          <ul class="space-y-2 text-xs sm:text-sm text-slate-600 list-disc pl-4">
            <li>Gratis perhitungan kapasitas PK &amp; Bill of Quantity (BOQ) presisi.</li>
            <li>Pengiriman &amp; instalasi terjadwal ke Malang Raya, Surabaya, Sidoarjo, dan Pasuruan.</li>
            <li>Dokumen administrasi korporat lengkap: SPH, SPK, BAST, dan e-Faktur PPN.</li>
          </ul>

          <div class="pt-1">
            <a
              href={waInquiryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-slate-300 bg-white hover:bg-slate-100 text-slate-800 text-xs sm:text-sm font-semibold transition-colors"
            >
              <span>Konsultasi via WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const areaInput = document.getElementById('calc-area') as HTMLInputElement | null;
  const typeSelect = document.getElementById('calc-room-type') as HTMLSelectElement | null;
  const btuLabel = document.getElementById('pk-calc-btu');

  function updateCalculator() {
    const area = Math.max(4, Number(areaInput?.value || 18));
    const factor = Number(typeSelect?.value || 650);
    const btu = Math.round(area * factor);

    let pkLabel = 'AC 1/2 PK';
    let recDisplay = 'Rp 2.850.000';

    if (btu <= 5500) {
      pkLabel = 'AC Split 1/2 PK';
      recDisplay = 'Rp 2.850.000';
    } else if (btu <= 9500) {
      pkLabel = 'AC Split 1 PK';
      recDisplay = 'Rp 3.450.000';
    } else if (btu <= 13500) {
      pkLabel = 'AC Split 1.5 PK';
      recDisplay = 'Rp 4.850.000';
    } else if (btu <= 18500) {
      pkLabel = 'AC Split 2 PK';
      recDisplay = 'Rp 6.650.000';
    } else if (btu <= 28000) {
      pkLabel = 'AC Cassette / Standing 3 PK';
      recDisplay = 'Rp 14.500.000';
    } else {
      pkLabel = 'AC Standing / Cassette 5 PK';
      recDisplay = 'Rp 19.800.000';
    }

    if (btuLabel) {
      btuLabel.textContent = `Estimasi: ~${btu.toLocaleString('id-ID')} BTU/h — Rekomendasi ${pkLabel} (${recDisplay})`;
    }
  }

  areaInput?.addEventListener('input', updateCalculator);
  typeSelect?.addEventListener('change', updateCalculator);
</script>
