        <a
          href={waInquiryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3.5 px-8 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-200 font-semibold text-sm transition-colors select-none"
        >
          <svg class="w-4 h-4 text-emerald-400 fill-current" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
          </svg>
          <span>Konsultasi Proyek (WhatsApp)</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Tab filtering logic for Homepage Products Catalog
  const tabButtons = document.querySelectorAll('.home-tab-btn');
  const productWrappers = document.querySelectorAll('.product-item-wrap');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-filter-tab');
      tabButtons.forEach((b) => {
        b.classList.remove('bg-slate-900', 'text-white');
        b.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      });
      btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      btn.classList.add('bg-slate-900', 'text-white');

      productWrappers.forEach((wrap) => {
        const itemCat = wrap.getAttribute('data-product-category');
        if (category === 'all' || itemCat === category) {
          (wrap as HTMLElement).style.display = 'block';
        } else {
          (wrap as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
