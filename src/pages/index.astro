    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-2 pb-6 border-b border-slate-200 mb-6">
        <span class="text-[11px] font-bold uppercase tracking-wider text-red-800">Tanya Jawab</span>
