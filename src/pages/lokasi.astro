---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { BUSINESS_INFO } from '../data/businessInfo';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../utils/seo';
import { generateGeneralInquiryUrl } from '../utils/whatsapp';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Area Layanan & Lokasi', url: '/lokasi/' },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const waUrl = generateGeneralInquiryUrl('lokasi-page');

const malangAreas = [
  {
    name: 'Kecamatan Kedungkandang',
    coverage: 'Buring, Sawojajar, Mergosono, Kotalama, Bumiayu, Arjowinangun, Tlogowaru, Wonokoyo.',
    highlight: 'Area Workshop & Kantor Utama Sentra AC — Respon Tercepat',
  },
  {
    name: 'Kecamatan Klojen (Pusat Bisnis)',
    coverage: 'Klojen, Oro-oro Dowo, Kauman, Kiduldalem, Sukoharjo, Kasin, Rampal Celaket, Samaan.',
    highlight: 'Sentra perkantoran perbankan, instansi pemerintah, dan hotel pusat kota',
  },
  {
    name: 'Kecamatan Lowokwaru',
    coverage: 'Soekarno-Hatta (Suhat), Dinoyo, Tulusrejo, Mojolangu, Jatimulyo, Tunggulwulung, Tasikmadu.',
    highlight: 'Kawasan kampus, kafe, coworking space, dan ruko komersial modern',
  },
  {
    name: 'Kecamatan Blimbing',
    coverage: 'Blimbing, Purwantoro, Bunulrejo, Pandanwangi, Purwodadi, Arjosari, Polowijen, Balearjosari.',
    highlight: 'Kawasan industri, pergudangan, perumahan Araya, dan akses tol Malang-Pandaan',
  },
  {
    name: 'Kecamatan Sukun',
    coverage: 'Sukun, Tanjungrejo, Bandulan, Pisangcandi, Karangbesuki, Mulyorejo, Bakalan Krajan, Gadang.',
    highlight: 'Fasilitas kesehatan, pabrik, pertokoan, dan kawasan komersial',
  },
  {
    name: 'Kota Wisata Batu & Sekitarnya',
    coverage: 'Batu, Bumiaji, Junrejo, Songgokerto, Sisir, Oro-oro Ombo, Sidomulyo.',
    highlight: 'Layanan spesialis AC hotel, villa, resort, restoran, dan wahana wisata',
  },
  {
    name: 'Kabupaten Malang (Singosari - Kepanjen)',
    coverage: 'Singosari, Lawang, Karangploso, Pakis, Dau, Wagir, Pakisaji, Kepanjen, Dampit, Turen.',
    highlight: 'Pabrik industri manufaktur, kantor cabang BUMN, dan pergudangan logistik',
  },
  {
    name: 'Surabaya & Sidoarjo (Koridor Utara)',
    coverage: 'Waru, Gedangan, Rungkut SIER, Surabaya Pusat, Surabaya Timur, Pasuruan PIER, Pandaan.',
    highlight: 'Hub layanan proyek pengadaan, instalasi gedung, dan sewa AC standing B2B',
  },
];
---

<BaseLayout
  title="Area Layanan Service, Pasang, Sewa & Jual AC Malang Surabaya - Sentra AC"
  description="Jangkauan layanan jual beli AC baru/bekas, sewa AC standing, pasang, cuci, dan service AC panggilan Sentra AC di Malang Raya, Surabaya, dan Sidoarjo."
  canonical={ensureAbsoluteUrl('/lokasi/')}
  jsonLd={breadcrumbSchema}
  keywords={[
    'area layanan sentra ac',
    'service ac kedungkandang malang',
    'service ac sawojajar suhat',
    'teknisi ac batu malang',
    'service ac kepanjen singosari',
    'sentra ac malang raya',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Header -->
  <section class="bg-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-3">
        <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-bold text-slate-950 tracking-tight leading-tight">
          Area Layanan Jual Beli, Sewa, Pasang &amp; Service AC di Malang Raya &amp; Surabaya
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Dengan kantor dan workshop utama di Kedungkandang, Kota Malang serta hub proyek di koridor Waru–Rungkut, teknisi tetap kami menjangkau seluruh area perkantoran, instansi, pabrik, dan kawasan komersial secara terjadwal.
        </p>
      </div>
    </div>
  </section>

  <!-- Office Base Card -->
  <section class="py-10 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-xl bg-[#020617] text-white p-6 sm:p-8 space-y-2">
        <h2 class="text-lg sm:text-2xl font-bold">{BUSINESS_INFO.address.formatted}</h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-3xl">
          Menyimpan stok unit ready, perlengkapan instalasi pipa tembaga ASTM 0.8mm, pompa vakum digital, tabung freon resmi (R32, R410A), dan armada teknisi lapangan.
        </p>
      </div>
    </div>
  </section>

  <!-- Malang Raya & East Java Districts Grid -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-950">Wilayah Pelayanan Operasional</h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Daftar kecamatan dan kawasan komersial dengan jangkauan layanan kunjungan reguler
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {malangAreas.map((area) => (
          <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-3 flex flex-col justify-between">
            <div class="space-y-2">
              <h3 class="text-slate-950 font-bold text-sm sm:text-base">
                {area.name}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                {area.coverage}
              </p>
            </div>
            <div class="pt-2 border-t border-slate-200">
              <span class="text-xs text-[#c2410c] font-semibold">
                {area.highlight}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- East Java Regional B2B Coverage -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-xl bg-white border border-slate-200 p-6 sm:p-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="max-w-2xl space-y-2">
          <h2 class="text-xl sm:text-3xl font-bold text-slate-950 tracking-tight">
            Layanan Pengadaan Proyek B2B se-Jawa Timur
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Sentra AC siap bermitra untuk proyek pengadaan unit AC multi-unit, instalasi gedung bertingkat, dan kontrak perawatan cabang korporat di wilayah Malang Raya, Surabaya, Sidoarjo, Pasuruan, Mojokerto, Probolinggo, dan Blitar.
          </p>
        </div>

        <div class="shrink-0">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-semibold text-xs sm:text-sm border border-slate-300 transition-colors"
          >
            Konsultasi via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
