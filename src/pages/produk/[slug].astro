---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import ProductVariantSelector from '../../components/products/ProductVariantSelector';
import ProductCard from '../../components/products/ProductCard.astro';
import { getCollection } from 'astro:content';
import { getProductSchema, getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

export async function getStaticPaths() {
  const products = await getCollection('produk');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, allProducts: products },
  }));
}

interface Props {
  product: any;
  allProducts: Array<any>;
}

const { product, allProducts } = Astro.props;
const { Content } = await product.render();

const categoryLabels: Record<string, string> = {
  'ac-split': 'AC Split Wall',
  'ac-cassette': 'AC Cassette 4-Way',
  'ac-floor-standing': 'AC Floor Standing',
  'ac-commercial': 'AC Ceiling & Duct',
  'paket-jasa': 'Paket Jasa & Sewa',
};

const categoryName = categoryLabels[product.data.category] || product.data.category;

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk AC', url: '/produk/' },
  { name: categoryName, url: `/produk/${product.data.category}/` },
  { name: product.data.title, url: `/produk/${product.slug}/` },
];

const productJsonLd = getProductSchema({
  title: product.data.title,
  description: product.data.description,
  thumbnail: product.data.thumbnail,
  brand: product.data.brand,
  category: categoryName,
  slug: product.slug,
  price: product.data.price,
  priceDisplay: product.data.priceDisplay,
  stockStatus: product.data.stockStatus,
  variants: product.data.variants,
  specs: product.data.specs,
});

const breadcrumbJsonLd = getBreadcrumbSchema(breadcrumbs);

const combinedJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [productJsonLd, breadcrumbJsonLd],
};

const relatedProducts = allProducts
  .filter((p) => p.slug !== product.slug)
  .slice(0, 3);

const waConsultUrl = generateGeneralInquiryUrl(`produk-${product.slug}`);
---

<BaseLayout
  title={`Jual ${product.data.title} - Sentra AC`}
  description={product.data.description}
  canonical={ensureAbsoluteUrl(`/produk/${product.slug}/`)}
  image={product.data.thumbnail}
  type="product"
  jsonLd={combinedJsonLd}
  keywords={[
    product.data.title.toLowerCase(),
    `pengadaan ${product.data.title.toLowerCase()}`,
    `harga ${product.data.title.toLowerCase()}`,
    categoryName.toLowerCase(),
    'ac komersial malang',
    'ac kantor b2b',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Main Product Detail Section -->
  <section class="py-8 md:py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <div class="lg:col-span-6">
          <div class="rounded-xl overflow-hidden bg-slate-100 border border-slate-200 aspect-4/3">
            <img
              src={product.data.thumbnail}
              alt={`Unit ${product.data.title} Bergaransi Resmi - Sentra AC`}
              width="800"
              height="600"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </div>

        <div class="lg:col-span-6 space-y-5">
          <div class="space-y-2">
            <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
              <span class="font-semibold text-[#c2410c]">
                {categoryName}
              </span>
              {product.data.brand && (
                <>
                  <span>·</span>
                  <span>Merk: {product.data.brand}</span>
                </>
              )}
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-950 tracking-tight leading-snug">
              {product.data.title}
            </h1>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              {product.data.description}
            </p>
          </div>

          <ProductVariantSelector
            client:load
            productTitle={product.data.title}
            productSlug={product.slug}
            categoryName={categoryName}
            brand={product.data.brand}
            basePrice={product.data.price}
            basePriceDisplay={product.data.priceDisplay}
            variants={product.data.variants || []}
            stockStatus={product.data.stockStatus}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Specs & Longform Details Section -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        <div class="lg:col-span-7 space-y-4">
          <h2 class="text-xl font-bold text-slate-950">Deskripsi &amp; Spesifikasi Produk</h2>
          <div class="prose max-w-none">
            <Content />
          </div>
        </div>

        <div class="lg:col-span-5 space-y-6">
          {product.data.specs && (
            <div class="space-y-3">
              <h2 class="text-lg font-bold text-slate-950">Spesifikasi Teknis Unit</h2>
              <div class="rounded-xl border border-slate-200 overflow-hidden bg-white">
                <table class="w-full text-left text-xs">
                  <tbody class="divide-y divide-slate-200">
                    {Object.entries(product.data.specs).map(([key, value]) => (
                      <tr>
                        <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50 w-2/5">
                          {key}
                        </td>
                        <td class="py-3 px-4 text-slate-700">
                          {String(value)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          <!-- B2B Procurement Notice + Single Secondary WhatsApp CTA -->
          <div class="rounded-xl bg-white border border-slate-200 p-5 space-y-3">
            <h3 class="text-slate-950 font-bold text-xs sm:text-sm">
              Ketentuan Order &amp; Instalasi B2B
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Harga penawaran unit belum termasuk material pipa tembaga ASTM 0.8mm, kabel power, bracket outdoor, dan jasa instalasi teknisi kecuali disepakati dalam paket pengadaan kontrak.
            </p>
            <div class="pt-1">
              <a
                href={waConsultUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center py-2.5 px-4 rounded-lg bg-white hover:bg-slate-100 text-slate-800 border border-slate-300 text-xs font-semibold transition-colors"
              >
                Konsultasi via WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Products Section -->
  {relatedProducts.length > 0 && (
    <section class="py-12 md:py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-950">Referensi Unit Terkait</h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-1">Pilihan kapasitas dan tipe pendingin lainnya untuk fasilitas Anda</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedProducts.map((p) => (
            <ProductCard
              product={{
                title: p.data.title,
                description: p.data.description,
                category: p.data.category,
                condition: p.data.condition,
                capacity: p.data.capacity,
                price: p.data.price,
                priceDisplay: p.data.priceDisplay,
                compareAtPriceDisplay: p.data.compareAtPriceDisplay,
                stockStatus: p.data.stockStatus,
                thumbnail: p.data.thumbnail,
                slug: p.slug,
                brand: p.data.brand,
              }}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
