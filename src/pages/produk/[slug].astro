---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import ProductVariantSelector from '../../components/products/ProductVariantSelector';
import ProductCard from '../../components/products/ProductCard.astro';
import { getCollection } from 'astro:content';
import { getProductSchema, getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';

export async function getStaticPaths() {
  const products = await getCollection('produk');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product, allProducts: products },
  }));
}

interface Props {
  product: any;
  allProducts: Array<any>;
}

const { product, allProducts } = Astro.props;
const { Content } = await product.render();

const categoryLabels: Record<string, string> = {
  'ac-split': 'AC Split Wall',
  'ac-cassette': 'AC Cassette 4-Way',
  'ac-floor-standing': 'AC Floor Standing',
  'ac-commercial': 'AC Ducted Central',
};

const categoryName = categoryLabels[product.data.category] || product.data.category;

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk AC', url: '/produk/' },
  { name: categoryName, url: `/produk/${product.data.category}/` },
  { name: product.data.title, url: `/produk/${product.slug}/` },
];

const productJsonLd = getProductSchema({
  title: product.data.title,
  description: product.data.description,
  thumbnail: product.data.thumbnail,
  brand: product.data.brand,
  category: categoryName,
  slug: product.slug,
  price: product.data.price,
  priceDisplay: product.data.priceDisplay,
  stockStatus: product.data.stockStatus,
  variants: product.data.variants,
  specs: product.data.specs,
});

const breadcrumbJsonLd = getBreadcrumbSchema(breadcrumbs);

const combinedJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [productJsonLd, breadcrumbJsonLd],
};

const relatedProducts = allProducts
  .filter((p) => p.slug !== product.slug)
  .slice(0, 3);
---

<BaseLayout
  title={`${product.data.title} — Jual & Pengadaan B2B | ACNesia`}
  description={product.data.description}
  canonical={ensureAbsoluteUrl(`/produk/${product.slug}/`)}
  image={product.data.thumbnail}
  type="product"
  jsonLd={combinedJsonLd}
  keywords={[
    product.data.title.toLowerCase(),
    `pengadaan ${product.data.title.toLowerCase()}`,
    `harga ${product.data.title.toLowerCase()}`,
    categoryName.toLowerCase(),
    'ac komersial malang',
    'ac kantor b2b',
  ]}
>
  <!-- Breadcrumbs Bar -->
  <div class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Main Product Detail Section -->
  <section class="py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left Column: Visual Asset Gallery -->
        <div class="lg:col-span-6 space-y-4">
          <div class="relative rounded-3xl overflow-hidden bg-white border border-slate-200 shadow-sm aspect-4/3">
            <img
              src={product.data.thumbnail}
              alt={product.data.title}
              width="800"
              height="600"
              class="w-full h-full object-cover"
              loading="eager"
            />
            {product.data.capacity && (
              <div class="absolute top-4 right-4 z-10">
                <span class="px-3 py-1 rounded-lg text-xs font-bold bg-slate-900/90 text-white backdrop-blur-xs shadow-sm">
                  {product.data.capacity}
                </span>
              </div>
            )}
          </div>

          <!-- Value Guarantees Grid -->
          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="p-4 rounded-2xl bg-white border border-slate-200 flex items-start gap-3">
              <div class="w-8 h-8 rounded-xl bg-red-50 text-red-800 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div class="space-y-0.5">
                <div class="text-xs font-bold text-slate-900">Garansi Resmi Pabrik</div>
                <div class="text-[11px] text-slate-500">Unit asli dengan kartu garansi resmi distributor agen</div>
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-white border border-slate-200 flex items-start gap-3">
              <div class="w-8 h-8 rounded-xl bg-red-50 text-red-800 flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <div class="space-y-0.5">
                <div class="text-xs font-bold text-slate-900">Legalitas & Faktur Pajak</div>
                <div class="text-[11px] text-slate-500">Siap terbitkan invoice resmi B2B & PPN untuk instansi</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Variant & RFQ Island -->
        <div class="lg:col-span-6">
          <ProductVariantSelector
            client:load
            productTitle={product.data.title}
            productSlug={product.slug}
            categoryName={categoryName}
            brand={product.data.brand}
            basePrice={product.data.price}
            basePriceDisplay={product.data.priceDisplay}
            variants={product.data.variants || []}
            stockStatus={product.data.stockStatus}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Specs & Longform Details Section -->
  <section class="py-12 bg-white border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Longform Article Body -->
        <div class="lg:col-span-7 space-y-6">
          <div class="border-b border-slate-200 pb-3">
            <h2 class="text-xl font-bold text-slate-900">Deskripsi & Spesifikasi Produk</h2>
            <p class="text-xs text-slate-500 mt-1">Panduan lengkap teknis dan aplikasi pemasangan di lapangan</p>
          </div>

          <div class="prose prose-slate prose-headings:font-bold prose-headings:text-slate-900 prose-p:text-slate-600 prose-p:leading-relaxed prose-li:text-slate-600 max-w-none text-sm">
            <Content />
          </div>
        </div>

        <!-- Technical Specification Matrix Table -->
        <div class="lg:col-span-5 space-y-6">
          <div class="border-b border-slate-200 pb-3">
            <h2 class="text-xl font-bold text-slate-900">Spesifikasi Teknis Unit</h2>
            <p class="text-xs text-slate-500 mt-1">Parameter teknis instalasi dan operasional</p>
          </div>

          {product.data.specs && (
            <div class="rounded-2xl border border-slate-200 overflow-hidden bg-white shadow-2xs">
              <table class="w-full text-left text-xs">
                <tbody class="divide-y divide-slate-100">
                  {Object.entries(product.data.specs).map(([key, value]) => (
                    <tr class="hover:bg-slate-50/50">
                      <td class="py-3 px-4 font-semibold text-slate-700 bg-slate-50/60 w-2/5">
                        {key}
                      </td>
                      <td class="py-3 px-4 text-slate-600">
                        {String(value)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <!-- B2B Procurement Notice Card -->
          <div class="rounded-2xl bg-red-50/70 border border-red-200 p-5 space-y-3">
            <div class="flex items-center gap-2 text-red-950 font-bold text-xs uppercase tracking-wider">
              <svg class="w-4 h-4 text-red-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Ketentuan Order & Instalasi</span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Harga penawaran unit belum termasuk material pipa tembaga, kabel power, bracket outdoor, dan jasa instalasi teknisi kecuali disepakati dalam paket pengadaan kontrak. Survey lokasi tersedia untuk wilayah Malang Raya.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Related Products Section -->
  {relatedProducts.length > 0 && (
    <section class="py-12 md:py-16 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900">Produk Pendingin Terkait</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">Eksplorasi kapasitas dan tipe pendingin lainnya untuk kebutuhan fasilitas Anda</p>
          </div>
          <a href="/produk/" class="text-xs font-semibold text-red-700 hover:text-red-800 hover:underline">
            Lihat Semua Produk &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedProducts.map((p) => (
            <ProductCard
              product={{
                title: p.data.title,
                description: p.data.description,
                category: p.data.category,
                capacity: p.data.capacity,
                priceDisplay: p.data.priceDisplay,
                stockStatus: p.data.stockStatus,
                thumbnail: p.data.thumbnail,
                slug: p.slug,
                brand: p.data.brand,
              }}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
