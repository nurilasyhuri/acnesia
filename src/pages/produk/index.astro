---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import ProductFilter, { type ProductItem } from '../../components/products/ProductFilter';
import { getCollection } from 'astro:content';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const products = await getCollection('produk');

const sortedProducts: ProductItem[] = products
  .sort((a, b) => a.data.orderPriority - b.data.orderPriority)
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    category: p.data.category,
    condition: p.data.condition,
    capacity: p.data.capacity,
    price: p.data.price,
    priceDisplay: p.data.priceDisplay,
    compareAtPriceDisplay: p.data.compareAtPriceDisplay,
    stockStatus: p.data.stockStatus,
    thumbnail: p.data.thumbnail,
    slug: p.slug,
    brand: p.data.brand,
    variants: p.data.variants,
  }));

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Unit & Paket Jasa', url: '/produk/' },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const waConsultUrl = generateGeneralInquiryUrl('katalog-produk-cta');
---

<BaseLayout
  title="Katalog & Harga AC Split, Cassette, Standing & Central - Sentra AC"
  description="Daftar harga dan katalog unit AC Split, AC Cassette 4-Way, Floor Standing, serta Ducted Central baru bergaransi resmi untuk kantor & gedung di Malang Raya."
  canonical={ensureAbsoluteUrl('/produk/')}
  jsonLd={breadcrumbSchema}
  keywords={[
    'katalog ac komersial',
    'jual ac kantor malang',
    'ac cassette 4 way',
    'ac floor standing komersial',
    'harga ac standing b2b',
    'pengadaan ac gedung',
    'sentra ac malang',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Collection Header -->
  <section class="bg-white py-8 sm:py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-2.5">
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-tight leading-tight">
          Katalog Harga AC Baru, Rekondisi Bergaransi &amp; Paket Jasa
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Pilih kategori unit atau paket layanan di bawah ini untuk melihat spesifikasi teknis lengkap dan menyusun Surat Penawaran Harga (SPH).
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Storefront Collection Grid Island -->
  <section class="py-8 sm:py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ProductFilter client:load initialProducts={sortedProducts} />
    </div>
  </section>

  <!-- B2B Procurement Callout Banner -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-xl bg-slate-50 border border-slate-200 p-6 sm:p-8 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="max-w-2xl space-y-2">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-950 tracking-tight">
            Pengajuan SPH Resmi, RAB Proyek &amp; Borongan AC Bekas
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Ajukan daftar kebutuhan unit melalui form SPH di bagian atas halaman atau jadwalkan survei lokasi bersama tim estimator kami.
          </p>
        </div>
        <div class="shrink-0">
          <a
            href={waConsultUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-5 py-3 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-semibold text-xs sm:text-sm border border-slate-300 transition-colors"
          >
            Konsultasi via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
