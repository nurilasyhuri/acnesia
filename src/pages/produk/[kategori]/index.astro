---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/common/Breadcrumb.astro';
import ProductCard from '../../../components/products/ProductCard.astro';
import { getCollection } from 'astro:content';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../../../utils/seo';
import { generateGeneralInquiryUrl } from '../../../utils/whatsapp';

export async function getStaticPaths() {
  const allProducts = await getCollection('produk');

  const categories = [
    {
      id: 'ac-split',
      name: 'AC Split Wall Mounted 0.5 PK - 2.5 PK',
      subtitle: 'AC Split Inverter & Standard Hemat Listrik untuk Ruang Kantor & Ruko',
      description:
        'Katalog dan harga AC Split Wall Mounted Inverter & Standard 0.5 PK hingga 2.5 PK bergaransi resmi untuk ruang kantor, ruko, serta bisnis di Malang Raya.',
      idealFor: 'Ruang kerja staf, ruang manajer, bilik konsultasi, kamar hotel, dan ruko.',
      keyAdvantages: [
        'Instalasi relatif cepat tanpa bongkar plafon',
        'Tersedia teknologi Inverter hemat listrik hingga 50%',
        'Pilihan kapasitas fleksibel (0.5 PK s/d 2.5 PK)',
        'Biaya pengadaan unit & maintenance paling efisien',
      ],
    },
    {
      id: 'ac-cassette',
      name: 'AC Cassette 4-Way Plafon 2 PK - 5 PK',
      subtitle: 'AC Plafon Hembusan 4 Arah Merata untuk Ruang Kantor & Meeting',
      description:
        'Katalog dan harga AC Cassette 4-Way plafon 2 PK hingga 5 PK hembusan 360 derajat merata untuk ruang kantor terbuka, ruang rapat, & lobi di Malang Raya.',
      idealFor: 'Ruang meeting besar, open space office, showroom, restoran, dan lobi gedung.',
      keyAdvantages: [
        'Hembusan angin 4 arah merata tanpa dead-zone',
        'Desain rapi menyatu rata dengan plafon gypsum / akustik',
        'Dilengkapi pompa pembuangan kondensasi otomatis (drain pump)',
        'Kapasitas pendinginan bertenaga untuk ruangan berokupansi tinggi',
      ],
    },
    {
      id: 'ac-floor-standing',
      name: 'AC Floor Standing Komersial 3 PK - 10 PK',
      subtitle: 'AC Berdiri Kapasitas Besar untuk Aula, Ballroom & Hall Pertemuan',
      description:
        'Katalog dan harga AC Floor Standing 3 PK hingga 10 PK berdaya tiup kuat untuk aula serbaguna, ballroom, restoran luas, & ruang pertemuan di Malang Raya.',
      idealFor: 'Aula serbaguna, ballroom kantor, event space, ruang training, dan area ibadah.',
      keyAdvantages: [
        'Kekuatan blower ekstra besar dengan jangkauan angin jauh',
        'Penempatan fleksibel di lantai tanpa membebani konstruksi plafon',
        'Kontrol panel digital langsung pada bodi unit atau remote',
        'Sangat tangguh untuk beban panas tinggi dan ruang pertemuan',
      ],
    },
    {
      id: 'ac-commercial',
      name: 'AC Ceiling Ducted & Central 3 PK - 20 PK',
      subtitle: 'Sistem AC Saluran Udara Tersembunyi Plafon untuk Gedung & Hotel',
      description:
        'Katalog dan harga AC Ceiling Ducted serta Central Commercial 3 PK hingga 20 PK tersembunyi di plafon untuk gedung bertingkat, hotel, & RS di Malang Raya.',
      idealFor: 'Kantor direksi, ruang konferensi VIP, hotel butik, rumah sakit, dan gedung bertingkat.',
      keyAdvantages: [
        'Tampilan interior sangat bersih, hanya diffuser udara yang terlihat',
        'Tingkat kebisingan (noise level) paling rendah di kelasnya',
        'Pengaturan zoning udara fleksibel melalui saluran ducting',
        'Mendukung integrasi sistem Building Automation (BAS)',
      ],
    },
    {
      id: 'paket-jasa',
      name: 'Paket Jasa Pasang, Cuci Steam, Service & Sewa AC',
      subtitle: 'Paket Teknisi Resmi Standar Vakum Digital & Rental AC',
      description:
        'Daftar harga paket jasa pasang AC pipa tembaga vakum, cuci steam bertekanan, perbaikan freon, dan sewa AC standing harian/bulanan di wilayah Malang Raya.',
      idealFor: 'Pemasangan unit baru/relokasi, perawatan rutin AC kantor, perbaikan darurat, dan acara event.',
      keyAdvantages: [
        'Harga paket transparan sesuai kapasitas PK tanpa biaya tersembunyi',
        'Wajib prosedur mesin vakum digital pada setiap titik instalasi',
        'Garansi pekerjaan tertulis untuk cuci steam, freon, dan instalasi',
        'Mendukung penerbitan Berita Acara Serah Terima (BAST) & Faktur Pajak PPN',
      ],
    },
  ];

  return categories.map((cat) => {
    const categoryProducts = allProducts.filter((p) => p.data.category === cat.id);
    return {
      params: { kategori: cat.id },
      props: { category: cat, products: categoryProducts },
    };
  });
}

interface Props {
  category: {
    id: string;
    name: string;
    subtitle: string;
    description: string;
    idealFor: string;
    keyAdvantages: string[];
  };
  products: Array<any>;
}

const { category, products } = Astro.props;

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Katalog Produk AC', url: '/produk/' },
  { name: category.name, url: `/produk/${category.id}/` },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const waConsultUrl = generateGeneralInquiryUrl(`kategori-${category.id}`);
---

<BaseLayout
  title={`Jual & Harga ${category.name} Malang - Sentra AC`}
  description={category.description}
  canonical={ensureAbsoluteUrl(`/produk/${category.id}/`)}
  jsonLd={breadcrumbSchema}
  keywords={[
    category.name.toLowerCase(),
    `jual ${category.name.toLowerCase()}`,
    `pengadaan ${category.name.toLowerCase()} malang`,
    `harga ${category.name.toLowerCase()} kantor`,
    'ac komersial b2b',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Category Hero -->
  <section class="bg-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8 space-y-3.5">
          <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-bold text-slate-950 tracking-tight leading-tight">
            {category.name}
          </h1>
          <p class="text-sm sm:text-base text-slate-800 font-semibold">
            {category.subtitle}
          </p>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-3xl">
            {category.description}
          </p>
          <p class="text-xs sm:text-sm text-slate-700 pt-1">
            <strong class="font-semibold text-slate-950">Aplikasi Ruangan Ideal:</strong> {category.idealFor}
          </p>
        </div>

        <div class="lg:col-span-4 bg-slate-50 p-6 rounded-xl border border-slate-200 space-y-3">
          <h2 class="font-bold text-slate-950 text-sm">
            Karakteristik Teknis
          </h2>
          <ul class="space-y-2 list-disc pl-4 text-xs text-slate-700">
            {category.keyAdvantages.map((adv) => (
              <li class="leading-relaxed">{adv}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Products in this Category -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg sm:text-xl font-bold text-slate-950">Pilihan Unit {category.name}</h2>
          <p class="text-xs text-slate-600 mt-1">Tersedia opsi pengadaan unit saja atau paket instalasi material lengkap</p>
        </div>
        <span class="text-xs font-medium text-slate-600">
          {products.length} Unit
        </span>
      </div>

      {products.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {products.map((product) => (
            <ProductCard
              product={{
                title: product.data.title,
                description: product.data.description,
                category: product.data.category,
                condition: product.data.condition,
                capacity: product.data.capacity,
                price: product.data.price,
                priceDisplay: product.data.priceDisplay,
                compareAtPriceDisplay: product.data.compareAtPriceDisplay,
                stockStatus: product.data.stockStatus,
                thumbnail: product.data.thumbnail,
                slug: product.slug,
                brand: product.data.brand,
              }}
            />
          ))}
        </div>
      ) : (
        <div class="py-12 text-center bg-white rounded-xl border border-slate-200 p-8 space-y-3">
          <p class="font-bold text-slate-950 text-sm">Unit kategori ini sedang dalam proses pembaruan katalog.</p>
          <p class="text-xs text-slate-600 max-w-md mx-auto">
            Silakan ajukan kebutuhan spesifikasi merk Daikin, Panasonic, Gree, atau Mitsubishi Electric melalui tim B2B Sentra AC.
          </p>
        </div>
      )}

      <!-- Single End-of-Page Consultation Action -->
      <div class="pt-4 flex justify-end">
        <a
          href={waConsultUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-white hover:bg-slate-100 text-slate-800 border border-slate-300 text-xs font-semibold transition-colors"
        >
          Konsultasi via WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
