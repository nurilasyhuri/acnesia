---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

export async function getStaticPaths() {
  const solutions = await getCollection('solusi');
  return solutions.map((sol) => ({
    params: { slug: sol.slug },
    props: { solution: sol, allSolutions: solutions },
  }));
}

interface Props {
  solution: any;
  allSolutions: Array<any>;
}

const { solution, allSolutions } = Astro.props;
const { Content } = await solution.render();

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Solusi Tata Udara', url: '/solusi/' },
  { name: solution.data.target, url: `/solusi/${solution.slug}/` },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const waUrl = generateGeneralInquiryUrl(`solusi-${solution.slug}`);

const otherSolutions = allSolutions
  .filter((s) => s.slug !== solution.slug)
  .slice(0, 2);
---

<BaseLayout
  title={`${solution.data.title} - Sentra AC`}
  description={solution.data.description}
  canonical={ensureAbsoluteUrl(`/solusi/${solution.slug}/`)}
  image={solution.data.heroImage}
  jsonLd={breadcrumbSchema}
  keywords={[
    `solusi ac ${solution.data.target.toLowerCase()}`,
    `pendingin ruangan ${solution.data.target.toLowerCase()}`,
    'ac komersial b2b',
    'sentra ac mitra bisnis indonesia',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-3.5">
          <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-bold text-slate-950 tracking-tight leading-tight">
            {solution.data.title}
          </h1>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            {solution.data.description}
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-xl overflow-hidden bg-slate-100 border border-slate-200 aspect-16/10">
            <img
              src={solution.data.heroImage}
              alt={`${solution.data.title} di Malang Raya - Sentra AC`}
              width="700"
              height="438"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem vs Solution Analysis -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {solution.data.painPoints && (
          <div class="p-6 rounded-xl bg-white border border-slate-200 space-y-3">
            <h2 class="text-slate-950 font-bold text-sm sm:text-base">
              Tantangan Lapangan yang Dihadapi
            </h2>
            <ul class="space-y-2 list-disc pl-4 text-xs sm:text-sm text-slate-600">
              {solution.data.painPoints.map((p: string) => (
                <li class="leading-relaxed">{p}</li>
              ))}
            </ul>
          </div>
        )}

        {solution.data.solutions && (
          <div class="p-6 rounded-xl bg-white border border-slate-200 space-y-3">
            <h2 class="text-slate-950 font-bold text-sm sm:text-base">
              Pendekatan Rekayasa Sentra AC
            </h2>
            <ul class="space-y-2 list-disc pl-4 text-xs sm:text-sm text-slate-700">
              {solution.data.solutions.map((s: string) => (
                <li class="leading-relaxed">{s}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Detailed Editorial & Recommendations -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <div class="lg:col-span-8">
          <div class="prose max-w-none">
            <Content />
          </div>
        </div>

        <div class="lg:col-span-4 space-y-6">
          {solution.data.recommendedTypes && (
            <div class="rounded-xl bg-slate-50 border border-slate-200 p-6 space-y-3">
              <h3 class="font-bold text-slate-950 text-sm sm:text-base">Rekomendasi Konfigurasi Unit</h3>
              <ul class="space-y-2 list-disc pl-4 text-xs text-slate-700">
                {solution.data.recommendedTypes.map((type: string) => (
                  <li class="leading-relaxed">{type}</li>
                ))}
              </ul>
            </div>
          )}

          <!-- Single End-of-Page Contact Card -->
          <div class="rounded-xl bg-white border border-slate-200 p-6 space-y-3">
            <h3 class="font-bold text-slate-950 text-sm sm:text-base">Survei Kelayakan &amp; Audit Beban Panas</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Tim engineering Sentra AC melayani kunjungan survei langsung untuk audit beban panas dan rute pemipaan gedung.
            </p>
            <div class="pt-1">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center w-full py-2.5 px-4 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-semibold text-xs border border-slate-300 transition-colors"
              >
                Konsultasi via WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Other Solutions -->
  {otherSolutions.length > 0 && (
    <section class="py-12 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <h2 class="text-xl font-bold text-slate-950">Solusi Sektor Lainnya</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {otherSolutions.map((s) => (
            <a
              href={`/solusi/${s.slug}/`}
              class="group p-5 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition-colors block space-y-2"
            >
              <span class="block text-xs font-semibold text-[#c2410c]">{s.data.target}</span>
              <h3 class="font-bold text-slate-950 group-hover:text-[#c2410c] transition-colors text-base">
                {s.data.title}
              </h3>
              <p class="text-xs text-slate-600 line-clamp-2">{s.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
