---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

export async function getStaticPaths() {
  const solutions = await getCollection('solusi');
  return solutions.map((sol) => ({
    params: { slug: sol.slug },
    props: { solution: sol, allSolutions: solutions },
  }));
}

interface Props {
  solution: any;
  allSolutions: Array<any>;
}

const { solution, allSolutions } = Astro.props;
const { Content } = await solution.render();

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Solusi Tata Udara', url: '/solusi/' },
  { name: solution.data.target, url: `/solusi/${solution.slug}/` },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const waUrl = generateGeneralInquiryUrl(`solusi-${solution.slug}`);

const otherSolutions = allSolutions
  .filter((s) => s.slug !== solution.slug)
  .slice(0, 2);
---

<BaseLayout
  title={`${solution.data.title} | ACNesia Malang`}
  description={solution.data.description}
  canonical={ensureAbsoluteUrl(`/solusi/${solution.slug}/`)}
  image={solution.data.heroImage}
  jsonLd={breadcrumbSchema}
  keywords={[
    `solusi ac ${solution.data.target.toLowerCase()}`,
    `pendingin ruangan ${solution.data.target.toLowerCase()}`,
    'ac komersial b2b',
    'acnesia mitra bisnis indonesia',
  ]}
>
  <!-- Breadcrumbs -->
  <div class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-white via-slate-50 to-slate-50 border-b border-slate-200 py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-800 border border-red-200">
            <span class="w-2 h-2 rounded-full bg-red-700"></span>
            <span>Solusi Sektoral: {solution.data.target}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-950 tracking-tight leading-tight">
            {solution.data.title}
          </h1>
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
            {solution.data.description}
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-full bg-red-700 hover:bg-red-800 text-white font-bold text-xs shadow-md transition-colors"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
              </svg>
              <span>Konsultasi Kebutuhan Sektor {solution.data.target}</span>
            </a>
            <a
              href="/pengadaan-ac/"
              class="inline-flex items-center gap-2 px-5 py-3.5 rounded-full bg-white hover:bg-slate-100 text-slate-700 font-semibold text-xs border border-slate-300 transition-colors"
            >
              <span>Prosedur Pengadaan B2B</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden bg-white border border-slate-200 shadow-md aspect-16/10">
            <img
              src={solution.data.heroImage}
              alt={solution.data.title}
              width="700"
              height="438"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem vs Solution Analysis -->
  <section class="py-12 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Tantangan / Pain Points -->
        {solution.data.painPoints && (
          <div class="p-6 sm:p-8 rounded-3xl bg-rose-50/50 border border-rose-100 space-y-4">
            <div class="flex items-center gap-2.5 text-rose-800 font-bold text-sm uppercase tracking-wider">
              <span class="w-6 h-6 rounded-full bg-rose-200 flex items-center justify-center text-xs font-black">!</span>
              <span>Tantangan Lapangan Kerap Dihadapi:</span>
            </div>
            <ul class="space-y-3">
              {solution.data.painPoints.map((p: string) => (
                <li class="flex items-start gap-3 text-xs sm:text-sm text-slate-700">
                  <span class="text-rose-600 font-bold shrink-0 mt-0.5">✕</span>
                  <span class="leading-relaxed">{p}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Solusi Rekayasa ACNesia -->
        {solution.data.solutions && (
          <div class="p-6 sm:p-8 rounded-3xl bg-red-50/50 border border-red-100 space-y-4">
            <div class="flex items-center gap-2.5 text-red-950 font-bold text-sm uppercase tracking-wider">
              <span class="w-6 h-6 rounded-full bg-red-200 flex items-center justify-center text-xs font-black">✓</span>
              <span>Pendekatan Rekayasa ACNesia:</span>
            </div>
            <ul class="space-y-3">
              {solution.data.solutions.map((s: string) => (
                <li class="flex items-start gap-3 text-xs sm:text-sm text-slate-700">
                  <svg class="w-4 h-4 text-red-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="leading-relaxed font-medium">{s}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Detailed Editorial & Recommendations -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <!-- Content Body -->
        <div class="lg:col-span-8 space-y-6">
          <div class="prose prose-slate prose-headings:font-bold prose-headings:text-slate-900 prose-p:text-slate-600 prose-p:leading-relaxed prose-li:text-slate-600 max-w-none text-sm">
            <Content />
          </div>
        </div>

        <!-- Right Side: Recommended Types -->
        <div class="lg:col-span-4 space-y-6">
          {solution.data.recommendedTypes && (
            <div class="rounded-3xl bg-white border border-slate-200 p-6 shadow-sm space-y-4">
              <div class="border-b border-slate-100 pb-3">
                <h3 class="font-bold text-slate-900 text-sm">Rekomendasi Konfigurasi Unit</h3>
                <p class="text-xs text-slate-500 mt-0.5">Setup pendingin yang paling efisien untuk sektor ini</p>
              </div>
              <ul class="space-y-2.5">
                {solution.data.recommendedTypes.map((type: string) => (
                  <li class="flex items-start gap-2.5 text-xs text-slate-700 p-2.5 rounded-xl bg-slate-50 border border-slate-100">
                    <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="font-medium">{type}</span>
                  </li>
                ))}
              </ul>
              <a
                href="/produk/"
                class="block text-center py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs transition-colors"
              >
                Lihat Katalog Unit Rekomendasi
              </a>
            </div>
          )}

          <!-- Contact B2B Consultant Card -->
          <div class="rounded-3xl bg-slate-900 text-white p-6 space-y-3">
            <h4 class="font-bold text-white text-sm">Butuh Survey Kelayakan Ruangan?</h4>
            <p class="text-xs text-slate-300 leading-relaxed">
              Tim engineering ACNesia melayani kunjungan survey langsung di wilayah Malang Raya untuk audit beban panas dan rute pemipaan.
            </p>
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-red-600 hover:bg-red-400 text-slate-950 font-bold text-xs transition-colors"
            >
              <span>Jadwalkan Survey Lokasi</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Other Solutions -->
  {otherSolutions.length > 0 && (
    <section class="py-12 bg-white border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <h2 class="text-xl font-bold text-slate-900">Solusi Sektor Lainnya</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {otherSolutions.map((s) => (
            <div class="p-6 rounded-2xl border border-slate-200 bg-slate-50 hover:bg-white hover:shadow-md transition-all flex flex-col justify-between">
              <div class="space-y-2">
                <span class="text-xs font-bold text-red-800 uppercase tracking-wider">{s.data.target}</span>
                <h3 class="font-bold text-slate-900 text-base">
                  <a href={`/solusi/${s.slug}/`} class="hover:text-red-800">
                    {s.data.title}
                  </a>
                </h3>
                <p class="text-xs text-slate-600 line-clamp-2">{s.data.description}</p>
              </div>
              <div class="pt-4 border-t border-slate-200/60 mt-4">
                <a href={`/solusi/${s.slug}/`} class="text-xs font-semibold text-red-700 hover:underline inline-flex items-center gap-1">
                  <span>Lihat Solusi {s.data.target}</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
