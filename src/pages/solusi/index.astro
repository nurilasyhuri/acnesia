---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const solutions = await getCollection('solusi');

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Solusi Bisnis & Industri', url: '/solusi/' },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const waConsultUrl = generateGeneralInquiryUrl('solusi-hub-cta');
---

<BaseLayout
  title="Pengadaan, Pasang & Kontrak Service AC Kantor Gedung - Sentra AC"
  description="Layanan pengadaan, instalasi, cuci berkala, dan kontrak maintenance AC untuk kantor, gedung bertingkat, instansi pemerintah, serta pabrik di Malang Raya."
  canonical={ensureAbsoluteUrl('/solusi/')}
  jsonLd={breadcrumbSchema}
  keywords={[
    'solusi ac kantor',
    'ac gedung komersial',
    'pengadaan ac instansi pemerintah',
    'ac ruang server pabrik',
    'sentra ac mitra bisnis indonesia',
    'tata udara b2b malang',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-3.5">
        <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-bold text-slate-950 tracking-tight leading-tight">
          Solusi Pengadaan, Instalasi &amp; Kontrak Maintenance AC Kantor dan Gedung
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Kebutuhan pendingin ruang server berbeda dengan lobi gedung bertingkat atau ruang rapat berokupansi padat. Sentra AC memetakan beban kalor, standar estetika plafon, serta efisiensi daya listrik yang tepat sasaran bagi setiap sektor usaha.
        </p>
      </div>
    </div>
  </section>

  <!-- Solutions Grid -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {solutions.map((sol) => (
          <a
            href={`/solusi/${sol.slug}/`}
            class="group rounded-xl bg-white border border-slate-200 hover:border-slate-300 transition-colors overflow-hidden block"
          >
            <div class="aspect-16/9 bg-slate-100 overflow-hidden">
              <img
                src={sol.data.heroImage}
                alt={`${sol.data.title} di Malang Raya - Sentra AC`}
                width="600"
                height="338"
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
                loading="lazy"
              />
            </div>

            <div class="p-6 space-y-3">
              <span class="block text-xs font-semibold text-[#c2410c]">
                {sol.data.target}
              </span>
              <h2 class="text-lg sm:text-xl font-bold text-slate-950 group-hover:text-[#c2410c] transition-colors leading-snug">
                {sol.data.title}
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {sol.data.description}
              </p>

              {sol.data.painPoints && (
                <div class="pt-3 border-t border-slate-100 space-y-1.5">
                  <span class="text-xs font-semibold text-slate-800 block">
                    Fokus Penanganan:
                  </span>
                  <ul class="space-y-1 list-disc pl-4 text-xs text-slate-600">
                    {sol.data.painPoints.slice(0, 2).map((pp: string) => (
                      <li>{pp}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Sector Value Proposition Banner -->
  <section class="py-14 bg-white text-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-xl bg-slate-50 border border-slate-200 p-6 sm:p-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="max-w-2xl space-y-2">
          <h2 class="text-xl sm:text-3xl font-bold tracking-tight text-slate-950">
            Program Pemeliharaan Terjadwal untuk Fasilitas Multi-Unit
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Sentra AC menyusun program pemeliharaan terencana dengan laporan kondisi berkala dan prioritas respon darurat untuk gedung perkantoran, kampus, dan pabrik.
          </p>
        </div>
        <div class="shrink-0">
          <a
            href={waConsultUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center py-2.5 px-5 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-semibold text-xs sm:text-sm border border-slate-300 transition-colors"
          >
            Konsultasi via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
