---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const solutions = await getCollection('solusi');

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Solusi Bisnis & Industri', url: '/solusi/' },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const waConsultUrl = generateGeneralInquiryUrl('solusi-hub-hero');
---

<BaseLayout
  title="Solusi Pendingin Ruangan Kantor, Gedung, Instansi & Pabrik | ACNesia"
  description="Solusi tata udara komersial khusus untuk perkantoran, instansi pemerintah, gedung bertingkat, dan bisnis multi-cabang. Dirancang efisien energi dan minim downtime."
  canonical={ensureAbsoluteUrl('/solusi/')}
  jsonLd={breadcrumbSchema}
  keywords={[
    'solusi ac kantor',
    'ac gedung komersial',
    'pengadaan ac instansi pemerintah',
    'ac ruang server pabrik',
    'acnesia mitra bisnis indonesia',
    'tata udara b2b malang',
  ]}
>
  <!-- Breadcrumb -->
  <div class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-white via-slate-50 to-slate-50 border-b border-slate-200 py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-800 border border-red-200">
          <span class="w-2 h-2 rounded-full bg-red-700"></span>
          <span>B2B Engineering & Facility Solutions</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-950 tracking-tight leading-tight">
          Solusi Tata Udara Spesifik untuk Setiap Karakteristik Fasilitas
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          Kebutuhan pendingin ruang server berbeda dengan lobi gedung bertingkat atau ruang rapat berokupansi padat. ACNesia memetakan beban kalor, standar estetika plafon, serta efisiensi daya listrik yang tepat sasaran bagi setiap sektor usaha.
        </p>

        <div class="pt-2 flex flex-wrap items-center gap-3">
          <a
            href={waConsultUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-red-700 hover:bg-red-800 text-white font-bold text-xs shadow-md transition-colors"
          >
            <span>Konsultasi Beban Kalor Sektor Anda</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
          <a
            href="/pengadaan-ac/"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white hover:bg-slate-100 text-slate-700 font-semibold text-xs border border-slate-300 transition-colors"
          >
            <span>Skema Pengadaan Multi-Unit</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Solutions Grid -->
  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {solutions.map((sol) => (
          <div class="group rounded-3xl bg-white border border-slate-200 hover:border-slate-300 hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between">
            <div>
              <!-- Hero Visual -->
              <div class="relative aspect-16/9 bg-slate-100 overflow-hidden">
                <img
                  src={sol.data.heroImage}
                  alt={sol.data.title}
                  width="600"
                  height="338"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-slate-950/85 text-white backdrop-blur-xs">
                    {sol.data.target}
                  </span>
                </div>
              </div>

              <!-- Content Body -->
              <div class="p-6 sm:p-8 space-y-4">
                <h2 class="text-xl font-bold text-slate-900 group-hover:text-red-800 transition-colors leading-snug">
                  <a href={`/solusi/${sol.slug}/`}>
                    {sol.data.title}
                  </a>
                </h2>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  {sol.data.description}
                </p>

                <!-- Pain Points vs Solutions Pill -->
                {sol.data.painPoints && (
                  <div class="pt-3 border-t border-slate-100 space-y-2">
                    <span class="text-[11px] font-bold text-rose-700 uppercase tracking-wider block">
                      Tantangan Umum yang Kami Selesaikan:
                    </span>
                    <ul class="space-y-1.5">
                      {sol.data.painPoints.slice(0, 2).map((pp: string) => (
                        <li class="flex items-start gap-2 text-xs text-slate-600">
                          <span class="text-rose-500 font-bold shrink-0">✕</span>
                          <span>{pp}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>

            <!-- Footer Action -->
            <div class="p-6 sm:p-8 pt-0">
              <a
                href={`/solusi/${sol.slug}/`}
                class="inline-flex items-center justify-between w-full py-3 px-5 rounded-xl bg-slate-100 group-hover:bg-slate-900 text-slate-800 group-hover:text-white text-xs font-bold transition-all"
              >
                <span>Pelajari Pendekatan Solusi {sol.data.target}</span>
                <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sector Value Proposition Banner -->
  <section class="py-16 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-3">
          <span class="text-xs font-bold text-red-400 uppercase tracking-wider">Mitra Fasilitas Perusahaan</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
            Memiliki Lebih dari 10 Unit AC di Fasilitas Anda?
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed max-w-2xl">
            Hindari kerugian akibat AC mati mendadak di jam kerja sibuk. ACNesia menyusun program pemeliharaan terencana dengan laporan kondisi berkala dan prioritas respon darurat untuk klien korporat.
          </p>
        </div>
        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3">
          <a
            href={waConsultUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl bg-red-600 hover:bg-red-400 text-slate-950 font-bold text-xs transition-colors"
          >
            <span>Hubungi Account Manager B2B</span>
          </a>
          <a
            href="/layanan/kontrak-maintenance-ac/"
            class="inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-xs border border-white/20 transition-colors"
          >
            <span>Pelajari Kontrak Maintenance</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
