---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Jual & Pengadaan AC Baru dan Bekas B2B', url: '/pengadaan-ac/' },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const waProcurementUrl = generateGeneralInquiryUrl('pengadaan-b2b-corporate');

const procurementSteps = [
  {
    step: '01',
    title: 'Penerimaan BoQ, Spesifikasi Baru/Bekas & Tukar Tambah',
    description: 'Kirimkan daftar Bill of Quantity (BoQ) pengadaan AC baru, kebutuhan unit AC bekas rekondisi bergaransi, atau daftar aset AC bekas kantor yang ingin dijual/tukar tambah.',
  },
  {
    step: '02',
    title: 'Survei Lapangan & Taksiran Aset (Appraisal)',
    description: 'Tim teknisi melakukan survei fisik ke lokasi proyek Anda di Malang Raya, Surabaya & Sidoarjo untuk validasi jalur pipa maupun penaksiran nilai beli borongan AC lama.',
  },
  {
    step: '03',
    title: 'Penerbitan SPH, RAB & Penawaran Resmi B2B',
    description: 'Kami menerbitkan Surat Penawaran Harga (SPH) resmi, rincian material pipa standar ASTM 0.8mm, potongan harga trade-in, serta opsi termin pembayaran (TOP).',
  },
  {
    step: '04',
    title: 'Penerbitan PO / SPK & Mobilisasi Unit',
    description: 'Setelah PO/SPK diterbitkan, unit AC baru bersegel pabrik maupun unit AC second rekondisi lolos QC dikirimkan langsung menggunakan armada internal Sentra AC.',
  },
  {
    step: '05',
    title: 'Instalasi Sesuai SOP K3 & Vakum Digital 500 Micron',
    description: 'Pemasangan pipa tembaga berisolasi tebal, proses vakum kompresor dengan pompa vakum 2-stage digital (bukan purging), dan uji tekanan.',
  },
  {
    step: '06',
    title: 'Commissioning Test, BAST & e-Faktur Pajak PPN',
    description: 'Uji fungsi meliputi pengukuran ampere, tekanan freon PSI, suhu hembusan evaporator, serta serah terima Berita Acara Serah Terima (BAST) dan Faktur Pajak.',
  },
];

const b2bAdvantages = [
  {
    title: 'Faktur Pajak PPN & Legalitas PKP Lengkap',
    description: 'Legalitas perusahaan PT resmi, siap menerbitkan Faktur Pajak elektronik (e-Faktur), SPK, kuitansi bermaterai, dan Berita Acara Serah Terima (BAST).',
  },
  {
    title: 'Tersedia Unit AC Baru & Second Rekondisi QC',
    description: 'Melayani pengadaan unit AC baru bergaransi resmi pabrikan maupun unit AC bekas rekondisi berkualitas yang telah lulus uji tekan, ampere, dan evaporator.',
  },
  {
    title: 'Terima Borongan Lelang & Tukar Tambah AC Bekas',
    description: 'Solusi likuidasi aset HVAC kantor, hotel, dan pabrik: terima beli borongan AC bekas segala kondisi atau tukar tambah (trade-in) ke unit baru hemat energi.',
  },
  {
    title: 'Termin Pembayaran Fleksibel (TOP Korporat)',
    description: 'Tersedia skema termin pembayaran bertahap (DP, Pengiriman Unit, Selesai Pemasangan) sesuai perjanjian kerja sama institusional B2B.',
  },
];
---

<BaseLayout
  title="Jual & Pengadaan AC Baru dan Bekas Kantor Gedung B2B - Sentra AC"
  description="Supplier jual beli dan pengadaan AC baru bergaransi resmi serta AC bekas rekondisi B2B untuk kantor, gedung, dan instansi lengkap Faktur Pajak."
  canonical={ensureAbsoluteUrl('/pengadaan-ac/')}
  jsonLd={breadcrumbSchema}
  keywords={[
    'jual ac baru dan bekas b2b',
    'pengadaan ac kantor malang surabaya',
    'jual beli ac bekas kantor borongan',
    'tukar tambah ac bekas gedung',
    'pengadaan ac multi unit b2b',
    'supplier ac cassette standing perusahaan',
    'sentra ac pengadaan ac b2b',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-3.5">
        <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-bold text-slate-950 tracking-tight leading-tight">
          Jual Beli &amp; Pengadaan AC Baru dan Bekas Bergaransi untuk Kantor, Gedung &amp; Instansi
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Sentra AC melayani pengadaan unit AC baru bersegel resmi, penjualan unit AC second rekondisi lolos QC, hingga pembelian borongan lelang dan tukar tambah aset AC bekas kantor, pabrik, serta instansi di Jawa Timur lengkap dengan Faktur Pajak PPN.
        </p>
      </div>
    </div>
  </section>

  <!-- Key B2B Value Proposition Grid -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-2xl space-y-1.5">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-950 tracking-tight">
          Keunggulan Administrasi &amp; Teknis Pengadaan B2B
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Kombinasi legalitas lengkap, kepatuhan perpajakan, dan keahlian rekayasa teknisi tetap.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {b2bAdvantages.map((adv) => (
          <div class="p-5 rounded-xl bg-white border border-slate-200 space-y-2">
            <h3 class="font-bold text-slate-950 text-sm sm:text-base leading-snug">{adv.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{adv.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6-Step Procurement Workflow -->
  <section class="py-14 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-2xl space-y-1.5">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-950 tracking-tight">
          Alur Pelaksanaan Pengadaan Unit &amp; Proyek
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Terstruktur dari perencanaan hingga commissioning test akhir untuk memastikan kepatuhan spesifikasi proyek.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {procurementSteps.map((step) => (
          <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
            <span class="block text-xs font-bold text-[#c2410c]">{step.step}</span>
            <h3 class="font-bold text-slate-950 text-sm sm:text-base leading-snug">{step.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-14 lg:py-16 bg-slate-50 text-slate-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-950">
        Pengajuan SPH &amp; Taksiran Pengadaan AC Kantor
      </h2>
      <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Konsultasikan kebutuhan spesifikasi unit, kirimkan daftar BoQ, dan jadwalkan survei awal bersama tim spesialis B2B Sentra AC.
      </p>
      <div class="pt-2">
        <a
          href={waProcurementUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-semibold text-sm border border-slate-300 transition-colors"
        >
          Konsultasi via WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
