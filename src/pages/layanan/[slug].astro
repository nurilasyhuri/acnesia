---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getServiceSchema, getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateServiceInquiryUrl } from '../../utils/whatsapp';

export async function getStaticPaths() {
  const services = await getCollection('layanan');
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service, allServices: services },
  }));
}

interface Props {
  service: any;
  allServices: Array<any>;
}

const { service, allServices } = Astro.props;
const { Content } = await service.render();

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Layanan AC Komersial', url: '/layanan/' },
  { name: service.data.title, url: `/layanan/${service.slug}/` },
];

const serviceJsonLd = getServiceSchema({
  title: service.data.title,
  description: service.data.description,
  serviceType: service.data.serviceType || 'HVAC Service',
  slug: service.slug,
  heroImage: service.data.heroImage,
  scopeOfWork: service.data.scopeOfWork,
});

const breadcrumbJsonLd = getBreadcrumbSchema(breadcrumbs);

const combinedJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [serviceJsonLd, breadcrumbJsonLd],
};

const waUrl = generateServiceInquiryUrl(service.data.title, service.slug);

const otherServices = allServices
  .filter((s) => s.slug !== service.slug)
  .slice(0, 3);
---

<BaseLayout
  title={`${service.data.title} Malang - Sentra AC`}
  description={service.data.description}
  canonical={ensureAbsoluteUrl(`/layanan/${service.slug}/`)}
  image={service.data.heroImage}
  jsonLd={combinedJsonLd}
  keywords={[
    service.data.title.toLowerCase(),
    `jasa ${service.data.title.toLowerCase()}`,
    `biaya ${service.data.title.toLowerCase()}`,
    'service ac kantor malang',
    'teknisi ac bergaransi',
    'sentra ac mitra bisnis indonesia',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-3.5">
          <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-bold text-slate-950 tracking-tight leading-tight">
            {service.data.title}
          </h1>
          <p class="text-sm sm:text-base text-slate-800 font-semibold">
            {service.data.tagline}
          </p>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-2xl">
            {service.data.description}
          </p>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-xl overflow-hidden bg-slate-100 border border-slate-200 aspect-16/10">
            <img
              src={service.data.heroImage}
              alt={`${service.data.title} Bergaransi di Malang Raya`}
              width="700"
              height="438"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Scope & Markdown Content Section -->
  <section id="cakupan-layanan" class="py-12 md:py-16 bg-slate-50 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <div class="lg:col-span-7 space-y-8">
          <div class="prose max-w-none">
            <Content />
          </div>

          {service.data.targetAudience && (
            <div class="pt-6 border-t border-slate-200 space-y-2.5">
              <h3 class="text-sm font-bold text-slate-950">
                Rekomendasi Sektor Pengguna
              </h3>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 list-disc pl-4 text-xs text-slate-700">
                {service.data.targetAudience.map((target: string) => (
                  <li class="leading-relaxed">{target}</li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <div class="lg:col-span-5 space-y-6">
          {service.data.scopeOfWork && (
            <div class="rounded-xl bg-white border border-slate-200 p-6 space-y-3">
              <h3 class="font-bold text-slate-950 text-base">Cakupan Pekerjaan (Scope of Work)</h3>
              <ul class="space-y-2 list-disc pl-4 text-xs text-slate-700">
                {service.data.scopeOfWork.map((scope: string) => (
                  <li class="leading-relaxed">{scope}</li>
                ))}
              </ul>
            </div>
          )}

          {service.data.benefits && (
            <div class="rounded-xl bg-[#020617] text-white p-6 space-y-3">
              <h3 class="font-bold text-white text-base">Standar Kualitas B2B</h3>
              <ul class="space-y-2 list-disc pl-4 text-xs text-slate-300">
                {service.data.benefits.map((b: string) => (
                  <li class="leading-relaxed">{b}</li>
                ))}
              </ul>
            </div>
          )}

          <!-- Single End-of-Task Contact Card -->
          <div class="rounded-xl bg-white border border-slate-200 p-6 space-y-3">
            <h3 class="font-bold text-slate-950 text-sm sm:text-base">Jadwalkan Survei atau Konsultasi</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Jadwal pelaksanaan di luar jam operasional kantor dapat disesuaikan dengan kebutuhan gedung Anda.
            </p>
            <div class="pt-1">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center w-full py-2.5 px-4 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-semibold text-xs border border-slate-300 transition-colors"
              >
                Konsultasi via WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Other Services Rail -->
  {otherServices.length > 0 && (
    <section class="py-12 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <h2 class="text-xl font-bold text-slate-950">Layanan Pendukung Lainnya</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {otherServices.map((s) => (
            <a
              href={`/layanan/${s.slug}/`}
              class="group rounded-xl border border-slate-200 p-5 bg-slate-50 hover:border-slate-300 transition-colors block space-y-2"
            >
              <span class="block text-xs font-semibold text-[#c2410c]">{s.data.serviceType || 'Layanan B2B'}</span>
              <h3 class="font-bold text-slate-950 group-hover:text-[#c2410c] transition-colors text-sm sm:text-base">
                {s.data.title}
              </h3>
              <p class="text-xs text-slate-600 line-clamp-2">{s.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
