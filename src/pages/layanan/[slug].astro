---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getServiceSchema, getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateServiceInquiryUrl } from '../../utils/whatsapp';

export async function getStaticPaths() {
  const services = await getCollection('layanan');
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service, allServices: services },
  }));
}

interface Props {
  service: any;
  allServices: Array<any>;
}

const { service, allServices } = Astro.props;
const { Content } = await service.render();

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Layanan AC Komersial', url: '/layanan/' },
  { name: service.data.title, url: `/layanan/${service.slug}/` },
];

const serviceJsonLd = getServiceSchema({
  title: service.data.title,
  description: service.data.description,
  serviceType: service.data.serviceType || 'HVAC Service',
  slug: service.slug,
  heroImage: service.data.heroImage,
  scopeOfWork: service.data.scopeOfWork,
});

const breadcrumbJsonLd = getBreadcrumbSchema(breadcrumbs);

const combinedJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [serviceJsonLd, breadcrumbJsonLd],
};

const waUrl = generateServiceInquiryUrl(service.data.title, service.slug);

const otherServices = allServices
  .filter((s) => s.slug !== service.slug)
  .slice(0, 3);
---

<BaseLayout
  title={`${service.data.title} — Layanan Resmi | ACNesia Malang`}
  description={service.data.description}
  canonical={ensureAbsoluteUrl(`/layanan/${service.slug}/`)}
  image={service.data.heroImage}
  jsonLd={combinedJsonLd}
  keywords={[
    service.data.title.toLowerCase(),
    `jasa ${service.data.title.toLowerCase()}`,
    `biaya ${service.data.title.toLowerCase()}`,
    'service ac kantor malang',
    'teknisi ac bergaransi',
    'acnesia mitra bisnis indonesia',
  ]}
>
  <!-- Breadcrumb -->
  <div class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-white via-slate-50 to-slate-50 border-b border-slate-200 py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-800 border border-red-200">
            <span class="w-2 h-2 rounded-full bg-red-700"></span>
            <span>{service.data.serviceType || 'Layanan Resmi ACNesia'}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-950 tracking-tight leading-tight">
            {service.data.title}
          </h1>
          <p class="text-base sm:text-lg text-slate-700 font-medium">
            {service.data.tagline}
          </p>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-2xl">
            {service.data.description}
          </p>

          <!-- WhatsApp Action CTA -->
          <div class="pt-4 flex flex-wrap items-center gap-3">
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md transition-colors"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
              </svg>
              <span>Konsultasikan / Buat Jadwal Layanan Ini</span>
            </a>
            <a
              href="/kontak/"
              class="inline-flex items-center gap-2 px-5 py-3.5 rounded-full bg-white hover:bg-slate-100 text-slate-700 font-semibold text-sm border border-slate-300 transition-colors"
            >
              <span>Minta Penawaran Formal</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden bg-white border border-slate-200 shadow-lg aspect-16/10">
            <img
              src={service.data.heroImage}
              alt={service.data.title}
              width="700"
              height="438"
              class="w-full h-full object-cover"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Scope & Markdown Content Section -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left: Longform Text & SOP -->
        <div class="lg:col-span-7 space-y-8">
          <div class="prose prose-slate prose-headings:font-bold prose-headings:text-slate-900 prose-p:text-slate-600 prose-p:leading-relaxed prose-li:text-slate-600 max-w-none text-sm">
            <Content />
          </div>

          <!-- Target Audience Section -->
          {service.data.targetAudience && (
            <div class="rounded-2xl bg-white border border-slate-200 p-6 space-y-3">
              <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider text-red-800">
                Layanan Ini Direkomendasikan Untuk:
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
                {service.data.targetAudience.map((target: string) => (
                  <div class="flex items-center gap-2 text-xs text-slate-700 p-2 rounded-lg bg-slate-50 border border-slate-100">
                    <svg class="w-4 h-4 text-red-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                    <span>{target}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Right: Scope of Work & Benefits Cards -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Scope of Work Checklist -->
          {service.data.scopeOfWork && (
            <div class="rounded-3xl bg-white border border-slate-200 p-6 shadow-sm space-y-4">
              <div class="border-b border-slate-100 pb-3">
                <h3 class="font-bold text-slate-900 text-base">Cakupan Pekerjaan (Scope of Work)</h3>
                <p class="text-xs text-slate-500 mt-0.5">Daftar item teknis yang dilaksanakan oleh tim teknisi</p>
              </div>
              <ul class="space-y-3">
                {service.data.scopeOfWork.map((scope: string) => (
                  <li class="flex items-start gap-3 text-xs text-slate-700">
                    <div class="w-5 h-5 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 mt-0.5">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    <span class="leading-relaxed font-medium">{scope}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Key Benefits -->
          {service.data.benefits && (
            <div class="rounded-3xl bg-slate-900 text-white p-6 shadow-md space-y-4">
              <div class="border-b border-slate-800 pb-3">
                <h3 class="font-bold text-white text-base">Nilai Lebih untuk Perusahaan</h3>
                <p class="text-xs text-slate-400 mt-0.5">Mengapa mempercayakan penanganan ini kepada ACNesia</p>
              </div>
              <ul class="space-y-3">
                {service.data.benefits.map((b: string) => (
                  <li class="flex items-start gap-3 text-xs text-slate-300">
                    <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="leading-relaxed">{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Direct Inquire Card -->
          <div class="rounded-3xl bg-gradient-to-br from-red-50 to-white border border-red-200 p-6 space-y-3 text-center">
            <h4 class="font-bold text-slate-900 text-sm">Butuh Penyesuaian Lingkup Kerja?</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Jadwal pelaksanaan di luar jam operasional kantor (malam hari atau akhir pekan) dapat diatur sesuai kebutuhan perusahaan Anda.
            </p>
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-red-700 hover:bg-red-800 text-white font-semibold text-xs transition-colors"
            >
              <span>Diskusikan Jadwal Khusus</span>
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Other Services Rail -->
  {otherServices.length > 0 && (
    <section class="py-12 bg-white border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-xl font-bold text-slate-900">Layanan Pendukung Lainnya</h2>
            <p class="text-xs text-slate-500 mt-1">Layanan rekayasa pendingin udara komersial ACNesia</p>
          </div>
          <a href="/layanan/" class="text-xs font-semibold text-red-700 hover:underline">
            Semua Layanan &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {otherServices.map((s) => (
            <div class="rounded-2xl border border-slate-200 p-5 bg-slate-50 hover:bg-white hover:shadow-md transition-all flex flex-col justify-between">
              <div class="space-y-2">
                <span class="text-[10px] font-bold text-red-800 uppercase tracking-wider">{s.data.serviceType || 'HVAC'}</span>
                <h3 class="font-bold text-slate-900 text-sm">
                  <a href={`/layanan/${s.slug}/`} class="hover:text-red-800">
                    {s.data.title}
                  </a>
                </h3>
                <p class="text-xs text-slate-500 line-clamp-2">{s.data.description}</p>
              </div>
              <div class="pt-4 border-t border-slate-200/60 mt-4">
                <a href={`/layanan/${s.slug}/`} class="text-xs font-semibold text-red-700 hover:underline inline-flex items-center gap-1">
                  <span>Lihat Scope</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
