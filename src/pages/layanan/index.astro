---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const services = await getCollection('layanan');
const sortedServices = services.sort((a, b) => a.data.orderPriority - b.data.orderPriority);

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Layanan AC Komersial', url: '/layanan/' },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const waConsultUrl = generateGeneralInquiryUrl('layanan-hub-cta');
---

<BaseLayout
  title="Jasa Service, Pasang, Cuci, Sewa & Jual Beli AC Malang - Sentra AC"
  description="Layanan lengkap jual beli AC baru dan bekas, sewa AC standing, jasa service AC panggilan, pasang pipa vakum, cuci steam, dan kontrak B2B di Malang Raya."
  canonical={ensureAbsoluteUrl('/layanan/')}
  jsonLd={breadcrumbSchema}
  keywords={[
    'layanan ac malang',
    'service ac kantor malang',
    'jual beli ac bekas malang',
    'tukar tambah ac bekas kantor',
    'kontrak maintenance ac perusahaan',
    'instalasi ac cassette gedung',
    'sewa ac standing malang',
    'preventive maintenance hvac',
    'teknisi ac b2b malang',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-3.5">
        <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-bold text-slate-950 tracking-tight leading-tight">
          Jasa Service, Pasang, Cuci, Sewa &amp; Jual Beli AC Baru dan Bekas
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Melayani jual beli AC baru dan bekas (satuan maupun borongan lelang kantor), sewa AC standing harian/bulanan, jasa pasang AC berstandar vakum digital, cuci AC steam, perbaikan AC bocor/tidak dingin, hingga kontrak maintenance tahunan ber-SLA dengan Faktur Pajak resmi.
        </p>
      </div>
    </div>
  </section>

  <!-- Service Cards Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-950 tracking-tight">
          Daftar Layanan Jual Beli, Sewa, Service &amp; Pasang AC
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Pilih layanan teknis yang sesuai dengan kebutuhan operasional gedung dan kantor Anda
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedServices.map((service) => (
          <a
            href={`/layanan/${service.slug}/`}
            class="group rounded-xl bg-white border border-slate-200 hover:border-slate-300 transition-colors overflow-hidden block"
          >
            <div class="aspect-16/9 bg-slate-100 overflow-hidden">
              <img
                src={service.data.heroImage}
                alt={`${service.data.title} di Malang Raya - Sentra AC`}
                width="600"
                height="338"
                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
                loading="lazy"
              />
            </div>

            <div class="p-5 space-y-2">
              <span class="block text-xs font-semibold text-[#c2410c]">
                {service.data.serviceType || 'Layanan B2B'}
              </span>
              <h3 class="text-base sm:text-lg font-bold text-slate-950 group-hover:text-[#c2410c] transition-colors leading-snug">
                {service.data.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">
                {service.data.description}
              </p>

              {service.data.scopeOfWork && (
                <ul class="pt-3 border-t border-slate-100 space-y-1 list-disc pl-4 text-xs text-slate-600">
                  {service.data.scopeOfWork.slice(0, 3).map((item: string) => (
                    <li class="line-clamp-1">{item}</li>
                  ))}
                </ul>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SOP & Process Flow Section -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-2xl space-y-1.5">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-950 tracking-tight">
          Alur Kerja Transparan &amp; Akuntabel
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Setiap pekerjaan teknis Sentra AC dijalankan dengan dokumentasi terstruktur untuk menjamin kelancaran operasional fasilitas Anda.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
          <span class="block text-xs font-bold text-[#c2410c]">01</span>
          <h3 class="font-bold text-slate-950 text-sm sm:text-base">Asesmen Kebutuhan</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Sampaikan keluhan teknis, jumlah unit, atau kebutuhan pengadaan melalui form SPH untuk asesmen awal.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
          <span class="block text-xs font-bold text-[#c2410c]">02</span>
          <h3 class="font-bold text-slate-950 text-sm sm:text-base">Survey Lokasi &amp; RAB</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Teknisi melakukan inspeksi lapangan, pengukuran jalur pipa, dan penyusunan RAB/SPH resmi.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
          <span class="block text-xs font-bold text-[#c2410c]">03</span>
          <h3 class="font-bold text-slate-950 text-sm sm:text-base">Eksekusi Standar K3</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Pengerjaan dilakukan menggunakan vakum digital 500 micron, pelindung area kerja, dan pengawasan teknisi senior.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
          <span class="block text-xs font-bold text-[#c2410c]">04</span>
          <h3 class="font-bold text-slate-950 text-sm sm:text-base">BAST, Pajak &amp; Garansi</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Serah terima hasil kerja melalui BAST, penerbitan e-Faktur Pajak PPN, dan garansi pekerjaan tertulis.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-14 lg:py-16 bg-slate-50 text-slate-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-950">
        Penjadwalan Layanan &amp; Kontrak Maintenance AC
      </h2>
      <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Diskusikan kontrak perawatan berkala, pengadaan unit baru, atau jadwal servis bersama tim B2B Sentra AC.
      </p>
      <div class="pt-2">
        <a
          href={waConsultUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-white hover:bg-slate-100 text-slate-800 font-semibold text-sm border border-slate-300 transition-colors"
        >
          Konsultasi via WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
