---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getBreadcrumbSchema, ensureAbsoluteUrl } from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const services = await getCollection('layanan');
const sortedServices = services
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.orderPriority - b.data.orderPriority);

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Layanan AC Komersial', url: '/layanan/' },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const waConsultUrl = generateGeneralInquiryUrl('layanan-hub-hero');
---

<BaseLayout
  title="Layanan AC Komersial, Kantor & Industri — Service, Pasang, Jual Beli | ACNesia"
  description="Layanan tata udara komersial terintegrasi di Malang Raya: Jual unit baru, jual beli & tukar tambah AC bekas, instalasi bergaransi, service, preventive maintenance, kontrak B2B, dan sewa AC."
  canonical={ensureAbsoluteUrl('/layanan/')}
  jsonLd={breadcrumbSchema}
  keywords={[
    'layanan ac malang',
    'service ac kantor malang',
    'jual beli ac bekas malang',
    'tukar tambah ac bekas kantor',
    'kontrak maintenance ac perusahaan',
    'instalasi ac cassette gedung',
    'sewa ac standing malang',
    'preventive maintenance hvac',
    'teknisi ac b2b malang',
  ]}
>
  <!-- Breadcrumb -->
  <div class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-white via-slate-50 to-slate-50 border-b border-slate-200 py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-800 border border-red-200">
          <span class="w-2 h-2 rounded-full bg-red-700"></span>
          <span>Layanan Rekayasa & Pemeliharaan Tata Udara</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-950 tracking-tight leading-tight">
          Solusi Menyeluruh untuk Sistem Pendingin Udara Fasilitas Anda
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          Dari pengadaan unit baru, jual beli & tukar tambah AC bekas, instalasi pipa rapi, perawatan berkala terprogram, hingga kontrak jangka panjang dengan SLA terukur. ACNesia siap menjadi mitra teknis andalan General Affair dan manajer fasilitas perusahaan Anda.
        </p>

        <!-- Metrics Strip -->
        <div class="pt-2 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
          <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-2xs">
            <span class="block text-red-700 font-bold text-sm">{sortedServices.length} Layanan Utama</span>
            <span class="text-slate-500">End-to-End HVAC Solution</span>
          </div>
          <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-2xs">
            <span class="block text-red-700 font-bold text-sm">Respon Cepat</span>
            <span class="text-slate-500">SLA Tanggap Darurat B2B</span>
          </div>
          <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-2xs">
            <span class="block text-red-700 font-bold text-sm">Legalitas Resmi</span>
            <span class="text-slate-500">Faktur Pajak & BAP</span>
          </div>
          <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-2xs">
            <span class="block text-red-700 font-bold text-sm">Teknisi Tetap</span>
            <span class="text-slate-500">Bukan Freelance Lepas</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Cards Section -->
  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="border-b border-slate-200 pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-slate-950 tracking-tight">Katalog Layanan Lengkap ACNesia</h2>
          <p class="text-sm text-slate-500 mt-1">Pilih layanan yang sesuai dengan kebutuhan operasional gedung dan kantor Anda</p>
        </div>
        <a
          href={waConsultUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-semibold text-red-700 hover:text-red-800"
        >
          <span>Konsultasi Kebutuhan Spesifik via WA</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedServices.map((service, index) => (
          <div class="group relative flex flex-col justify-between rounded-3xl bg-white border border-slate-200 hover:border-slate-300 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
            <div>
              <!-- Service Image -->
              <a href={`/layanan/${service.slug}/`} class="block aspect-16/9 bg-slate-100 overflow-hidden relative">
                <img
                  src={service.data.heroImage}
                  alt={service.data.title}
                  width="600"
                  height="338"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  loading="lazy"
                />
                <div class="absolute top-3 left-3">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold bg-slate-950/80 text-white backdrop-blur-xs">
                    0{index + 1} • {service.data.serviceType || 'HVAC Service'}
                  </span>
                </div>
              </a>

              <!-- Content Body -->
              <div class="p-6 space-y-3">
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-red-800 transition-colors leading-snug">
                  <a href={`/layanan/${service.slug}/`}>
                    {service.data.title}
                  </a>
                </h3>
                <p class="text-xs font-medium text-red-800 leading-snug">
                  {service.data.tagline}
                </p>
                <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">
                  {service.data.description}
                </p>

                <!-- Key Scope List -->
                {service.data.scopeOfWork && (
                  <div class="pt-2 border-t border-slate-100 space-y-1.5">
                    <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Cakupan Utama:</span>
                    <ul class="space-y-1">
                      {service.data.scopeOfWork.slice(0, 3).map((item: string) => (
                        <li class="flex items-start gap-2 text-xs text-slate-600">
                          <svg class="w-3.5 h-3.5 text-red-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                          </svg>
                          <span class="line-clamp-1">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>

            <!-- Footer Card Action -->
            <div class="p-6 pt-3 border-t border-slate-100">
              <a
                href={`/layanan/${service.slug}/`}
                class="w-full inline-flex items-center justify-between py-2.5 px-4 rounded-xl bg-slate-100 group-hover:bg-slate-900 text-slate-800 group-hover:text-white text-xs font-semibold transition-all duration-200"
              >
                <span>Pelajari Detail Layanan</span>
                <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SOP & Process Flow Section -->
  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700">
          Standar Operasional Prosedur (SOP)
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-950 tracking-tight">
          Alur Kerja Transparan & Akuntabel
        </h2>
        <p class="text-sm text-slate-600">
          Setiap pekerjaan teknis ACNesia dijalankan dengan dokumentasi terstruktur untuk menjamin kenyamanan kerja Anda.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-red-700 text-white flex items-center justify-center font-bold text-sm shadow-xs">
            1
          </div>
          <h3 class="font-bold text-slate-900 text-base">Konsultasi & Kebutuhan</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Sampaikan permasalahan teknis atau kebutuhan unit melalui customer care kami untuk asesmen awal.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-red-700 text-white flex items-center justify-center font-bold text-sm shadow-xs">
            2
          </div>
          <h3 class="font-bold text-slate-900 text-base">Survey Lokasi & RAB</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Teknisi melakukan inspeksi lapangan, pengukuran jalur pipa, dan penyusunan RAB resmi tanpa biaya tersembunyi.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-red-700 text-white flex items-center justify-center font-bold text-sm shadow-xs">
            3
          </div>
          <h3 class="font-bold text-slate-900 text-base">Eksekusi Bersih & Rapi</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Pengerjaan dilakukan dengan peralatan standar industri, penutup pelindung debu, dan SOP K3 terjaga.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-red-700 text-white flex items-center justify-center font-bold text-sm shadow-xs">
            4
          </div>
          <h3 class="font-bold text-slate-900 text-base">Berita Acara & Garansi</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Serah terima hasil kerja melalui Berita Acara Pekerjaan (BAP), penerbitan faktur pajak resmi, dan kartu garansi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-slate-900 text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 relative z-10">
      <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight">
        Siap Tingkatkan Kinerja Sistem AC Perusahaan Anda?
      </h2>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Diskusikan kontrak perawatan berkala, pengadaan unit baru, atau kebutuhan servis darurat bersama konsultan tata udara ACNesia.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          href={waConsultUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-lg transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
          </svg>
          <span>Chat Konsultasi Layanan via WhatsApp</span>
        </a>
        <a
          href="/kontak/"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-slate-800 hover:bg-slate-700 text-white font-semibold text-sm border border-slate-700 transition-colors"
        >
          <span>Formulir Permintaan Penawaran Resmi</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
