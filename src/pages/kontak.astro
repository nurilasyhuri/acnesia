---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { BUSINESS_INFO } from '../data/businessInfo';
import { getBreadcrumbSchema, getLocalBusinessSchema, ensureAbsoluteUrl } from '../utils/seo';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Kontak & Lokasi', url: '/kontak/' },
];

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbs);
const localBusinessSchema = getLocalBusinessSchema();

const combinedJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [breadcrumbSchema, localBusinessSchema],
};
---

<BaseLayout
  title="Kontak & Nomor WA Service, Sewa & Jual Beli AC Malang - Sentra AC"
  description="Hubungi WhatsApp 0851-8300-2070 Sentra AC untuk jual beli AC baru/bekas, sewa AC standing, jasa service AC panggilan, pasang AC, & survey gratis di Malang."
  canonical={ensureAbsoluteUrl('/kontak/')}
  jsonLd={combinedJsonLd}
  keywords={[
    'kontak sentra ac',
    'nomor wa teknisi ac malang',
    'customer service sentra ac',
    'alamat sentra ac kedungkandang',
    'kantor sentra ac buring malang',
    'rfq ac kantor malang',
  ]}
>
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- Hero Header -->
  <section class="bg-white py-10 md:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-3">
        <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-bold text-slate-950 tracking-tight leading-tight">
          Hubungi Tim Engineering &amp; Pengadaan B2B Sentra AC
        </h1>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Tim engineering dan customer care kami siap membantu perhitungan kapasitas PK ruangan, pengajuan proposal SPH resmi, jadwal survei on-site, atau penanganan darurat di wilayah Malang Raya, Surabaya, dan Sidoarjo.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Matrix & Interactive RFQ Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <div class="lg:col-span-5 space-y-6">
          <div class="rounded-xl bg-white border border-slate-200 p-6 sm:p-8 space-y-5">
            <h2 class="text-lg sm:text-xl font-bold text-slate-950">
              Informasi Kontak Resmi
            </h2>

            <div class="space-y-4 text-xs">
              <div class="space-y-0.5">
                <span class="font-semibold text-slate-500">Telepon &amp; WhatsApp B2B</span>
                <p class="font-bold text-slate-950 text-sm sm:text-base">
                  0851-8300-2070
                </p>
                <p class="text-slate-600">Layanan penawaran resmi, penjadwalan teknisi, dan konsultasi proyek</p>
              </div>

              <div class="space-y-0.5 pt-3 border-t border-slate-100">
                <span class="font-semibold text-slate-500">Email Korespondensi &amp; BoQ</span>
                <div>
                  <a
                    href={`mailto:${BUSINESS_INFO.email}`}
                    class="font-bold text-slate-950 hover:text-[#c2410c] transition-colors text-sm sm:text-base"
                  >
                    {BUSINESS_INFO.email}
                  </a>
                </div>
                <p class="text-slate-600">Kirimkan lampiran berkas BoQ, denah PDF, atau dokumen RKS</p>
              </div>

              <div class="space-y-0.5 pt-3 border-t border-slate-100">
                <span class="font-semibold text-slate-500">Jam Operasional Kantor</span>
                <div class="font-bold text-slate-950 text-sm">{BUSINESS_INFO.hours.days}</div>
                <p class="text-slate-600">{BUSINESS_INFO.hours.time} (Pelaksanaan servis kontrak di luar jam kerja dapat diatur)</p>
              </div>

              <div class="space-y-1 pt-3 border-t border-slate-100">
                <span class="font-semibold text-slate-500">Workshop &amp; Kantor Operasional</span>
                <p class="font-medium text-slate-800 leading-relaxed">
                  {BUSINESS_INFO.address.formatted}
                </p>
              </div>
            </div>
          </div>

          <div class="rounded-xl bg-[#020617] text-white p-6 space-y-2">
            <h3 class="font-bold text-sm text-white">Layanan Survei On-Site</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Untuk kebutuhan pengadaan kantor multi-unit atau kontrak pemeliharaan gedung, tim engineer kami melakukan kunjungan survei fisik di wilayah Malang Raya, Surabaya, dan Sidoarjo.
            </p>
          </div>
        </div>

        <!-- Right: Interactive RFQ Form Builder -->
        <div class="lg:col-span-7">
          <div class="rounded-xl bg-white border border-slate-200 p-6 sm:p-8 space-y-6">
            <div class="space-y-1">
              <h2 class="text-xl sm:text-2xl font-bold text-slate-950 tracking-tight">Kirim Detail Kebutuhan AC</h2>
              <p class="text-xs text-slate-600">
                Isi rincian di bawah ini untuk meneruskan draf permintaan penawaran terstruktur kepada tim B2B Sentra AC.
              </p>
            </div>

            <form id="rfqForm" class="space-y-4">
              <div class="space-y-1.5">
                <label for="rfqCategory" class="block text-xs font-semibold text-slate-800">
                  Kategori Layanan yang Dibutuhkan *
                </label>
                <select
                  id="rfqCategory"
                  required
                  class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-base sm:text-xs text-slate-900 focus:border-[#c2410c]"
                >
                  <option value="Pengadaan Unit AC Baru">Pengadaan Unit AC Baru (Split, Cassette, Standing)</option>
                  <option value="Kontrak Maintenance AC Perusahaan">Kontrak Perawatan Berkala B2B (Maintenance Contract)</option>
                  <option value="Instalasi & Pasang AC Baru">Jasa Instalasi &amp; Pemipaan AC Rapi</option>
                  <option value="Service & Perbaikan Darurat">Service / Perbaikan Kerusakan &amp; Tambah Freon</option>
                  <option value="Sewa AC Standing Event">Sewa AC Standing &amp; Genset Silent untuk Event/Proyek</option>
                  <option value="Jual Beli / Tukar Tambah AC Bekas">Jual Beli / Borongan &amp; Tukar Tambah AC Bekas</option>
                  <option value="Survey & Hitung Beban PK">Permintaan Survei Lokasi &amp; Audit Beban PK</option>
                </select>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="rfqName" class="block text-xs font-semibold text-slate-800">
                    Nama Kontak / PIC *
                  </label>
                  <input
                    type="text"
                    id="rfqName"
                    required
                    placeholder="Contoh: Bpk. Hendra"
                    class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-base sm:text-xs text-slate-900 focus:border-[#c2410c]"
                  />
                </div>
                <div class="space-y-1.5">
                  <label for="rfqCompany" class="block text-xs font-semibold text-slate-800">
                    Nama Perusahaan / Instansi
                  </label>
                  <input
                    type="text"
                    id="rfqCompany"
                    placeholder="Contoh: PT Sumber Makmur Sentosa"
                    class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-base sm:text-xs text-slate-900 focus:border-[#c2410c]"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="rfqLocation" class="block text-xs font-semibold text-slate-800">
                    Lokasi Gedung / Kota *
                  </label>
                  <input
                    type="text"
                    id="rfqLocation"
                    required
                    placeholder="Contoh: Jl. Soekarno Hatta, Kota Malang"
                    class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-base sm:text-xs text-slate-900 focus:border-[#c2410c]"
                  />
                </div>
                <div class="space-y-1.5">
                  <label for="rfqQty" class="block text-xs font-semibold text-slate-800">
                    Perkiraan Jumlah Unit (Opsional)
                  </label>
                  <input
                    type="text"
                    id="rfqQty"
                    placeholder="Contoh: 8 unit Cassette 3 PK"
                    class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-base sm:text-xs text-slate-900 focus:border-[#c2410c]"
                  />
                </div>
              </div>

              <div class="space-y-1.5">
                <label for="rfqMessage" class="block text-xs font-semibold text-slate-800">
                  Rincian Kebutuhan / Catatan Khusus
                </label>
                <textarea
                  id="rfqMessage"
                  rows="3"
                  placeholder="Ceritakan kebutuhan AC saat ini, jadwal survei yang diinginkan, atau spesifikasi khusus..."
                  class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-base sm:text-xs text-slate-900 focus:border-[#c2410c]"
                ></textarea>
              </div>

              <div class="pt-2">
                <button
                  type="submit"
                  class="w-full inline-flex items-center justify-center py-3 px-6 rounded-lg bg-[#c2410c] hover:bg-[#9a3412] text-white font-semibold text-sm transition-colors cursor-pointer"
                >
                  Kirim Permintaan SPH via WhatsApp
                </button>
              </div>
            </form>

            <script is:inline>
              document.addEventListener('DOMContentLoaded', () => {
                const form = document.getElementById('rfqForm');
                if (!form) return;

                form.addEventListener('submit', (e) => {
                  e.preventDefault();
                  const category = document.getElementById('rfqCategory').value;
                  const name = document.getElementById('rfqName').value.trim();
                  const company = document.getElementById('rfqCompany').value.trim();
                  const location = document.getElementById('rfqLocation').value.trim();
                  const qty = document.getElementById('rfqQty').value.trim();
                  const message = document.getElementById('rfqMessage').value.trim();

                  let waText = `Halo Tim B2B Sentra AC,\n\nSaya ingin mengajukan permintaan penawaran (SPH):\n- Kategori Layanan: ${category}\n- Nama PIC: ${name}`;
                  if (company) waText += `\n- Perusahaan / Instansi: ${company}`;
                  if (location) waText += `\n- Lokasi / Alamat: ${location}`;
                  if (qty) waText += `\n- Estimasi Unit: ${qty}`;
                  if (message) waText += `\n- Rincian Kebutuhan: ${message}`;
                  waText += `\n\nMohon informasi ketersediaan jadwal dan estimasi penawaran resmi. Terima kasih.`;

                  const waUrl = `https://wa.me/6285183002070?text=${encodeURIComponent(waText)}`;
                  window.open(waUrl, '_blank');
                });
              });
            </script>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
