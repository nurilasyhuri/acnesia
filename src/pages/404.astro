---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404: Halaman Tidak Ditemukan pada Katalog Layanan B2B - Sentra AC"
  description="Halaman yang Anda tuju tidak tersedia atau telah dipindahkan. Silakan kembali ke beranda resmi layanan HVAC B2B Sentra AC."
  noindex={true}
>
  <div class="min-h-[65vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-lg w-full text-center space-y-5">
      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-950 tracking-tight">
          Halaman Tidak Ditemukan
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-md mx-auto">
          Tautan yang Anda tuju mungkin salah ketik atau telah diperbarui. Silakan kembali ke halaman utama Sentra AC.
        </p>
      </div>

      <div class="pt-2">
        <a
          href="/"
          class="inline-flex items-center px-6 py-2.5 rounded-lg bg-[#c2410c] hover:bg-[#9a3412] text-white font-semibold text-xs sm:text-sm transition-colors"
        >
          Kembali ke Beranda
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
