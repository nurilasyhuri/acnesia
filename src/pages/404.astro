---
import BaseLayout from '../layouts/BaseLayout.astro';
import { generateGeneralInquiryUrl } from '../utils/whatsapp';

const waUrl = generateGeneralInquiryUrl('404-page');
---

<BaseLayout
  title="404: Halaman Tidak Ditemukan | ACNesia"
  description="Halaman yang Anda tuju tidak tersedia atau telah dipindahkan. Jelajahi katalog produk AC atau hubungi tim customer care ACNesia."
  noindex={true}
>
  <div class="min-h-[70vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-lg w-full text-center space-y-6">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-red-50 text-red-700 border border-red-200">
        <span class="text-3xl font-black">404</span>
      </div>

      <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-950 tracking-tight">
          Halaman Tidak Ditemukan
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-md mx-auto">
          Tautan yang Anda tuju mungkin salah ketik atau telah diperbarui. Silakan kembali ke beranda atau telusuri menu layanan kami di bawah ini.
        </p>
      </div>

      <!-- Quick Navigation Buttons -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs shadow-xs transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          <span>Kembali ke Beranda</span>
        </a>
        <a
          href="/produk/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-800 font-semibold text-xs border border-slate-300 transition-colors"
        >
          <span>Katalog Produk AC</span>
        </a>
        <a
          href="/layanan/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-800 font-semibold text-xs border border-slate-300 transition-colors"
        >
          <span>Layanan AC</span>
        </a>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-semibold text-xs border border-emerald-200 transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
          </svg>
          <span>Bantuan WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
